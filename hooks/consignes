#!/usr/bin/env bash
# Hook des consignes communes : injecte <vault>/_global/consignes.md de chaque
# vault declare, en additionalContext DISTINCT de celui de session-start (le
# harnais plafonne CHAQUE chaine a 10 000 caracteres, et compte chaque hook a
# part).
#
# Usage : consignes [SessionStart|SubagentStart]    (defaut : SessionStart)
# L'evenement servi arrive en argument, depuis hooks/hooks.json, jamais par
# stdin : hookSpecificOutput doit porter le nom de l'evenement servi.
#
# Ne lit que des fichiers. Il tourne a chaque evenement de session, reprise
# comprise, et peut tourner avant chaque agent helia:* : ni balayage des
# racines, ni resolution des fiches, ni commande de versionnement, ni
# migration de configuration -- tout cela reste a session-start.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
. "${PLUGIN_ROOT}/lib/vaults"

case "${1:-SessionStart}" in
    SubagentStart) event=SubagentStart ;;
    *)             event=SessionStart ;;
esac

text="$(consignes_text)"
if [ -z "$text" ]; then
    printf '{}\n'
    exit 0
fi
body=$(escape_for_json "$text")

# printf rather than a heredoc: bash 5.3+ hangs on heredocs in hooks.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$event" "$body"
exit 0
