#!/usr/bin/env bash
# SessionStart hook for the aiKit plugin.
#
# Injects two things into every session (startup, /clear, and after compaction):
#   1. the full text of the using-aikit skill  -> the method itself
#   2. a compact table of the registered projects -> the router
#
# The compaction matcher is the point: the method survives context loss.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

preamble=$(cat "${PLUGIN_ROOT}/skills/using-aikit/SKILL.md" 2>&1 || echo "Error reading using-aikit skill")

# --- vault registries -------------------------------------------------------
# Plus de remontee d'ancetres : les vaults sont declares, par machine, dans
# ~/.config/aikit/vaults (voir lib/vaults). Un projet que le scan ne trouve pas
# reste au registre et sort ABSENT -- dire "pas ici" est une information,
# pretendre qu'il est la est un mensonge.
#
# Le registre est de la DONNEE, jamais du code de plugin. Installer un plugin le
# COPIE dans ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/ fige sur
# un commit : une copie embarquee serait perimee des la premiere edition d'une
# fiche. Lire les vaults declares fait qu'une edition prend effet a la session
# suivante, sans reinstallation. Le plugin n'embarque AUCUN registre, et il n'y
# a aucun repli sur un tel registre : la methode est generique et voyage
# partout, un registre est la donnee d'une machine.
. "${PLUGIN_ROOT}/lib/vaults"

registry=""
vault_count=0
resolved=0
stranded=""
while IFS=$'\t' read -r vname vpath; do
    [ -n "$vname" ] || continue
    vault_count=$((vault_count + 1))
    rows=""
    while IFS=$'\t' read -r n kind state path summary; do
        [ -n "$n" ] || continue
        here="oui"; [ "$state" = "present" ] || here="**absent d'ici**"
        [ "$kind" = "conception" ] && n="${n} *(conception)*"
        rows+="| ${n} | ${here} | ${summary} |"$'\n'
    done < <(resolve_projects "$vname")
    if [ -z "$rows" ]; then
        # Un vault declare qui ne rend rien doit etre NOMME, avec ce qui manque
        # et l'endroit regarde. Se taire ici rendrait un registre vide sans
        # note : la methode se charge, le routeur est absent, et rien ne dit
        # pourquoi -- c'est le cas le plus probable a la premiere installation,
        # une ligne `vault` ecrite avant que le vault existe.
        # Les pannes ne partagent pas leur remede, donc pas leur phrase : un
        # repertoire absent se cree, un vide s'alimente, un `projects` qui est
        # un FICHIER se deplace. Annoncer « does not exist » d'une entree bien
        # presente serait le petit mensonge d'a cote.
        if   [ -d "${vpath}/projects" ]; then why="holds no \`*.md\` project file"
        elif [ -e "${vpath}/projects" ] || [ -L "${vpath}/projects" ]; then
                                              why="is not a directory"
        else                                  why="does not exist"; fi
        stranded+="- \`${vname}\` — \`${vpath}/projects\` ${why}"$'\n'
        continue
    fi
    resolved=$((resolved + 1))
    registry+=$'\n\n## Vault: '"${vname}"$'\n\n'
    registry+=$'| project | ici | what it is |\n|---|---|---|\n'
    registry+="${rows}"
    registry+=$'\nVault path: `'"${vpath}"$'`\n'
done < <(vaults_list)

if [ "$vault_count" = 0 ]; then
    registry=$'\n\n## No vault registered on this machine\n\nDeclare one in `~/.config/aikit/vaults`:\n\n```\nvault work /path/to/the/vault\nroot  work /path/to/where/its/projects/are\n```\n\nThe method still applies in full; the routing step has nothing to route to. Establish the project\'s base branch, conventions and completion criterion from its own documentation before phase 3, and say plainly that you are doing so.'
elif [ "$resolved" = 0 ]; then
    # Declare mais introuvable n'est PAS la meme chose qu'aucun vault declare :
    # l'un est une erreur de chemin a corriger, l'autre une machine encore
    # vierge. Les deux notes portent des titres differents, expres.
    registry=$'\n\n## No project registry found\n\nThese vaults are declared in `~/.config/aikit/vaults`, but none of them carries a project registry:\n\n'"${stranded}"
    registry+=$'\nFix the path, or create the missing `projects/` directory in the vault.\n'
    registry+=$'\nThe method still applies in full; the routing step has nothing to route to. Establish the project\'s base branch, conventions and completion criterion from its own documentation before phase 3, and say plainly that you are doing so.'
else
    registry+=$'\nBefore working on a project, read `<vault>/projects/<name>.md`: it holds the base branch, the domain agents, the completion criterion, and the convention files to load. A project marked **absent d\'ici** is registered but not cloned on this machine. **Never work on a project whose registry file you have not read.**'
    # Apres la regle, pas avant : un titre `##` place juste au-dessus avalerait
    # la consigne de lecture, qui porte sur les tables et non sur ces vaults-la.
    # Meme remede que l'etat 2 : cette section FERME le contexte injecte, et
    # apprendre qu'un vault est casse sans apprendre quoi en faire est une
    # moitie d'information.
    [ -z "$stranded" ] || registry+=$'\n\n## Declared, but carrying no project registry\n\n'"${stranded}"$'\nThese route nowhere until fixed: correct the path in `~/.config/aikit/vaults`, or create the vault\'s missing `projects/` directory.'
fi
# ---------------------------------------------------------------------------

escape_for_json() {
    local s="$1"
    # Les caracteres de controle NUS d'abord, avant tout echappement : un
    # `summary:` de fiche est ecrit a la main, et un seul octet de ce genre
    # rend la chaine JSON invalide -- donc porte 4 rouge et preambule perdu a
    # CHAQUE demarrage de session. Tabulation (011), LF (012) et CR (015) sont
    # exclus du filtre expres : ils sont echappes correctement juste en dessous,
    # et les supprimer casserait la mise en forme du preambule injecte.
    #
    # La sentinelle `x` n'est pas decorative : `$( )` depouille les sauts de
    # ligne TERMINAUX, et ce sous-shell est le seul de la fonction qui voie
    # encore de vrais `\n` -- apres les substitutions ci-dessous il n'en reste
    # aucun, tous devenus deux caracteres, donc le `$( )` de l'appelant ne peut
    # plus rien manger. Sans elle, un preambule finissant par une ligne vide la
    # perdrait en silence.
    s=$(printf '%s' "$s" | tr -d '\000-\010\013\014\016-\037'; printf x); s=${s%x}
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

body=$(escape_for_json "${preamble}${registry}")

session_context="<EXTREMELY_IMPORTANT>\naiKit is active.\n\n**Below is the full content of your 'aikit:using-aikit' skill - your entry point to the method. For every other skill, use the 'Skill' tool.**\n\n${body}\n</EXTREMELY_IMPORTANT>"

# printf rather than a heredoc: bash 5.3+ hangs on heredocs here.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
