#!/usr/bin/env bash
# Refuse a commit that would fail the method's own gates.
#
# Armed per clone: `git config core.hooksPath .githooks`. Gate 8 of
# scripts/doctor is what makes that arming visible instead of assumed.
set -uo pipefail
# GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE are set by git for the process
# running this hook. `git -C <dir>` still chdirs to <dir> as usual; what
# these override is the repo *discovery* that chdir would otherwise
# trigger there, pointing git back at this repo instead of <dir>.
# Drop this unset and gate 9 (scripts/test-vaults) starts failing, but
# only under `git commit` via this hook — a direct `scripts/doctor` run
# stays green.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
repo="$(git rev-parse --show-toplevel)"
exec "${repo}/scripts/doctor"
