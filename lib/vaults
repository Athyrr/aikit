#!/usr/bin/env bash
# Resolution des vaults et des projets. SOURCE, jamais execute.
#
# Remplace la remontee d'ancetres qui etait dupliquee dans hooks/session-start
# et les lanceurs de l'epoque (bin/scoped). Les chemins du fichier de vaults
# sont absolus, plus rien ne se devine en remontant les repertoires.
#
# Format du fichier, un enregistrement par ligne :
#     vault <nom> <chemin>
#     root  <nom> <chemin>
# Le chemin est TOUJOURS le dernier champ, donc `read -r kind name path` lui
# donne tout le reste de la ligne : une espace dans le chemin passe sans
# guillemets. Plusieurs lignes `root` pour un meme vault s'accumulent ; plusieurs
# lignes `vault` pour un meme nom, non -- la premiere gagne, voir vaults_list.
#
# Tout est sourcé par des consommateurs en `set -euo pipefail` : aucune
# fonction ne doit tuer l'hote sur une entree malformee ou un argument
# manquant. Elle rend le vide et sort 0.

# Le nom actuel d'abord, l'ancien ensuite : un poste pas encore migre reste
# branche et ne dit jamais "No vault registered". L'ancienne config n'est lue
# que tant que la nouvelle n'existe pas. Le repli se retire dans un cycle
# ulterieur, une fois tous les postes migres.
vaults_config_path() {
  if   [ -n "${HELIA_VAULTS:-}" ]; then printf '%s' "$HELIA_VAULTS"
  elif [ -n "${AIKIT_VAULTS:-}" ]; then printf '%s' "$AIKIT_VAULTS"
  elif [ ! -e "${HOME:-}/.config/helia/vaults" ] && [ -f "${HOME:-}/.config/aikit/vaults" ]; then
       printf '%s' "${HOME:-}/.config/aikit/vaults"
  else printf '%s' "${HOME:-}/.config/helia/vaults"; fi
}

# Copie unique de l'ancienne config vers la nouvelle, appelee par
# hooks/session-start. Ne supprime rien, n'ecrase rien, ne fait rien quand une
# variable designe la config. Comme tout ce fichier : ne tue jamais l'hote.
vaults_migrate_legacy() {
  [ -z "${HELIA_VAULTS:-}" ] && [ -z "${AIKIT_VAULTS:-}" ] && [ -n "${HOME:-}" ] || return 0
  local new="$HOME/.config/helia/vaults" old="$HOME/.config/aikit/vaults"
  [ ! -e "$new" ] && [ -f "$old" ] || return 0
  # Copie vers un temporaire puis mv : une copie partielle ne remplace jamais
  # le fichier. `|| :` : un echec ne doit pas tuer l'hote sous `set -e`.
  local tmp="$new.tmp.$$"
  { mkdir -p "${new%/*}" && cp -p "$old" "$tmp" && mv -f "$tmp" "$new"; } 2> /dev/null || :
  rm -f "$tmp" 2> /dev/null || :
  return 0
}

_vaults_read() {  # _vaults_read <mot-cle> [nom]
  local conf want_kind="$1" want_name="${2:-}" kind name path
  conf="$(vaults_config_path)"
  # -f avant -r : [ -r ] est vrai d'un repertoire, et `read` sur un repertoire
  # rend "Is a directory" puis laisse kind non assigne -> mort sous `set -u`.
  [ -f "$conf" ] && [ -r "$conf" ] || return 0
  while read -r kind name path || [ -n "$kind" ]; do
    # Le fichier decrit des chemins de disques Windows montes ; un editeur
    # Windows y laisse des CRLF, et le \r se collerait au dernier champ.
    kind="${kind%$'\r'}"; name="${name%$'\r'}"; path="${path%$'\r'}"
    case "$kind" in ''|'#'*) continue ;; esac
    [ "$kind" = "$want_kind" ] || continue
    [ -z "$want_name" ] || [ "$name" = "$want_name" ] || continue
    [ -n "$path" ] || continue
    printf '%s\t%s\n' "$name" "$path"
  done < "$conf"
}

# Un nom de vault est une CLEF : il ne sort qu'une fois, et c'est la premiere
# ligne declaree qui gagne -- la meme regle que vault_path, qui fait `head -1`.
# Sans cela un consommateur bouclant sur vaults_list rendait une section par
# ligne, chacune etiquetee de SON chemin, alors que resolve_projects re-resout
# par nom et rend donc toujours les fiches du premier : la seconde section
# affirmait un chemin que rien n'avait regarde. Les racines, elles, s'accumulent
# pour de bon -- un vault peut legitimement avoir plusieurs racines de recherche.
vaults_list() { _vaults_read vault | awk -F'\t' '!vu[$1]++'; }
vault_roots() { _vaults_read root "${1:-}" | cut -f2; }

vault_path() {  # vault_path <nom>
  _vaults_read vault "${1:-}" | cut -f2 | head -1
}

# Normalise une URL de remote en <hote>/<org>/<depot>, quelle que soit la forme
# du clone : scp (git@hote:org/depot), ssh://, https://, http://, git://, avec
# ou sans user@, avec ou sans port. Deux clones d'un meme depot par deux formes
# differentes doivent rendre la MEME clef, sinon la fiche ne s'apparie jamais.
_normalize_remote() {
  local u="$1" host rest
  u="${u%.git}"
  # Le schema d'abord : sinon le git@ de ssh://git@... survit au depouillement.
  u="${u#ssh://}"; u="${u#git://}"; u="${u#https://}"; u="${u#http://}"
  # user@ quelconque, et seulement dans l'autorite (avant le premier /).
  case "${u%%/*}" in *@*) u="${u#*@}" ;; esac
  host="${u%%:*}"
  if [ "$host" != "$u" ]; then
    rest="${u#*:}"
    case "${rest%%/*}" in
      # Tout chiffres -> c'est un port, on le jette. Sinon le ':' est le
      # separateur de la forme scp et vaut un '/'.
      ''|*[!0-9]*) u="$host/$rest" ;;
      *)           u="$host/${rest#*/}" ;;
    esac
  fi
  u="${u//\/\///}"      # ecrase le double slash
  printf '%s' "$u"
}

# vaults_scan <racine…> -> <hote/org/depot>\t<chemin absolu>, un depot par ligne.
# Profondeur 3 volontaire : une racine correctement declaree se scanne en ~18 ms.
# La barre finale sur "$root/" est ce qui fait descendre `find` dans une racine
# qui est un lien symbolique : sans elle, en mode -P, il rend zero depot en
# silence, et l'appariement par repo: meurt alors que [ -d ] traverse les liens.
# Mesure : c'est preferable a -L, qui suivrait AUSSI les liens rencontres plus
# bas -- ici le vault est un lien vers un disque Windows monte, et -L le faisait
# traverser a chaque demarrage de session (30 ms contre 0, et sans borne).
vaults_scan() {
  local root d url
  for root in "$@"; do
    [ -d "$root" ] || continue
    while IFS= read -r d; do
      d="${d%/.git}"
      url="$(git -C "$d" remote get-url origin 2>/dev/null)" || continue
      [ -n "$url" ] || continue
      printf '%s\t%s\n' "$(_normalize_remote "$url")" "$d"
    done < <(find "${root%/}/" -maxdepth 3 -name .git -type d 2>/dev/null)
  done
}

# Valeurs de `kind` que la methode connait : UNE seule definition, lue par
# project_warnings. Toute autre valeur est une faute de frappe a signaler.
VAULTS_KNOWN_KINDS="depot conception ecosysteme"


fiche_field() {  # fiche_field <fichier> <clef>
  awk -v key="$2" '
    /^---[[:space:]]*$/ { fm++; next }
    fm == 1 && $0 ~ "^" key ":" {
      sub("^" key ":[[:space:]]*", ""); gsub(/^["'"'"']|["'"'"']$/, ""); print; exit
    }
    fm >= 2 { exit }
  ' "$1"
}

# _fiche_value <fichier> <clef> -> la valeur, sans espaces ni \r de fin.
# fiche_field ne les retire pas ; le vault vit sur un disque Windows (CRLF), et
# avec la validation de kind, `kind: depot ` donnerait un faux « kind inconnu ».
_fiche_value() {
  local v
  v="$(fiche_field "$1" "$2")"
  v="${v%"${v##*[![:space:]]}"}"
  # Une tabulation interne a la valeur casserait le decoupage TSV de
  # resolve_projects (qui joint ses champs avec \t) : on la neutralise.
  v="${v//$'\t'/ }"
  printf '%s' "$v"
  return 0
}

# resolve_projects <nom-du-vault>
#   -> <nom>\t<kind>\t<present|absent>\t<chemin ou ->\t<summary>\t<part_of>
# part_of est la DERNIERE colonne ; `-` quand il est absent ou vide, comme summary
# (un champ vide serait absorbe par `IFS=$'\t' read`).
#
# repo: et dir: sont ORTHOGONAUX : repo: localise le depot, dir: dit ou est le
# repertoire de travail. Un depot dont le projet vit dans un sous-repertoire se
# decrit donc `repo: <cle>` + `dir: <sous-repertoire>`, vrai sur toutes les
# machines. Appariement :
#   - repo: apparie, sans dir:            -> le depot trouve
#   - repo: apparie, dir: s'y trouve      -> <depot trouve>/<dir>
#   - repo: apparie, dir: ne s'y trouve pas -> absent (fiche cassee, ca se voit)
#   - repo: absent ou n'apparie pas       -> <racine>/<dir>, a defaut <racine>/<nom>
resolve_projects() {
  local vname="${1:-}" vpath roots=() scanned f name kind repo dir summary part_of hit state r vault_repo
  vpath="$(vault_path "$vname")"
  [ -n "$vpath" ] && [ -d "$vpath/projects" ] || return 0
  while IFS= read -r r; do roots+=("$r"); done < <(vault_roots "$vname")
  scanned="$(vaults_scan "${roots[@]+"${roots[@]}"}")"
  # Le vault lui-meme n'est jamais range sous une racine de projets -- c'est sa
  # nature, pas un oubli de config -- donc sa propre fiche ne peut jamais
  # matcher par scan/probe generique. Elle existe forcement a $vpath (on vient
  # d'y lire les fiches), donc on la resout a part : sinon c'est un faux
  # negatif garanti ("absent" alors que c'est ce qu'on est en train de lire),
  # pas une information vraie comme pour un projet qui peut reellement manquer.
  vault_repo="$(_normalize_remote "$(git -C "$vpath" remote get-url origin 2>/dev/null)")"

  for f in "$vpath"/projects/*.md; do
    [ -e "$f" ] || continue
    name="$(_fiche_value "$f" name)";  [ -n "$name" ] || name="$(basename "$f" .md)"
    kind="$(_fiche_value "$f" kind)";  [ -n "$kind" ] || kind="depot"
    repo="$(_fiche_value "$f" repo)"
    dir="$(_fiche_value "$f" dir)"
    summary="$(_fiche_value "$f" summary)"; [ -n "$summary" ] || summary="-"
    part_of="$(_fiche_value "$f" part_of)"; [ -n "$part_of" ] || part_of="-"
    hit=""

    if [ -n "$repo" ] && [ -n "$vault_repo" ] && [ "$repo" = "$vault_repo" ]; then
      hit="$vpath"
    elif [ -n "$repo" ]; then
      hit="$(printf '%s\n' "$scanned" | awk -F'\t' -v k="$repo" '$1==k {print $2; exit}')"
    fi

    if [ -n "$hit" ] && [ -n "$dir" ]; then
      # repo: apparie ET dir: est declare : le projet est dans ce depot, ou il
      # n'est nulle part. Aucun repli -- ni sur la racine du depot, ni sur les
      # racines de recherche. La colonne 4 dit ou est le PROJET, pas ou est le
      # depot : rendre l'enveloppe affirmerait "il est ici" sans le savoir, et
      # un consommateur ouvrirait son perimetre sur le mauvais repertoire.
      # Un dir: qui ne resout pas est une fiche cassee, et ca doit se voir.
      if [ -d "$hit/$dir" ]; then hit="$hit/$dir"; else hit=""; fi
    elif [ -z "$hit" ]; then
      local probe="${dir:-$name}" root
      for root in "${roots[@]+"${roots[@]}"}"; do
        [ -d "$root/$probe" ] && { hit="$root/$probe"; break; }
      done
    fi

    [ -n "$hit" ] && state="present" || { state="absent"; hit="-"; }
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$kind" "$state" "$hit" "$summary" "$part_of"
  done
  return 0
}

# vault_behind_commits <chemin-du-clone>
#   -> nombre de commits que HEAD n'a pas recus de sa branche amont, ou VIDE
#      si inconnaissable. Ne leve JAMAIS : chaque garde rend le vide en
#      silence plutot qu'une erreur -- ce fichier est SOURCE, pas execute, et
#      herite donc du `set -euo pipefail` de hooks/session-start. Une commande
#      git non gardee ici tuerait tout le hook sur un simple remote injoignable.
vault_behind_commits() {  # vault_behind_commits <chemin>
  local vpath="${1:-}" behind
  [ -n "$vpath" ] && [ -d "$vpath/.git" ] || return 0
  # Pas de branche amont configuree (jamais clone, ou HEAD detachee) : rien a
  # comparer, et tenter quand meme ferait echouer rev-list plus bas.
  git -C "$vpath" rev-parse --verify -q '@{u}' > /dev/null 2>&1 || return 0
  # git fetch, jamais ls-remote seul : compter les commits demande les objets,
  # pas seulement le SHA distant. --quiet + timeout court + stderr jete :
  # un remote injoignable ou une cle SSH absente ne doivent produire ni
  # sortie ni erreur, seulement un silence.
  timeout 2 git -C "$vpath" fetch --quiet 2>/dev/null || return 0
  behind="$(git -C "$vpath" rev-list --count 'HEAD..@{u}' 2>/dev/null)" || return 0
  # Garde avant le test arithmetique : sous `set -e` herite, un `[ -gt ]` sur
  # une valeur non numerique casserait tout le hook plutot que de rendre 0.
  case "$behind" in ''|*[!0-9]*) return 0 ;; esac
  [ "$behind" -gt 0 ] || return 0
  printf '%s' "$behind"
}

# project_warnings : lit sur stdin la sortie de resolve_projects d'UN vault,
# emet `<nom>\t<message>` par anomalie, dans l'ordre d'entree. Pure : aucun
# acces disque. Une anomalie n'empeche jamais la resolution du projet.
#   kind hors de VAULTS_KNOWN_KINDS     -> ⚠ kind « <valeur> » inconnu
#   part_of sans fiche dans le vault    -> ⚠ part_of « <valeur> » : aucune fiche
#   part_of vers une fiche non ecosysteme -> ⚠ part_of « <valeur> » : n'est pas un écosystème
# Les valeurs affichees sont assainies (| -> /, * _ ` -> ') : une valeur de
# fiche repetee dans une cellule de tableau ne doit ni la casser ni ouvrir une
# emphase. La recherche, elle, se fait sur la valeur brute. \047 est l'apostrophe :
# le programme awk est entre apostrophes shell.
project_warnings() {
  KINDS="$VAULTS_KNOWN_KINDS" awk -F'\t' '
    function show(v) { gsub(/\|/, "/", v); gsub(/[*_`]/, "\047", v); return v }
    BEGIN { nk = split(ENVIRON["KINDS"], kl, " "); for (i = 1; i <= nk; i++) known[kl[i]] = 1 }
    NF == 0 { next }
    { cnt++; name[cnt] = $1; kind[cnt] = $2; part[cnt] = $6; kindof[$1] = $2 }
    END {
      for (i = 1; i <= cnt; i++) {
        if (!(kind[i] in known))
          printf "%s\t⚠ kind « %s » inconnu\n", name[i], show(kind[i])
        if (part[i] != "" && part[i] != "-") {
          if (!(part[i] in kindof))
            printf "%s\t⚠ part_of « %s » : aucune fiche\n", name[i], show(part[i])
          else if (kindof[part[i]] != "ecosysteme")
            printf "%s\t⚠ part_of « %s » : n\047est pas un écosystème\n", name[i], show(part[i])
        }
      }
    }'
  return 0
}

# render_project_rows <avertissements> : lit sur stdin la sortie de
# resolve_projects d'UN vault ; $1 est la sortie de project_warnings du meme
# vault (deux flux, un seul stdin : les lignes arrivent par stdin, les
# avertissements par l'argument, relus par awk via ENVIRON -- jamais `-v`, qui
# interpreterait les \). Emet les lignes `| nom | ici | summary |` du tableau de
# session. Sans tableau associatif bash (bash 3) : deux passes awk, un tri entre
# les deux.
#   1. sans part_of, ou part_of fautif       -> a sa place, ordre de resolution
#   2. ecosysteme                            -> a sa place, ses membres derriere,
#                                               prefixes `↳ `, tries (LC_ALL=C)
#   3. « ici » : depot -> oui | **absent d'ici** ; conception, ecosysteme -> —
#   4. nom : *(conception)*, *(écosystème)*, puis les avertissements
#   5. summary tronque a 120 octets max, sur une espace ASCII, suivi de `…`
# Un membre est une fiche dont part_of designe un ecosysteme de plus haut
# niveau (lui-meme sans part_of) ; sinon elle sort a plat, sans perdre de ligne.
render_project_rows() {
  local tab=$'\t'
  WARNS="${1:-}" awk -F'\t' '
    function clean(v) { gsub(/\|/, "/", v); return v }
    BEGIN {
      nw = split(ENVIRON["WARNS"], wl, "\n")
      for (i = 1; i <= nw; i++) {
        p = index(wl[i], "\t"); if (p == 0) continue
        wn = substr(wl[i], 1, p - 1); wm = substr(wl[i], p + 1)
        warn[wn] = (wn in warn) ? warn[wn] " " wm : wm
      }
    }
    NF == 0 { next }
    { cnt++; name[cnt] = $1; kind[cnt] = $2; state[cnt] = $3; summ[cnt] = $5; part[cnt] = $6
      seq[$1] = cnt; kindof[$1] = $2; partof[$1] = $6 }
    END {
      for (i = 1; i <= cnt; i++) {
        n = name[i]; p = part[i]
        member = (p != "" && p != "-" && (p in kindof) && kindof[p] == "ecosysteme" \
                  && (partof[p] == "-" || partof[p] == "")) ? 1 : 0
        gseq = member ? seq[p] : i
        printf "%06d\t%d\t%s\t%s\t%s\t%s\t%s\t%s\n", gseq, member, n, \
               clean(n), kind[i], state[i], clean(summ[i]), clean(warn[n])
      }
    }' | LC_ALL=C sort -t "$tab" -k1,1 -k2,2n -k3,3 | LC_ALL=C awk -F'\t' '
    # LC_ALL=C : length/substr comptent en octets (mawk ou gawk) ; on ne coupe
    # que sur une espace ASCII, donc jamais au milieu d un caractere UTF-8.
    function trunc(v,   i, c, r) {
      if (length(v) <= 120) return v
      c = 0
      for (i = 121; i >= 2; i--) if (substr(v, i, 1) == " ") { c = i - 1; break }
      if (c == 0) { r = index(substr(v, 122), " "); if (r == 0) return v; c = 121 + r - 1 }
      return substr(v, 1, c) "…"
    }
    {
      here = "oui"; if ($6 != "present") here = "**absent d\047ici**"
      label = $4
      if ($5 == "conception")      { here = "—"; label = label " *(conception)*" }
      else if ($5 == "ecosysteme") { here = "—"; label = label " *(écosystème)*" }
      if ($8 != "") label = label " " $8
      if ($2 == 1) label = "↳ " label
      printf "| %s | %s | %s |\n", label, here, trunc($7)
    }'
  return 0
}

# project_of_path <chemin> -> le nom du projet enregistre dont le dossier de
# travail contient <chemin>, ou VIDE. Cherche dans TOUS les vaults declares.
#   - seules comptent les fiches `depot` resolues `present` (colonne 4) : une
#     fiche `conception` ou `ecosysteme` n'a pas de dossier ;
#   - les chemins sont compares apres resolution des liens (pwd -P) ;
#   - le plus long prefixe gagne (projets imbriques) ; a egalite, le premier ;
#   - le prefixe s'arrete a une frontiere de dossier : `/a/b` ne contient pas
#     `/a/bc`.
# Ne leve jamais : fichier SOURCE, voir l'en-tete.
_realdir() { ( cd -P "$1" 2>/dev/null && pwd -P ); }
project_of_path() {  # project_of_path <chemin>
  local want vname name kind state p rp best="" bestlen=0
  [ -n "${1:-}" ] || return 0
  want="$(_realdir "$1")" || return 0
  [ -n "$want" ] || return 0
  while IFS=$'\t' read -r vname _; do
    [ -n "$vname" ] || continue
    while IFS=$'\t' read -r name kind state p _; do
      [ "$kind" = "depot" ] && [ "$state" = "present" ] && [ "$p" != "-" ] || continue
      rp="$(_realdir "$p")" || continue
      [ -n "$rp" ] || continue
      case "$want/" in "$rp"/*) ;; *) continue ;; esac
      if [ "${#rp}" -gt "$bestlen" ]; then best="$name"; bestlen="${#rp}"; fi
    done < <(resolve_projects "$vname")
  done < <(vaults_list)
  [ -z "$best" ] || printf '%s' "$best"
  return 0
}

# dispatch_override_warnings
#   -> zero, une ou deux lignes Markdown `- ...`, une par variable
#      d'environnement qui ecrase les reglages des archetypes :
#      CLAUDE_CODE_EFFORT_LEVEL ecrase tout effort, passe au dispatch comme
#      declare en frontmatter ; CLAUDE_CODE_SUBAGENT_MODEL_FORCE ecrase le
#      modele de tout frontmatter. Absente ou vide -> rien.
# Ne leve JAMAIS : fichier SOURCE sous `set -euo pipefail` (hooks/session-start),
# d'ou les `${VAR:-}`. La valeur affichee est mise sur une ligne (CR/LF ->
# espace) et privee de backtick (-> apostrophe) ; l'echappement JSON reste le
# travail d'escape_for_json, en aval, jamais celui de cette fonction.
dispatch_override_warnings() {  # dispatch_override_warnings -> 0, 1 ou 2 lignes
  local effort="${CLAUDE_CODE_EFFORT_LEVEL:-}" force="${CLAUDE_CODE_SUBAGENT_MODEL_FORCE:-}"
  if [ -n "$effort" ]; then
    effort="$(printf '%s' "$effort" | tr '\r\n`' "  '")" || effort="?"
    printf -- '- `CLAUDE_CODE_EFFORT_LEVEL` is set to `%s`: it overrides every effort passed at dispatch and every agent frontmatter, so the per-archetype effort of this method does not apply.\n' "$effort"
  fi
  if [ -n "$force" ]; then
    printf -- '- `CLAUDE_CODE_SUBAGENT_MODEL_FORCE` is set: the model in every agent frontmatter is ignored, so the per-archetype model of this method does not apply.\n'
  fi
  return 0
}

# --- consignes communes (hooks/consignes, hooks/session-start) ---------------
# <vault>/_global/consignes.md : consignes de l'humain valables pour tous les
# projets. UN seul code nettoie et compte : l'avertissement de session-start et
# l'injection de hooks/consignes doivent donner le meme nombre. Tout se compte
# en OCTETS (LC_ALL=C) : borne sure (octets >= caracteres), identique sur toute
# machine. Le harnais plafonne CHAQUE additionalContext a 10 000 caracteres.
CONSIGNES_BUDGET=9000    # octets, tous vaults, titres et ligne de troncature compris
CONSIGNES_WARN=4000      # octets ; au-dela, avertissement dans le tableau de session
CONSIGNES_RESERVE=512    # octets gardes pour la ligne de troncature

consignes_bytes() {  # consignes_bytes <texte> -> nombre d'octets
  printf '%s' "${1:-}" | LC_ALL=C wc -c | tr -d ' \r'
}

# consignes_clean <fichier> -> contenu sans \r, sans BOM initial, sans
# frontmatter initial FERME ; rien si absent, illisible, ou blanc apres
# nettoyage (un fichier vide vaut absent). Un frontmatter jamais ferme est
# garde tel quel : on n'avale pas un fichier entier sur une faute de frappe.
consignes_clean() {
  local f="${1:-}" c
  # Jamais de lien symbolique (fichier ou dossier _global) : on ne lit rien hors du vault.
  [ -n "$f" ] && [ -f "$f" ] && [ -r "$f" ] && [ ! -L "$f" ] && [ ! -L "${f%/*}" ] || return 0
  c=$(LC_ALL=C awk -v bom=$'\357\273\277' '
    { gsub(/\r/, "") }
    NR == 1 && index($0, bom) == 1 { $0 = substr($0, 4) }
    NR == 1 && $0 == "---" { infm = 1; next }
    infm { if ($0 == "---") infm = 0; else held[++h] = $0; next }
    { print }
    END { if (infm) { print "---"; for (i = 1; i <= h; i++) print held[i] } }
  ' "$f" 2> /dev/null) || c=""
  case "$c" in *[![:space:]]*) printf '%s' "$c" ;; esac
  return 0
}

# _consignes_cut <octets-max> : stdin -> les lignes ENTIERES qui tiennent dans
# le maximum, sauts de ligne compris. Lit tout (pas d'exit) : un `exit` ferait
# mourir l'ecrivain en SIGPIPE, fatal sous pipefail. Couper sur \n est sur en
# UTF-8 : l'octet 0x0A n'apparait dans aucun caractere multi-octets.
_consignes_cut() {
  LC_ALL=C awk -v max="$1" 'stop { next } { n = length($0) + 1; if (used + n > max) { stop = 1; next } used += n; print }'
}

_consignes_title() {  # _consignes_title <nom-du-vault>
  printf '## Consignes communes — vault `%s` (the most specific wins: the repository CLAUDE.md > <project>/heuristics.md > _global/consignes.md)' "$1"
}

# consignes_text -> le texte a injecter : un bloc titre par vault de
# vaults_list qui a des consignes, dans l'ordre de la config. Au-dela de
# CONSIGNES_BUDGET : les vaults sont servis dans l'ordre, le bloc qui ne tient
# plus est coupe sur une fin de ligne, et une ligne finale nomme le vault coupe
# et les vaults non servis. Rien quand aucun vault n'a de consignes.
consignes_text() {
  local names=() bodies=() vname vpath c i full="" out="" head room kept used
  local cut_part="" unserved="" stop=0 limit unames=() line shown n k
  while IFS=$'\t' read -r vname vpath; do
    [ -n "$vname" ] || continue
    c="$(consignes_clean "${vpath}/_global/consignes.md")"
    [ -n "$c" ] || continue
    names+=("$vname"); bodies+=("$c")
  done < <(vaults_list)
  [ "${#names[@]}" -gt 0 ] || return 0
  for i in "${!names[@]}"; do
    full+="$(_consignes_title "${names[$i]}")"$'\n\n'"${bodies[$i]}"$'\n\n'
  done
  if [ "$(consignes_bytes "$full")" -le "$CONSIGNES_BUDGET" ]; then
    printf '%s' "$full"; return 0
  fi
  limit=$((CONSIGNES_BUDGET - CONSIGNES_RESERVE))
  for i in "${!names[@]}"; do
    if [ "$stop" = 1 ]; then unames+=("${names[$i]}"); continue; fi
    head="$(_consignes_title "${names[$i]}")"$'\n\n'
    used=$(consignes_bytes "$out")
    if [ $((used + $(consignes_bytes "$head${bodies[$i]}") + 2)) -le "$limit" ]; then
      out+="$head${bodies[$i]}"$'\n\n'; continue
    fi
    stop=1
    room=$((limit - used - $(consignes_bytes "$head") - 2))
    kept=""
    if [ "$room" -gt 0 ]; then
      kept="$(printf '%s\n' "${bodies[$i]}" | _consignes_cut "$room")" || kept=""
    fi
    if [ -n "$kept" ]; then
      out+="$head$kept"$'\n\n'
      cut_part="vault \`${names[$i]}\` coupé à $(consignes_bytes "$kept") octets ; "
    else
      unames+=("${names[$i]}")
    fi
  done
  # La ligne finale tient dans CONSIGNES_RESERVE : au-dela, on liste ce qui
  # tient et on termine par « … et N autres ».
  n=${#unames[@]}
  for ((k = n; k >= 0; k--)); do
    shown=""
    for ((i = 0; i < k; i++)); do shown+="${shown:+, }\`${unames[$i]}\`"; done
    if [ "$k" -eq "$n" ]; then
      unserved="${shown:-aucun}"
    else
      unserved="${shown:+$shown }… et $((n - k)) autres"
    fi
    line="consignes tronquées : ${cut_part}non servis : ${unserved}"$'\n'
    [ "$(consignes_bytes "$line")" -le "$CONSIGNES_RESERVE" ] && break
  done
  printf '%s%s' "$out" "$line"
}
# escape_for_json <chaine> : partagee par hooks/session-start et hooks/consignes.
escape_for_json() {
    local s="$1"
    # Les caracteres de controle NUS d'abord, avant tout echappement : un
    # `summary:` de fiche est ecrit a la main, et un seul octet de ce genre
    # rend la chaine JSON invalide -- donc porte 4 rouge et preambule perdu a
    # CHAQUE demarrage de session. Tabulation (011), LF (012) et CR (015) sont
    # exclus du filtre expres : ils sont echappes correctement juste en dessous,
    # et les supprimer casserait la mise en forme du preambule injecte.
    #
    # La sentinelle `x` n'est pas decorative : `$( )` depouille les sauts de
    # ligne TERMINAUX, et ce sous-shell est le seul de la fonction qui voie
    # encore de vrais `\n` -- apres les substitutions ci-dessous il n'en reste
    # aucun, tous devenus deux caracteres, donc le `$( )` de l'appelant ne peut
    # plus rien manger. Sans elle, un preambule finissant par une ligne vide la
    # perdrait en silence.
    s=$(printf '%s' "$s" | tr -d '\000-\010\013\014\016-\037'; printf x); s=${s%x}
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}
