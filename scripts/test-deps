deps sf
has "versions egales, le commentaire n'est pas un paquet" "= g  base 4.4.0 (groupe sur main), amont 4.4.0" "$OUT"
clone groupe main "$(props Acme.Pack.Un 4.4.0 Acme.Pack.Deux 4.3.0)"
deps sf
has "versions differentes" "x g  non verifie : versions differentes" "$OUT"
is "... sortie 0" "0" "$RC"
clone groupe main "$(props Acme.Pack.Un 4.4.0 Acme.Pack.Deux '$(Foo)')"
deps sf
has "une version symbolique dans le groupe" "x g  non verifie : version introuvable : Acme.Pack.*" "$OUT"
clone groupe main "$(props Autre.Un 1.0.0)"
deps sf
has "aucun paquet du prefixe" "x g  non verifie : paquet introuvable : Acme.Pack.*" "$OUT"
clone groupe main "$(props NUnit 3.0.0 NUnit.Analyzers 4.4.0 NUnit3TestAdapter 4.4.0)"
fiche sf "| g | acme/lib | paquet NUnit* $LG |"
deps sf
has "un paquet egal au prefixe compte" "x g  non verifie : versions differentes" "$OUT"
clone groupe main "$(props NUnit 4.4.0)"
deps sf
has "... seul, il est trouve" "= g  base 4.4.0 (groupe sur main), amont 4.4.0" "$OUT"
clone groupe main "$(props Acme.P.Un 4.4.0 Acme.P.Un 3.0.0 Acme.P.Deux 4.4.0)"
fiche sf "| g | acme/lib | paquet Acme.P.* $LG |"
deps sf
has "un paquet repete a une autre version" "x g  non verifie : versions differentes" "$OUT"
if [ "$(id -u)" != 0 ] && { : > "$W/nr"; chmod 000 "$W/nr"; [ ! -r "$W/nr" ]; }; then
  clone groupe main "$(props Acme.Pack.Un 4.4.0)"
  chmod 000 "$ROOT/groupe/Directory.Packages.props"
  fiche sf "| g | acme/lib | paquet Acme.Pack.* $LG |"
  deps sf
  chmod 644 "$ROOT/groupe/Directory.Packages.props"
  has "manifeste illisible" "x g  non verifie : manifeste introuvable : Directory.Packages.props" "$OUT"
fi

echo "fiche conception sans clone"
printf -- '---\nname: sansclone\nkind: conception\nsummary: x\n---\n\n%s\n\n| Nom | Source | Base |\n|---|---|---|\n| a | acme/lib | release |\n| b | acme/lib | paquet Acme.Lib dans fantome:x |\n' "$ACCENT" > "$VAULT/projects/sansclone.md"
deps sansclone
has "release lue sans clone" "! a  vu vide, amont v4.4.0" "$OUT"
has "seul <clone> exige un clone" "x b  non verifie : clone absent : fantome" "$OUT"

echo "amont vide"
fiche sy "| g | acme/vide | branche master |" "| i | acme/vide#5 | pr |"
gh_repond '' api repos/acme/vide/branches/master --jq .commit.sha
gh_repond '' pr view 5 --repo acme/vide --json headRefOid,state --jq '.headRefOid + ":" + .state'
deps sy
has "branche a sortie vide : x, jamais =" "x g  non verifie : branche introuvable" "$OUT"
has "pr a sortie vide : x" "x i  non verifie : pr introuvable" "$OUT"
hasnt "... aucun faux =" "= g" "$OUT"


echo "surveille"
release_de acme/lib v4.4.0
clone garde main "$(props Acme.Un 4.4.0 Acme.Pack.Un 4.4.0 Acme.Pack.Deux 4.4.0 Autre.Tiers 1.0.0 Hors.Sujet 2.0.0 acme.minuscule 3.0.0)"
LW="dans garde:Directory.Packages.props"
fiche sw "| un | acme/lib | paquet Acme.Un $LW |" "| pack | acme/lib | paquet Acme.Pack.* $LW |" "| veille | | surveille Acme.* $LW |"
oublie_appels
deps sw
has "tout couvert, par nom exact et par prefixe" "= veille  tout declare (garde sur main)" "$OUT"
is "... sortie 0" "0" "$RC"
is "... seules les deux lignes paquet appellent gh" "2" "$(appels | grep -c 'releases/latest')"

fiche sw "| un | acme/lib | paquet Acme.Un $LW |" "| veille | | surveille Acme.* $LW |"
deps sw
has "paquets non declares, tous nommes" "x veille  non declares : Acme.Pack.Un, Acme.Pack.Deux" "$OUT"
has "... compte en non verifie" "0 ecart a trier, 1 non verifie" "$OUT"
is "... ne bloque pas : sortie 0" "0" "$RC"

fiche sw "| veille | | surveille Acme.*,Autre.* $LW |"
oublie_appels
deps sw
has "plusieurs motifs" "x veille  non declares : Acme.Un, Acme.Pack.Un, Acme.Pack.Deux, Autre.Tiers" "$OUT"
hasnt "... rien hors des motifs" "Hors.Sujet" "$OUT"
hasnt "... sensible a la casse" "acme.minuscule" "$OUT"
is "... aucun appel gh" "" "$(appels)"

clone autre main "$(props Acme.Un 4.4.0)"
fiche sw "| un | acme/lib | paquet Acme.Un dans autre:Directory.Packages.props |" "| veille | | surveille Acme.* $LW |"
deps sw
has "une ligne paquet d'un autre clone ne couvre pas" "Acme.Un" "$(printf '%s\n' "$OUT" | grep '^x veille')"

cat > "$ROOT/garde/package.json" <<'JSON'
{
  "dependencies": {
    "@acme/un": "^1.2.3",
    "@acme/deux": "2.0.0",
    "tiers": "1.0.0"
  }
}
JSON
LJ="dans garde:package.json"
fiche sj "| un | acme/lib | paquet @acme/un $LJ |" "| veille | | surveille @acme/* $LJ |"
deps sj
has "manifeste JSON" "x veille  non declares : @acme/deux" "$OUT"

planmd sj b "| plan | acme/lib | paquet @acme/deux $LJ | | | |"
deps sj b
has "une ligne paquet du plan couvre aussi" "= veille  tout declare (garde sur main)" "$OUT"

fiche sk "| veille | | surveille Acme.* dans fantome:x |" "| m | | surveille Acme.* dans garde:absent |" "| f | | surveille Acme dans garde:package.json |" "| v | | surveille Acme.*, Autre.* dans garde:package.json |" "| n | | surveille Acme.* |"
oublie_appels
deps sk
has "surveille, clone absent" "x veille  non verifie : clone absent : fantome" "$OUT"
has "surveille, manifeste absent" "x m       non verifie : manifeste introuvable : absent" "$OUT"
has "motif sans etoile" "x f       non verifie : base inconnue" "$OUT"
has "motifs separes par une espace" "x v       non verifie : base inconnue" "$OUT"
has "forme invalide" "x n       non verifie : base inconnue" "$OUT"
is "... aucun appel gh" "" "$(appels)"

fiche sl
