deps sl b
hasnt "ligne de plan surveille sans Source : pas de source absente" "source absente" "$OUT"

clone garde main "$(props Acme.Un 4.4.0 Acme.Pack.Un 4.4.0 Zed.Acme.Un 1.0.0)"
fiche sm "| a | | surveille *Acme* $LW |" "| b | | surveille Acme.*.Un* $LW |" "| c | | surveille Acme.** $LW |" "| d | | surveille Acme:* $LW |"
oublie_appels
deps sm
has "motif a etoile en tete" "x a  non verifie : base inconnue" "$OUT"
has "motif a etoile au milieu" "x b  non verifie : base inconnue" "$OUT"
has "motif a double etoile" "x c  non verifie : base inconnue" "$OUT"
has "motif hors de l'alphabet" "x d  non verifie : base inconnue" "$OUT"
hasnt "... aucun faux tout declare" "tout declare" "$OUT"

clone garde main "$(props Acme.Un 4.4.0 Acme.Pack.Un 4.4.0)"
fiche sn "| p | acme/lib | paquet * $LW |" "| veille | | surveille Acme.* $LW |"
deps sn
has "paquet * rejete ne couvre rien" "x veille  non declares : Acme.Un, Acme.Pack.Un" "$OUT"
hasnt "... aucun faux tout declare" "tout declare" "$OUT"

echo "commits non publies"
release_de acme/lib v4.4.0
gh_repond 3 api 'repos/acme/lib/compare/v4.4.0...HEAD' --jq .ahead_by
fiche sn "| rel | acme/lib | release |" "| pa | acme/lib | paquet Acme.Lib $L |"
planmd sn b "| rel | | | v4.4.0 | 2026-11-02 | sans effet |"
HELIA_DEPS_BUDGET=20 deps sn b
has "release, N commits non publies, jamais un ecart" "= rel  vu v4.4.0, amont v4.4.0, 3 commits non publies" "$OUT"
has "paquet, le tag d'origine sert au comptage" "= pa   base 4.4.0 (monclone sur HEAD detachee), amont 4.4.0, 3 commits non publies" "$OUT"
is "... sortie 0" "0" "$RC"
gh_repond 0 api 'repos/acme/lib/compare/v4.4.0...HEAD' --jq .ahead_by
HELIA_DEPS_BUDGET=20 deps sn b
hasnt "zero commit : rien a dire" "non publies" "$OUT"
gh_echoue 1 'gh: Server Error (HTTP 500)' api 'repos/acme/lib/compare/v4.4.0...HEAD' --jq .ahead_by
HELIA_DEPS_BUDGET=20 deps sn b
has "comptage en echec, la ligne reste valide" "= rel  vu v4.4.0, amont v4.4.0, commits non publies : non verifie" "$OUT"
is "... sortie 0" "0" "$RC"
fiche sn2 "| br | acme/lib | branche master |"
oublie_appels
deps sn2
hasnt "branche : pas de comptage" "compare" "$(appels)"

echo "budget et timeout"
d=$(gh_dir api repos/acme/lent/releases/latest --jq .tag_name); echo 3 > "$d/dort"
fiche sq "| a | acme/lent | release |"
debut=$SECONDS
OUT=$(HELIA_DEPS_BUDGET=1 bin/helia-deps sq 2>&1); RC=$?
has "delai depasse" "x a  non verifie : delai depasse" "$OUT"
is "... sortie 0" "0" "$RC"
[ $((SECONDS - debut)) -lt 3 ] && ok "... le budget coupe gh" || ko "... le budget coupe gh" "< 3 s" "$((SECONDS - debut)) s"
has "le budget vaut 5 s, ancien nom en repli" 'BUDGET=${HELIA_DEPS_BUDGET:-${AIKIT_DEPS_BUDGET:-5}}' "$(cat bin/helia-deps)"

GHSEUL="$W/ghseul"; mkdir -p "$GHSEUL"; ln -s "$FAUXBIN/gh" "$GHSEUL/gh"
gh_repond 0 api 'repos/acme/lib/compare/v4.4.0...HEAD' --jq .ahead_by
fiche sr2 "| rel | acme/lib | release |"
planmd sr2 b "| rel | | | v4.4.0 | 2026-11-02 | sans effet |"
OUT=$(PATH="$NOBIN:$GHSEUL" bin/helia-deps sr2 b 2>&1); RC=$?
is "sans timeout : la ligne sort quand meme" "= rel  vu v4.4.0, amont v4.4.0" "$(printf '%s\n' "$OUT" | sed -n 2,2p)"
has "... et le verdict le dit" "verdict : rien a trier, budget non garanti (timeout absent)" "$OUT"
is "... sortie 0" "0" "$RC"

WIN="$W/win"; mkdir -p "$WIN"
printf '#!/usr/bin/env bash\necho "Erreur : syntaxe incorrecte." >&2\nexit 1\n' > "$WIN/timeout"; chmod +x "$WIN/timeout"
OUT=$(PATH="$WIN:$PATH" bin/helia-deps sr2 b 2>&1)
has "un timeout qui ne repond pas a --version ne compte pas" "budget non garanti (timeout absent)" "$OUT"
has "... et n'est pas appele" "= rel  vu v4.4.0" "$OUT"

echo "budget : un seul total par dependance"
gh_repond v4.4.0 api repos/acme/lent/releases/latest --jq .tag_name
d=$(gh_dir api repos/acme/lent/releases/latest --jq .tag_name); echo v4.4.0 > "$d/out"; echo 0.05 > "$d/dort"
d=$(gh_dir api repos/acme/lent/compare/v4.4.0...HEAD --jq .ahead_by); echo 5 > "$d/dort"
fiche ss "| a | acme/lent | release |"
# Le tic de SECONDS du script n'est pas maitrisable : plusieurs passes, pour que
# la variante sans retenue d'une seconde ne passe jamais au travers.
debut=$SECONDS; partis=0; lances=0
for _ in 1 2 3 4 5 6; do
  oublie_appels
  OUT=$(HELIA_DEPS_BUDGET=1 bin/helia-deps ss 2>&1); RC=$?
  case "$(appels)" in *releases/latest*) lances=$((lances + 1)) ;; esac
  case "$(appels)" in *compare*) partis=$((partis + 1)) ;; esac
done
has "premier appel lent, second sans budget : non verifie" "commits non publies : non verifie" "$OUT"
is "... le premier appel a eu lieu a chaque passe" "6" "$lances"
is "... le second ne part jamais" "0" "$partis"
lim=4; case "$(uname -s)" in MINGW*|MSYS*) lim=12 ;; esac  # Windows : le demarrage d un processus coute ~0,7 s par passe (4 s mesures)
[ $((SECONDS - debut)) -lt $lim ] && ok "... le total ne depasse pas le budget" || ko "... le total ne depasse pas le budget" "< 2 s" "$((SECONDS - debut)) s"
for b in 5s 1.5; do
  OUT=$(HELIA_DEPS_BUDGET=$b bin/helia-deps ss 2>&1); RC=$?
  is "budget $b : sortie 2" "2" "$RC"
  has "... panne interne" "panne interne" "$OUT"
done
OUT=$(HELIA_DEPS_BUDGET=08 bin/helia-deps ss 2>&1); RC=$?
is "budget 08 : lu en base 10, l'ecart reste un ecart" "1" "$RC"
has "... et le verdict le dit" "verdict : 1 ecart a trier" "$OUT"
echo "budget : ancien nom lu en repli"
OUT=$(env -u HELIA_DEPS_BUDGET AIKIT_DEPS_BUDGET=5s bin/helia-deps ss 2>&1); RC=$?
is "AIKIT_DEPS_BUDGET seule est lue (valeur invalide : sortie 2)" "2" "$RC"
has "... panne interne" "panne interne" "$OUT"
OUT=$(HELIA_DEPS_BUDGET=1 AIKIT_DEPS_BUDGET=5s bin/helia-deps ss 2>&1); RC=$?
hasnt "HELIA_DEPS_BUDGET gagne sur AIKIT_DEPS_BUDGET" "panne interne" "$OUT"
echo
echo "$pass passes, $fail echecs"
# `exit`, jamais un test en derniere ligne : voir scripts/test-vaults.
exit $(( fail != 0 ))
