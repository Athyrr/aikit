#!/usr/bin/env bash
# Bump the version, run the ten gates, commit, push, publish.
#
# The plugin the harness runs is a COPY pinned to a version under
# ~/.claude/plugins/cache/. Editing this tree changes nothing until this script
# has run — that separation is the point of the montage, not a side effect.
#
# `claude plugin update` compares VERSIONS, not content. Without the bump it
# reports "already at the latest version" and the stale copy keeps running.
#
# Usage: scripts/deploy [patch|minor|major] "message"
set -euo pipefail

cd "$(dirname "$0")/.."
part=${1:-patch}
case "$part" in patch|minor|major) ;; *) echo "usage: scripts/deploy [patch|minor|major] \"message\"" >&2; exit 2 ;; esac

# --- where the push will go, resolved BEFORE anything is written -----------
#
# A bare `git push` obeys push.default, which is `simple` on every machine
# where nobody set it — and `simple` REFUSES a push whose upstream branch does
# not carry the name of the local branch. A tree whose `master` tracks
# `origin/main` therefore dies on `fatal: The upstream branch of your current
# branch does not match the name of your current branch`, exit 128, at the push
# — AFTER the bump and AFTER the commit, with no replay path: the version is in
# the history but not on the remote, and a second run would bump from a number
# already consumed. The first real deploy only got through because of a
# `git config --local push.default upstream` typed by hand, which lives in
# .git/config, is neither cloned nor pushed, and no gate measures. So the
# destination is named explicitly and push.default no longer has a say.
#
# The remote and the branch come from the config, not from cutting
# `@{upstream}` at a slash: that string is "<remote>/<branch>" and git ACCEPTS
# a remote whose name contains a slash — measured, a remote `grp/sub` tracking
# `feature/deep` yields `grp/sub/feature/deep`, where ${u%%/*} gives `grp` and
# ${u#*/} gives `sub/feature/deep`, both wrong. branch.<name>.merge already
# holds the full ref on the remote side, refs/heads/<branch>: the destination,
# with nothing to guess.
#
# Resolved here, before the first write, on purpose. A missing upstream is
# knowable now, and failing now costs nothing: no bump to undo, no commit to
# strand. Discovering it at the push would consume a version for good.
local_branch=$(git symbolic-ref --quiet --short HEAD || echo '')
push_remote=$(git config --get "branch.${local_branch}.remote" || echo '')
push_ref=$(git config --get "branch.${local_branch}.merge" || echo '')
if [ -z "$push_remote" ] || [ -z "$push_ref" ]; then
  echo "✗ no upstream for '${local_branch:-detached HEAD}' — nothing bumped, nothing committed." >&2
  echo "  deploy will not publish what it cannot push. Set the upstream first:" >&2
  echo "    git branch --set-upstream-to=origin/<branch> ${local_branch:-<branch>}" >&2
  echo "  then rerun deploy." >&2
  exit 1
fi
push_dest="${push_remote}/${push_ref#refs/heads/}"

# --- version arithmetic, without requiring python3 -------------------------
read_version() {
  if command -v node > /dev/null 2>&1; then
    node -e 'console.log(JSON.parse(require("fs").readFileSync(".claude-plugin/plugin.json","utf8")).version)'
  elif command -v python3 > /dev/null 2>&1; then
    python3 -c "import json;print(json.load(open('.claude-plugin/plugin.json'))['version'])"
  else
    echo "deploy: neither node nor python3 on PATH" >&2; exit 1
  fi
}

# Both manifests are parsed BEFORE either is written. plugin.json wins over
# marketplace.json at install time, so a run that bumped the first and then died
# on a malformed second would leave them divergent — and divergent manifests are
# exactly the state the installer ignores in silence. Writing one file is the
# failure this script exists to prevent; writing half of one pair is the same
# failure wearing a crash for a disguise.
write_version() {
  local v=$1
  if command -v node > /dev/null 2>&1; then
    node -e '
      const fs=require("fs"), v=process.argv[1];
      const out=[
        [".claude-plugin/plugin.json",      d => { d.version = v; }],
        [".claude-plugin/marketplace.json", d => { d.plugins[0].version = v; }],
      ].map(([p,f]) => { const d=JSON.parse(fs.readFileSync(p,"utf8")); f(d);
                         return [p, JSON.stringify(d,null,2)+"\n"]; });
      for (const [p,s] of out) fs.writeFileSync(p,s);
    ' "$v"
  elif command -v python3 > /dev/null 2>&1; then
    python3 - "$v" <<'PY'
import json, sys
# ensure_ascii=False, or this branch escapes every non-ASCII character while the
# node branch writes it raw — same input, two different files, and the diff a
# deploy produces would depend on which interpreter the machine happened to have.
v = sys.argv[1]
out = []
for path, mutate in (
    ('.claude-plugin/plugin.json',      lambda d: d.update(version=v)),
    ('.claude-plugin/marketplace.json', lambda d: d['plugins'][0].update(version=v)),
):
    with open(path, encoding='utf-8') as fh:
        d = json.load(fh)
    mutate(d)
    out.append((path, json.dumps(d, indent=2, ensure_ascii=False) + '\n'))
for path, text in out:
    with open(path, 'w', encoding='utf-8') as fh:
        fh.write(text)
PY
  else
    echo "deploy: neither node nor python3 on PATH" >&2; exit 1
  fi
}

# What the harness has actually installed, user scope — empty if nothing is.
# This file, not the script's own optimism, is the record of what will load.
installed_version() {
  local f="${HOME}/.claude/plugins/installed_plugins.json"
  [ -f "$f" ] || { echo ""; return 0; }
  if command -v node > /dev/null 2>&1; then
    node -e '
      const d=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      const e=((d.plugins||{})["aikit@aikit-marketplace"])||[];
      const u=e.find(x => x.scope === "user");
      console.log(u ? u.version : "");
    ' "$f"
  elif command -v python3 > /dev/null 2>&1; then
    python3 - "$f" <<'PY'
import json, sys
with open(sys.argv[1], encoding='utf-8') as fh:
    d = json.load(fh)
e = d.get('plugins', {}).get('aikit@aikit-marketplace', [])
u = next((x for x in e if x.get('scope') == 'user'), None)
print(u['version'] if u else '')
PY
  else
    echo "deploy: neither node nor python3 on PATH" >&2; exit 1
  fi
}

current=$(read_version)
IFS=. read -r maj min pat <<< "$current"
case "$part" in
  major) maj=$((maj+1)); min=0; pat=0 ;;
  minor) min=$((min+1)); pat=0 ;;
  patch) pat=$((pat+1)) ;;
esac
next="${maj}.${min}.${pat}"

write_version "$next"
echo "→ ${current} → ${next}"

# --- the gates, all ten, before anything leaves the machine ----------------
#
# The bump happens BEFORE the gates on purpose: what gets validated is the
# state that would ship, manifests included. But a red gate must not leave the
# bump behind — a second run would then bump twice, off a number that was never
# released. Rewriting $current through write_version undoes exactly this
# script's own edit, and nothing else: no git command, so any manifest change
# the user had made before running deploy survives.
scripts/doctor || {
  write_version "$current"
  echo "✗ gates failed — nothing committed, nothing pushed." >&2
  echo "  version restored to ${current}: the tree is as you left it, rerun once the gates are green." >&2
  exit 1
}

# --- commit, push, publish -------------------------------------------------
git add -A

# `git commit` exits 1 for "nothing to commit" AND for "a hook refused this",
# a failed GPG signature, a stale index.lock. Collapsing the two into one
# `|| echo "rien a committer"` is how a refused commit became a deploy that
# reported success: nothing committed, nothing pushed, `plugin update` answering
# "already at the latest version", and a green message at the end. From Task 14
# on, .githooks/pre-commit runs scripts/doctor, so this path is live on every
# deploy — and it is the second doctor run, the one nobody is watching, whose
# refusal would be swallowed. `git diff --cached --quiet` tells the two apart.
if git diff --cached --quiet; then
  echo "→ rien a committer"
else
  # Same restoration as the red gate above, for the same reason: nothing left
  # the machine, so the bump must not survive. Without it "corrige la cause,
  # puis relance" would be a trap — the rerun would read ${next} out of
  # plugin.json and publish the one after it, skipping a version that never
  # existed. Restored, the advice is true again, and it stops contradicting the
  # landing assertion below. The two are opposite on purpose and the difference
  # is real: here nothing was published, so rerun; there something was, so do
  # not. `write_version`, never `git checkout` — after a refused commit the
  # index still differs from HEAD, which makes a checkout wronger still.
  git commit -q -m "${next}${2:+ - $2}" || {
    write_version "$current"
    echo "✗ commit REFUSE — hook pre-commit, signature GPG, index.lock ?" >&2
    echo "  rien n'a ete commite, rien n'a ete pousse, rien n'a ete publie." >&2
    echo "  version restauree a ${current} : corrige la cause, puis relance deploy." >&2
    exit 1
  }
fi

# Explicit refspec, resolved at the top of this script: HEAD goes to the branch
# the upstream config names, whatever push.default happens to be here.
git push "$push_remote" HEAD:"$push_ref"
echo "→ pousse sur ${push_dest} ($(git remote get-url "$push_remote" 2>/dev/null || echo "$push_remote"))"

claude plugin marketplace update aikit-marketplace
claude plugin update aikit@aikit-marketplace --scope user
# Confirmation display only — it must never decide the exit status. Under
# `set -euo pipefail` a grep that matches nothing exits 1 and would fail the
# script AFTER a bump, a commit, a push and a publish that all succeeded:
# a release tool crying failure invites a replay of a deploy already done.
# So it reports what it did not find instead of dying of it.
claude plugin list | grep -A2 'aikit@aikit-marketplace' \
  || echo "→ aikit@aikit-marketplace introuvable dans la liste — verifier l'installation" >&2

# --- did it actually land? -------------------------------------------------
#
# Everything above can succeed one command at a time and still deploy nothing:
# a commit swallowed, a push landing on a branch the marketplace does not serve,
# `plugin update` answering "already at the latest version" with nobody reading.
# installed_plugins.json is the only record of what the harness will load, so it
# is the only thing worth asserting. A tool whose whole premise is "the old one
# lied" must check its own claim.
got=$(installed_version)
if [ "$got" != "$next" ]; then
  echo "✗ PAS deploye. installed_plugins.json donne '${got:-aucune installation}', attendu ${next}." >&2
  echo "  Le bump, le commit et le push ont pu reussir sans que rien n'atterrisse :" >&2
  echo "  verifier que la branche poussee est celle que le marketplace sert, puis" >&2
  echo "  rejouer les deux commandes 'claude plugin' seules — ne PAS relancer deploy," >&2
  echo "  qui bumperait une seconde fois a partir d'un numero deja pousse." >&2
  exit 1
fi
echo "→ installe : aikit@aikit-marketplace ${got} (installed_plugins.json)"
echo "→ deploye. Prend effet dans une NOUVELLE session."
