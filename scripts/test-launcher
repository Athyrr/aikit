#!/usr/bin/env bash
# Tests du lanceur : cli/helia, lib/launcher*, les cales de `helia install`.
# Faux claude, faux cygpath, faux uname, HOME jetables : aucun reseau, rien n'est
# ecrit hors de $TMP. jq est requis, comme pour le lanceur (SETUP.md).
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
command -v jq > /dev/null 2>&1 || { echo "jq absent : test impossible (prerequis, SETUP.md)" >&2; exit 1; }
# Lancee depuis une session helia, la suite heriterait de son environnement.
unset HELIA_LAUNCHER HELIA_UNINSTALL_COPY CLAUDE_CONFIG_DIR CLAUDE_CODE_PLUGIN_CACHE_DIR FAKE_UNAME FAKE_PLUGIN_DIR

pass=0; fail=0
ok()  { echo "  ✓ $1"; pass=$((pass+1)); }
ko()  { echo "  ✗ $1"; echo "      attendu: [$2]"; echo "      obtenu : [$3]"; fail=$((fail+1)); }
is()  { [ "$2" = "$3" ] && ok "$1" || ko "$1" "$2" "$3"; }
has() { case "$3" in *"$2"*) ok "$1" ;; *) ko "$1" "contient [$2]" "${3:-vide}" ;; esac; }
hasnt() { case "$3" in *"$2"*) ko "$1" "ne contient pas [$2]" "$3" ;; *) ok "$1" ;; esac; }

REPO="$PWD"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
REALJQ="$(command -v jq)"
ID="helia@athyrr-marketplace"
WINREPO="${REPO//\//\\}"          # le depot ecrit comme un installPath Windows
export FAKE_STATE="$TMP/state"; mkdir -p "$FAKE_STATE"
export HELIA_VAULTS="$TMP/aucun-fichier-de-vaults"
mkdir -p "$TMP/path-vide"

# --- faux binaires --------------------------------------------------------------
FAKEBIN="$TMP/bin"; mkdir -p "$FAKEBIN"
cat > "$FAKEBIN/claude" <<'EOF'
#!/usr/bin/env bash
# Faux claude : journalise l'appel, garde une copie du fichier --settings,
# repond a `plugin list|uninstall|update` depuis $FAKE_STATE.
printf '%s\n' "$*" >> "$FAKE_STATE/calls"
printf '%s\n' "HELIA_LAUNCHER=${HELIA_LAUNCHER:-}" "$@" > "$FAKE_STATE/last-args"
prev=""
for a in "$@"; do
  [ "$prev" = --settings ] && { cp "$a" "$FAKE_STATE/last-settings.json"; stat -c %a "$a" > "$FAKE_STATE/last-mode" 2> /dev/null; }
  prev="$a"
done
case "${1:-} ${2:-}" in
  "plugin list") cat "$FAKE_STATE/plugin-list.json" 2> /dev/null || echo '[]' ;;
  "plugin uninstall")
    cp "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" "$FAKE_STATE/settings-at-uninstall.json" 2> /dev/null
    [ -z "${FAKE_PLUGIN_DIR:-}" ] || rm -rf "$FAKE_PLUGIN_DIR"
    exit "$(cat "$FAKE_STATE/uninstall-rc" 2> /dev/null || echo 0)" ;;
  "plugin update") exit "$(cat "$FAKE_STATE/update-rc" 2> /dev/null || echo 0)" ;;
esac
exit 0
EOF
cat > "$FAKEBIN/cygpath" <<'EOF'
#!/usr/bin/env bash
# Faux cygpath : `-m <chemin>` rend les antislashs en slashs, rien d'autre.
[ "${1:-}" = -m ] || exit 1
p="${2:-}"; printf '%s\n' "${p//\\//}"
EOF
cat > "$FAKEBIN/uname" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "${FAKE_UNAME:-Linux}"
EOF
chmod +x "$FAKEBIN/claude" "$FAKEBIN/cygpath" "$FAKEBIN/uname"
# Un jq natif Windows termine chaque ligne par CR : ce faux jq le reproduit, et
# garde le code de sortie du vrai (pipefail).
CRLFBIN="$TMP/jq-crlf"; mkdir -p "$CRLFBIN"
printf '#!/usr/bin/env bash\nset -o pipefail\n"%s" "$@" | sed "s/\\$/\\r/"\n' "$REALJQ" > "$CRLFBIN/jq"; chmod +x "$CRLFBIN/jq"

# --- aides ------------------------------------------------------------------------
newhome() {  # newhome -> un HOME jetable ; remet a zero l'etat du faux claude
  local h; h="$(mktemp -d "$TMP/home.XXXXXX")"
  mkdir -p "$h/.claude/plugins" "$h/.config/helia" "$h/tmp"
  rm -rf "$FAKE_STATE"; mkdir -p "$FAKE_STATE"
  printf '%s' "$h"
}
IP() { printf '%s' "$1/.claude/plugins/installed_plugins.json"; }   # IP <home>
installed() {  # installed <fichier> <installPath> [version] [scope]
  jq -n --arg id "$ID" --arg p "$2" --arg v "${3:-9.9.9}" --arg s "${4:-user}" \
    '{version: 2, plugins: {($id): [{scope: $s, installPath: $p, version: $v}]}}' > "$1"
}
# hl <home> <args...> : cli/helia du depot, faux binaires devant le PATH (XPATH=
# ajoute des dossiers devant). hl : stdout ; hlerr : stderr ; hlall : les deux.
hl()    { local h="$1"; shift; HOME="$h" TMPDIR="$h/tmp" PATH="${XPATH:-}$FAKEBIN:$PATH" bash "$REPO/cli/helia" "$@" 2> /dev/null; }
hlerr() { local h="$1"; shift; HOME="$h" TMPDIR="$h/tmp" PATH="${XPATH:-}$FAKEBIN:$PATH" bash "$REPO/cli/helia" "$@" 2>&1 > /dev/null; }
hlall() { local h="$1"; shift; HOME="$h" TMPDIR="$h/tmp" PATH="${XPATH:-}$FAKEBIN:$PATH" bash "$REPO/cli/helia" "$@" 2>&1; }
lastargs() { cat "$FAKE_STATE/last-args" 2> /dev/null; }
lastset()  { jq -cS . "$FAKE_STATE/last-settings.json" 2> /dev/null; }
noclaude() {  # noclaude <libelle> : le faux claude n'a pas ete appele depuis newhome
  if [ -e "$FAKE_STATE/calls" ]; then ko "$1" "aucun appel" "$(cat "$FAKE_STATE/calls")"; else ok "$1"; fi
}
resolve() {  # resolve <home> : launcher_resolve, source depuis lib/launcher
  HOME="$1" PATH="${XPATH:-}$FAKEBIN:$PATH" bash -c '. "$1/lib/launcher"; launcher_resolve' _ "$REPO" 2> /dev/null
}
WANT_SL="HELIA_STATUSLINE=1 bash \"$REPO/bin/helia-statusline\""

# =============================================================================
echo "cli/helia : aiguillage"
H="$(newhome)"
out="$(hl "$H" help)"; rc=$?
is "help : sortie 0" "0" "$rc"
has "help : liste install" "helia install" "$out"
has "help : liste theme" "helia theme [helia|umbra|off]" "$out"
has "help : --help est celle de claude" "helia --help" "$out"
noclaude "help : claude n'est pas lance"

H="$(newhome)"
err="$(hlerr "$H" frobnique)"; rc=$?
is "mot inconnu : sortie 2" "2" "$rc"
has "mot inconnu : nomme le mot" "helia: commande inconnue 'frobnique'" "$err"
has "mot inconnu : l'aide suit, sur stderr" "helia install" "$err"
noclaude "mot inconnu : claude n'est pas lance"

# =============================================================================
echo "cli/helia : lancement"
H="$(newhome)"
hl "$H" > /dev/null; rc=$?
is "sans argument : sortie du faux claude" "0" "$rc"
is "HELIA_LAUNCHER=1 exporte" "HELIA_LAUNCHER=1" "$(lastargs | sed -n 1p)"
is "premier argument : --settings" "--settings" "$(lastargs | sed -n 2p)"
is "... le fichier de lancement" "$H/.config/helia/launch-settings.json" "$(lastargs | sed -n 3p)"
is "... et rien d'autre" "3" "$(lastargs | wc -l | tr -d ' ')"
is "reglages : plugin actif, theme Helia, status line" \
   "$(jq -cnS --arg id "$ID" --arg c "$WANT_SL" '{enabledPlugins: {($id): true}, theme: "custom:helia:helia", statusLine: {type: "command", command: $c}}')" \
   "$(lastset)"

H="$(newhome)"; hl "$H" -p "dis ok" > /dev/null
is "-p \"dis ok\" : transmis tel quel, apres --settings" "-p|dis ok" "$(lastargs | sed -n '4,5p' | paste -sd'|')"
H="$(newhome)"; hl "$H" --help > /dev/null
is "--help : passe a claude" "--help" "$(lastargs | sed -n 4p)"
H="$(newhome)"; hl "$H" -- install > /dev/null
is "-- install : passe a claude, pas une sous-commande" "--|install" "$(lastargs | sed -n '4,5p' | paste -sd'|')"
[ -e "$H/.local/bin/helia" ] && ko "-- install : aucune cale posee" "absente" "posee" || ok "-- install : aucune cale posee"

H="$(newhome)"; echo umbra > "$H/.config/helia/theme"; hl "$H" > /dev/null
is "theme umbra" "custom:helia:umbra" "$(jq -r '.theme' "$FAKE_STATE/last-settings.json")"
H="$(newhome)"; printf 'umbra\r\n' > "$H/.config/helia/theme"; hl "$H" > /dev/null
is "fichier theme en CRLF : umbra quand meme" "custom:helia:umbra" "$(jq -r '.theme' "$FAKE_STATE/last-settings.json")"
H="$(newhome)"; echo off > "$H/.config/helia/theme"; hl "$H" > /dev/null
is "theme off : cle absente" "absent" "$(jq -r '.theme // "absent"' "$FAKE_STATE/last-settings.json")"
H="$(newhome)"; echo bleu > "$H/.config/helia/theme"; hl "$H" > /dev/null
is "theme inconnu : Helia" "custom:helia:helia" "$(jq -r '.theme' "$FAKE_STATE/last-settings.json")"
H="$(newhome)"; : > "$H/.config/helia/no-statusline"; hl "$H" > /dev/null
is "no-statusline : pas de statusLine" "absent" "$(jq -r '.statusLine // "absent"' "$FAKE_STATE/last-settings.json")"
H="$(newhome)"; mkdir -p "$H/.config/aikit"; : > "$H/.config/aikit/no-statusline"; hl "$H" > /dev/null
is "ancien no-statusline : pas de statusLine" "absent" "$(jq -r '.statusLine // "absent"' "$FAKE_STATE/last-settings.json")"

H="$(newhome)"; hl "$H" > /dev/null; touch -d @0 "$H/.config/helia/launch-settings.json"
hl "$H" > /dev/null
is "relance a l'identique : fichier non reecrit (mtime)" "0" "$(stat -c %Y "$H/.config/helia/launch-settings.json")"
echo umbra > "$H/.config/helia/theme"; hl "$H" > /dev/null
is "changement de theme : fichier reecrit" "custom:helia:umbra" "$(jq -r '.theme' "$H/.config/helia/launch-settings.json")"
is "aucun temporaire laisse" "launch-settings.json theme" "$(ls "$H/.config/helia" | tr '\n' ' ' | sed 's/ $//')"

# =============================================================================
echo "cli/helia : --settings de l'utilisateur"
H="$(newhome)"
hl "$H" --settings '{"model":"haiku","enabledPlugins":{"autre@x":true},"statusLine":{"type":"command","command":"moi"}}' -p x > /dev/null; rc=$?
is "fusion : sortie 0" "0" "$rc"
is "fusion : un seul --settings transmis" "1" "$(lastargs | grep -c '^--settings$')"
has "fusion : fichier temporaire du lanceur" "$H/tmp/helia-launch." "$(lastargs | sed -n 3p)"
is "fusion : premier niveau, enabledPlugins par id, statusLine remplacee entiere" \
   "$(jq -cnS --arg id "$ID" '{enabledPlugins: {"autre@x": true, ($id): true}, model: "haiku", statusLine: {type: "command", command: "moi"}, theme: "custom:helia:helia"}')" \
   "$(lastset)"
case "$(uname -s)" in
  MINGW*|MSYS*) ok "fusion : droits 600 (sans effet sous Windows, non mesurable ici)" ;;
  *) is "fusion : fichier fusionne en mode 600 (reglages prives de l'utilisateur)" "600" "$(cat "$FAKE_STATE/last-mode" 2> /dev/null)" ;;
esac
is "fusion : -p x suit" "-p|x" "$(lastargs | sed -n '4,5p' | paste -sd'|')"
is "fusion : launch-settings.json intact" "custom:helia:helia|$WANT_SL" \
   "$(jq -r '"\(.theme)|\(.statusLine.command)"' "$H/.config/helia/launch-settings.json")"
H="$(newhome)"; echo '{"theme":"dark"}' > "$H/perso.json"; hl "$H" "--settings=$H/perso.json" > /dev/null
is "--settings=<fichier> : lu et fusionne" "dark" "$(jq -r '.theme' "$FAKE_STATE/last-settings.json")"
H="$(newhome)"; hl "$H" --settings "{\"enabledPlugins\":{\"$ID\":false}}" > /dev/null
is "l'utilisateur garde le dernier mot sur helia" "false" "$(jq -r --arg id "$ID" '.enabledPlugins[$id]' "$FAKE_STATE/last-settings.json")"
H="$(newhome)"; err="$(hlerr "$H" --settings '{pas du json')"; rc=$?
is "JSON invalide : sortie 2" "2" "$rc"
has "... le dit" "--settings invalide" "$err"
noclaude "... claude n'est pas lance"
H="$(newhome)"; hlerr "$H" --settings '[1,2]' > /dev/null; rc=$?
is "JSON qui n'est pas un objet : sortie 2" "2" "$rc"
H="$(newhome)"; hlerr "$H" --settings > /dev/null; rc=$?
is "--settings sans valeur : sortie 2" "2" "$rc"
H="$(newhome)"; hl "$H" -- --settings x > /dev/null
is "apres -- : --settings n'est plus lu par le lanceur" "--|--settings|x" "$(lastargs | sed -n '4,6p' | paste -sd'|')"

H="$(newhome)"
touch -d '2 days ago' "$H/tmp/helia-launch.111.json"; : > "$H/tmp/helia-launch.222.json"; : > "$H/tmp/autre.json"
hl "$H" > /dev/null
[ -e "$H/tmp/helia-launch.111.json" ] && ko "purge : plus d'un jour, supprime" "absent" "present" || ok "purge : plus d'un jour, supprime"
[ -e "$H/tmp/helia-launch.222.json" ] && ok "purge : recent, garde" || ko "purge : recent, garde" "present" "absent"
[ -e "$H/tmp/autre.json" ] && ok "purge : autre motif, garde" || ko "purge : autre motif, garde" "present" "absent"

# =============================================================================
echo "cli/helia : prerequis, jq CRLF"
H="$(newhome)"
err="$(HOME="$H" PATH="$TMP/path-vide" "$BASH" "$REPO/cli/helia" 2>&1 > /dev/null)"; rc=$?
is "sans jq : sortie 1" "1" "$rc"
has "... nomme jq" "jq" "$err"
JQONLY="$TMP/jq-seul"; mkdir -p "$JQONLY"
printf '#!%s\nexec "%s" "$@"\n' "$BASH" "$REALJQ" > "$JQONLY/jq"; chmod +x "$JQONLY/jq"
err="$(HOME="$H" PATH="$JQONLY" "$BASH" "$REPO/cli/helia" 2>&1 > /dev/null)"; rc=$?
is "sans claude : sortie 1" "1" "$rc"
has "... nomme claude" "claude" "$err"
H="$(newhome)"; echo umbra > "$H/.config/helia/theme"
XPATH="$CRLFBIN:" hl "$H" > /dev/null; rc=$?
is "jq CRLF : sortie 0" "0" "$rc"
is "jq CRLF : reglages justes" "custom:helia:umbra|$WANT_SL" \
   "$(jq -r '"\(.theme)|\(.statusLine.command)"' "$FAKE_STATE/last-settings.json")"
H="$(newhome)"; XPATH="$CRLFBIN:" hl "$H" --settings '{"model":"haiku"}' > /dev/null
is "jq CRLF : fusion juste" "haiku|true" \
   "$(jq -r --arg id "$ID" '"\(.model)|\(.enabledPlugins[$id])"' "$FAKE_STATE/last-settings.json")"

# =============================================================================
echo "lib/launcher : launcher_resolve"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"
is "installPath en antislashs : rendu en slashs (cygpath -m)" "$REPO" "$(resolve "$H")"
is "jq CRLF : meme chemin, sans CR" "$REPO" "$(XPATH="$CRLFBIN:" resolve "$H")"
H="$(newhome)"; C="$H/.claude/plugins/cache/athyrr-marketplace/helia/1.2.3"; mkdir -p "$C/cli"; : > "$C/cli/helia"
installed "$(IP "$H")" "$H/n-existe-pas" 1.2.3
is "installPath absent : dossier du cache par version" "$C" "$(resolve "$H")"
H="$(newhome)"; installed "$(IP "$H")" "$H/n-existe-pas" 1.2.3
CC="$TMP/cache-ailleurs"; mkdir -p "$CC/athyrr-marketplace/helia/1.2.3/cli"; : > "$CC/athyrr-marketplace/helia/1.2.3/cli/helia"
is "CLAUDE_CODE_PLUGIN_CACHE_DIR respecte" "$CC/athyrr-marketplace/helia/1.2.3" "$(CLAUDE_CODE_PLUGIN_CACHE_DIR="$CC" resolve "$H")"
H="$(newhome)"; mkdir -p "$H/autre/plugins"; installed "$H/autre/plugins/installed_plugins.json" "$WINREPO"
is "CLAUDE_CONFIG_DIR remplace ~/.claude" "$REPO" "$(CLAUDE_CONFIG_DIR="$H/autre" resolve "$H")"
H="$(newhome)"
jq -n --arg id "$ID" --arg p "$WINREPO" '[{id: $id, scope: "user", installPath: $p, version: "9.9.9"}]' > "$FAKE_STATE/plugin-list.json"
is "sans installed_plugins.json : repli claude plugin list --json" "$REPO" "$(resolve "$H")"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO" 9.9.9 project
r="$(resolve "$H")"; rc=$?
is "seule une entree project, liste vide : sortie 1" "1|" "$rc|$r"
H="$(newhome)"; installed "$(IP "$H")" "$H/n-existe-pas" 7.7.7
r="$(resolve "$H")"; rc=$?
is "dossier introuvable : sortie 1" "1|" "$rc|$r"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"
HOME="$H" PATH="$TMP/path-vide" "$BASH" -c '. "$1/lib/launcher"; launcher_resolve' _ "$REPO" > /dev/null 2>&1; rc=$?
is "sans jq : sortie 2" "2" "$rc"
# Autonome : c'est ce texte-la que `helia install` recopie dans la cale.
src="$(bash -c '. "$1/lib/launcher"; declare -f launcher_resolve' _ "$REPO")"
r="$(HOME="$H" PATH="$FAKEBIN:$PATH" bash -c "$src"$'\n''launcher_resolve' 2> /dev/null)"
is "launcher_resolve autonome : meme reponse hors de lib/launcher" "$REPO" "$r"

# =============================================================================
echo "helia install : cales"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"
out="$(hl "$H" install)"; rc=$?
SH="$H/.local/bin/helia"
is "install : sortie 0" "0" "$rc"
[ -x "$SH" ] && ok "cale bash posee, executable" || ko "cale bash posee, executable" "executable" "$(ls -l "$SH" 2>&1)"
has "... porte le marqueur" "HELIA_SHIM" "$(cat "$SH")"
is "... aucun CR" "0" "$(tr -cd '\015' < "$SH" | wc -c | tr -d ' ')"
hasnt "... aucune version" "$(jq -r .version .claude-plugin/plugin.json)" "$(cat "$SH")"
hasnt "... aucun chemin du plugin" "$REPO" "$(cat "$SH")"
[ -e "$H/.local/bin/helia.cmd" ] && ko "hors Windows : pas de helia.cmd" "absent" "present" || ok "hors Windows : pas de helia.cmd"
has "install : la cale est annoncee" "cale posée : $SH" "$out"
out="$(HOME="$H" PATH="$FAKEBIN:$PATH" bash "$SH" help 2> /dev/null)"
has "la cale passe la main a cli/helia" "helia install" "$out"
HOME="$H" TMPDIR="$H/tmp" PATH="$FAKEBIN:$PATH" bash "$SH" -p "dis ok" > /dev/null 2>&1
is "la cale lance : HELIA_LAUNCHER puis --settings" "HELIA_LAUNCHER=1|--settings" "$(lastargs | sed -n '1,2p' | paste -sd'|')"
is "... arguments intacts" "-p|dis ok" "$(lastargs | sed -n '4,5p' | paste -sd'|')"
HOME="$H" PATH="$CRLFBIN:$FAKEBIN:$PATH" bash "$SH" help > /dev/null 2>&1; rc=$?
is "jq CRLF : la cale trouve quand meme le plugin" "0" "$rc"
H2="$(newhome)"; mkdir -p "$H2/.local/bin"; cp "$SH" "$H2/.local/bin/helia"
err="$(HOME="$H2" PATH="$FAKEBIN:$PATH" bash "$H2/.local/bin/helia" help 2>&1 > /dev/null)"; rc=$?
is "plugin absent : le message exact" "helia: plugin non installé — claude plugin install helia@athyrr-marketplace --scope user" "$err"
is "... sortie 1" "1" "$rc"
installed "$(IP "$H2")" "$H2/parti" 3.3.3
err="$(HOME="$H2" PATH="$FAKEBIN:$PATH" bash "$H2/.local/bin/helia" help 2>&1 > /dev/null)"; rc=$?
is "dossier introuvable : meme message, sortie 1" "1|helia: plugin non installé — claude plugin install helia@athyrr-marketplace --scope user" "$rc|$err"
err="$(HOME="$H2" PATH="$TMP/path-vide" "$BASH" "$H2/.local/bin/helia" help 2>&1 > /dev/null)"; rc=$?
is "cale sans jq : sortie 1" "1" "$rc"
has "... nomme jq" "jq introuvable" "$err"

echo "helia install : Windows"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"
out="$(FAKE_UNAME=MINGW64_NT-10.0-26200 hlall "$H" install)"; rc=$?
CMD="$H/.local/bin/helia.cmd"
is "Windows : sortie 0" "0" "$rc"
[ -f "$CMD" ] && ok "Windows : helia.cmd posee" || ko "Windows : helia.cmd posee" "present" "absent"
[ -x "$H/.local/bin/helia" ] && ok "Windows : la cale bash aussi" || ko "Windows : la cale bash aussi" "present" "absent"
total="$(wc -l < "$CMD" | tr -d ' ')"
is "helia.cmd : chaque ligne en CRLF" "$total" "$(tr -cd '\015' < "$CMD" | wc -c | tr -d ' ')"
has "... marqueur" "HELIA_SHIM" "$(cat "$CMD")"
has "... passe la main a la cale bash voisine, arguments tels quels, code de sortie transmis" '"%HELIA_BASH%" "%~dp0helia" %* & exit /b' "$(cat "$CMD")"
l1="$(grep -nF 'if exist "C:\Program Files\Git\bin\bash.exe"' "$CMD" | head -1 | cut -d: -f1)"
l2="$(grep -nF 'C:\Program Files (x86)\Git\bin\bash.exe' "$CMD" | head -1 | cut -d: -f1)"
l3="$(grep -nF 'where bash' "$CMD" | head -1 | cut -d: -f1)"
if [ -n "$l1" ] && [ -n "$l2" ] && [ -n "$l3" ] && [ "$l1" -lt "$l2" ] && [ "$l2" -lt "$l3" ]; then
  ok "... cherche bash comme run-hook.cmd : Program Files, (x86), puis le PATH"
else ko "... cherche bash comme run-hook.cmd : Program Files, (x86), puis le PATH" "l1 < l2 < l3" "$l1 $l2 $l3"; fi
has "... bash introuvable : sortie 1" "exit /b 1" "$(cat "$CMD")"
has "... P1 : le repli where bash ignore %SystemRoot% (bash de WSL)" 'findstr /i /b /l /c:"%SystemRoot%"' "$(cat "$CMD")"
has "... P1b : ... et l'alias WindowsApps de WSL" '/c:"%LOCALAPPDATA%\Microsoft\WindowsApps"' "$(cat "$CMD")"
has "Windows, PATH absent : la ligne PowerShell est donnee" "SetEnvironmentVariable('Path'" "$out"

echo "helia install : refus, settings.json"
H="$(newhome)"; mkdir -p "$H/.local/bin"; echo 'mon helia a moi' > "$H/.local/bin/helia"
echo '{"theme":"custom:helia:helia"}' > "$H/.claude/settings.json"; cp "$H/.claude/settings.json" "$TMP/avant-refus"
err="$(hlerr "$H" install)"; rc=$?
is "fichier etranger : sortie 1" "1" "$rc"
has "... nomme le marqueur absent" "pas de marqueur HELIA_SHIM" "$err"
is "... fichier intact" "mon helia a moi" "$(cat "$H/.local/bin/helia")"
is "... settings.json intact : aucun ecrit avant les refus" "$(cat "$TMP/avant-refus")" "$(cat "$H/.claude/settings.json")"

H="$(newhome)"
jq -n --arg id "$ID" '{enabledPlugins: {($id): true, "autre@x": true}, theme: "custom:helia:umbra",
  statusLine: {type: "command", command: "HELIA_STATUSLINE=1 bash \"/x/bin/helia-statusline\""}, env: {SECRET: "s"}}' > "$H/.claude/settings.json"
cp "$H/.claude/settings.json" "$TMP/avant-install"
out="$(hl "$H" install)"; rc=$?
is "settings.json : helia a false, le reste garde, theme et status line Helia retires" \
   "$(jq -cnS --arg id "$ID" '{enabledPlugins: {($id): false, "autre@x": true}, env: {SECRET: "s"}}')" \
   "$(jq -cS . "$H/.claude/settings.json")"
is "sauvegarde : copie exacte de l'avant" "$(cat "$TMP/avant-install")" "$(cat "$H/.claude/settings.json.helia-backup")"
case "$(uname -s)" in
  MINGW*|MSYS*) ok "sauvegarde : droits 600 (sans effet sous Windows, non mesurable ici)" ;;
  *) is "sauvegarde : droits 600" "600" "$(stat -c %a "$H/.claude/settings.json.helia-backup")" ;;
esac
hasnt "sauvegarde : jamais affichee" "SECRET" "$out"
has "install : dit ce qu'il a fait" "settings.json : helia désactivé au niveau user" "$out"
is "aucun temporaire laisse" "plugins settings.json settings.json.helia-backup" "$(ls -A "$H/.claude" | tr '\n' ' ' | sed 's/ $//')"

H="$(newhome)"; echo '{"statusLine":{"type":"command","command":"AIKIT_STATUSLINE=1 bash x"},"theme":"dark"}' > "$H/.claude/settings.json"
hl "$H" install > /dev/null
is "ancien marqueur AIKIT : status line retiree, theme etranger garde" "absent|dark" \
   "$(jq -r '"\(.statusLine // "absent")|\(.theme)"' "$H/.claude/settings.json")"
H="$(newhome)"; echo '{"statusLine":{"type":"command","command":"~/a-moi.sh"}}' > "$H/.claude/settings.json"
hl "$H" install > /dev/null
is "status line de l'utilisateur gardee" "~/a-moi.sh" "$(jq -r '.statusLine.command' "$H/.claude/settings.json")"
H="$(newhome)"; hl "$H" install > /dev/null
is "settings.json absent : cree, helia a false" "$(jq -cn --arg id "$ID" '{enabledPlugins: {($id): false}}')" "$(jq -c . "$H/.claude/settings.json")"
H="$(newhome)"; printf '{"theme": "dark",\n' > "$H/.claude/settings.json"; cp "$H/.claude/settings.json" "$TMP/avant-invalide"
err="$(hlerr "$H" install)"; rc=$?
is "JSON invalide : sortie 1" "1" "$rc"
has "... le dit" "n'est pas un objet JSON" "$err"
is "... intact" "$(cat "$TMP/avant-invalide")" "$(cat "$H/.claude/settings.json")"
[ -e "$H/.local/bin/helia" ] && ko "... aucune cale posee" "absente" "posee" || ok "... aucune cale posee"
H="$(newhome)"; mkdir -p "$H/cfg"; echo '{}' > "$H/cfg/settings.json"
CLAUDE_CONFIG_DIR="$H/cfg" hl "$H" install > /dev/null
is "CLAUDE_CONFIG_DIR : son settings.json" "false" "$(jq -r --arg id "$ID" '.enabledPlugins[$id]' "$H/cfg/settings.json")"
[ -e "$H/.claude/settings.json" ] && ko "... et pas celui de ~/.claude" "absent" "cree" || ok "... et pas celui de ~/.claude"
H="$(newhome)"; mkdir -p "$TMP/reel-l"; echo '{"theme":"custom:helia:helia"}' > "$TMP/reel-l/settings.json"
if ln -s "$TMP/reel-l/settings.json" "$H/.claude/settings.json" 2> /dev/null && [ -L "$H/.claude/settings.json" ]; then
  hl "$H" install > /dev/null
  [ -L "$H/.claude/settings.json" ] && ok "lien symbolique : reste un lien" || ko "lien symbolique : reste un lien" "lien" "fichier"
  is "... la cible est ecrite" "false|absent" "$(jq -r --arg id "$ID" '"\(.enabledPlugins[$id])|\(.theme // "absent")"' "$TMP/reel-l/settings.json")"
else echo "  - lien symbolique : non disponible sur ce poste (ln -s copie), cas non mesure"; fi

echo "helia install : idempotence, PATH"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"; echo '{}' > "$H/.claude/settings.json"
hl "$H" install > /dev/null
touch -d @0 "$H/.claude/settings.json" "$H/.local/bin/helia" "$H/.claude/settings.json.helia-backup"
out="$(hl "$H" install)"; rc=$?
is "deuxieme install : sortie 0" "0" "$rc"
has "... le dit" "helia install : rien à faire, ce poste est déjà installé" "$out"
is "... rien de reecrit (mtime)" "0 0 0" \
   "$(stat -c %Y "$H/.claude/settings.json" "$H/.local/bin/helia" "$H/.claude/settings.json.helia-backup" | tr '\n' ' ' | sed 's/ $//')"
printf '#!/usr/bin/env bash\n# HELIA_SHIM ancienne forme\n' > "$H/.local/bin/helia"
out="$(hl "$H" install)"
has "cale Helia d'une autre forme : remplacee" "cale à jour : $H/.local/bin/helia" "$out"
is "... par la forme courante" "$(bash -c '. "$1/lib/launcher"; . "$1/lib/launcher-install"; launcher_shim_bash' _ "$REPO")" "$(cat "$H/.local/bin/helia")"
H="$(newhome)"; out="$(hlall "$H" install)"
has "PATH sans ~/.local/bin : la ligne a ajouter" 'export PATH="$HOME/.local/bin:$PATH"' "$out"
hasnt "... hors Windows, pas de PowerShell" "SetEnvironmentVariable" "$out"
H="$(newhome)"; out="$(XPATH="$H/.local/bin:" hlall "$H" install)"
hasnt "PATH deja bon : aucun avertissement" "n'est pas dans le PATH" "$out"

# =============================================================================
echo "helia uninstall"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"; echo '{"enabledPlugins":{"autre@x":true}}' > "$H/.claude/settings.json"
hl "$H" install > /dev/null; cp "$H/.claude/settings.json" "$TMP/avant-desinst"
out="$(printf 'n\n' | hlall "$H" uninstall)"; rc=$?
is "refus a la confirmation : sortie 1" "1" "$rc"
has "... la question" "[o/N]" "$out"
has "... le dit" "helia uninstall : abandon, rien n'a changé" "$out"
noclaude "... claude n'est pas appele"
is "... settings.json intact" "$(cat "$TMP/avant-desinst")" "$(cat "$H/.claude/settings.json")"
[ -e "$H/.local/bin/helia" ] && ok "... cale en place" || ko "... cale en place" "presente" "absente"
jq '.theme = "custom:helia:helia"' "$H/.claude/settings.json" > "$TMP/s.json" && mv "$TMP/s.json" "$H/.claude/settings.json"
out="$(hlall "$H" uninstall --yes)"; rc=$?
is "--yes : sortie 0" "0" "$rc"
has "claude plugin uninstall appele" "plugin uninstall helia@athyrr-marketplace" "$(cat "$FAKE_STATE/calls")"
is "A1 : a la desinstallation, helia vaut encore false" "false" \
   "$(jq -r --arg id "$ID" '.enabledPlugins[$id]' "$FAKE_STATE/settings-at-uninstall.json")"
is "apres : cle helia retiree, le reste garde, theme Helia retire" '{"enabledPlugins":{"autre@x":true}}' "$(jq -cS . "$H/.claude/settings.json")"
[ -e "$H/.local/bin/helia" ] && ko "cale retiree" "absente" "presente" || ok "cale retiree"
[ -d "$H/.config/helia" ] && ok "~/.config/helia garde" || ko "~/.config/helia garde" "present" "absent"
is "derniere ligne" "~/.config/helia conservé — rm -rf ~/.config/helia pour l'effacer" "$(printf '%s\n' "$out" | tail -1)"
is "copie temporaire effacee" "" "$(ls "$H/tmp" | grep helia-uninstall)"

H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"; hl "$H" install > /dev/null
printf 'o\n' | hlall "$H" uninstall > /dev/null; rc=$?
is "confirmation o : sortie 0" "0" "$rc"

H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"; hl "$H" install > /dev/null
echo 1 > "$FAKE_STATE/uninstall-rc"; cp "$H/.claude/settings.json" "$TMP/avant-echec"
err="$(hlerr "$H" uninstall --yes)"; rc=$?
is "claude plugin uninstall en echec : sortie 1" "1" "$rc"
has "... le dit" "a échoué — cales et settings.json laissés en place" "$err"
is "... settings.json intact" "$(cat "$TMP/avant-echec")" "$(cat "$H/.claude/settings.json")"
[ -e "$H/.local/bin/helia" ] && ok "... cale en place" || ko "... cale en place" "presente" "absente"

H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"; hl "$H" install > /dev/null; echo 'a moi' > "$H/.local/bin/helia.cmd"
out="$(hlall "$H" uninstall --yes)"
is "fichier etranger : laisse" "a moi" "$(cat "$H/.local/bin/helia.cmd")"
has "... et dit" "laissé en place (pas une cale Helia) : $H/.local/bin/helia.cmd" "$out"

H="$(newhome)"; PC="$TMP/cache-jetable/helia/9.9.9"; mkdir -p "$PC"; cp -r "$REPO/cli" "$REPO/lib" "$REPO/.claude-plugin" "$PC/"
installed "$(IP "$H")" "$PC"; hl "$H" install > /dev/null
out="$(HOME="$H" TMPDIR="$H/tmp" FAKE_PLUGIN_DIR="$PC" PATH="$FAKEBIN:$PATH" bash "$PC/cli/helia" uninstall --yes 2>&1)"; rc=$?
[ -d "$PC" ] && ko "temoin : le dossier du plugin a disparu" "absent" "present" || ok "temoin : le dossier du plugin a disparu"
is "depuis le cache qui disparait : sortie 0" "0" "$rc"
has "... va jusqu'au bout" "~/.config/helia conservé" "$out"
[ -e "$H/.local/bin/helia" ] && ko "... cales retirees" "absente" "presente" || ok "... cales retirees"
is "... copie temporaire effacee" "" "$(ls "$H/tmp" | grep helia-uninstall)"


echo "helia uninstall : copie temporaire, marqueur"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"; hl "$H" install > /dev/null
out="$(printf 'n\n' | HELIA_UNINSTALL_COPY=1 hlall "$H" uninstall)"; rc=$?
is "HELIA_UNINSTALL_COPY=1 seul : la question reste posee, abandon, sortie 1" "1" "$rc"
has "... [o/N]" "[o/N]" "$out"
noclaude "... claude n'est pas appele"
[ -e "$H/.local/bin/helia" ] && ok "... cale en place" || ko "... cale en place" "presente" "absente"
mkdir -p "$TMP/mkbin"; real_mktemp="$(command -v mktemp)"
printf '#!/usr/bin/env bash\nprintf "%%s\n" "$*" >> "%s/mktemp-calls"\nexec "%s" "$@"\n' "$TMP" "$real_mktemp" > "$TMP/mkbin/mktemp"; chmod +x "$TMP/mkbin/mktemp"
rm -f "$TMP/mktemp-calls"
mkdir -p "$H/tmp/helia-uninstall.1"
XPATH="$TMP/mkbin:" hlall "$H" uninstall --yes > /dev/null
has "la copie vient de mktemp -d (nom non predictible)" "-d $H/tmp/helia-uninstall.XXXXXX" "$(cat "$TMP/mktemp-calls" 2> /dev/null)"
is "... un dossier helia-uninstall.<pid> prepose n'est pas touche" "present" "$([ -d "$H/tmp/helia-uninstall.1" ] && echo present || echo absent)"
# =============================================================================
VERSION="$(jq -r '.version' .claude-plugin/plugin.json)"
mkdir -p "$TMP/v-ok"; printf 'vault vok %s\n' "$TMP/v-ok" > "$TMP/vaults-ok"

echo "helia theme"
H="$(newhome)"
is "sans fichier : helia" "helia" "$(hl "$H" theme)"
out="$(hl "$H" theme umbra)"; rc=$?
is "theme umbra : sortie 0" "0" "$rc"
has "... dit quand" "prend effet au prochain helia" "$out"
is "... ecrit" "umbra" "$(cat "$H/.config/helia/theme")"
is "... relu" "umbra" "$(hl "$H" theme)"
hl "$H" > /dev/null
is "... pris par le lancement suivant" "custom:helia:umbra" "$(jq -r '.theme' "$FAKE_STATE/last-settings.json")"
err="$(hlerr "$H" theme bleu)"; rc=$?
is "theme inconnu : sortie 2" "2" "$rc"
has "... le dit" "helia: thème inconnu 'bleu' (helia, umbra ou off)" "$err"
is "... fichier inchange" "umbra" "$(cat "$H/.config/helia/theme")"
hl "$H" theme off > /dev/null
is "off" "off" "$(hl "$H" theme)"

echo "helia version"
H="$(newhome)"
out="$(HELIA_VAULTS="$TMP/vaults-ok" hl "$H" version)"; rc=$?
is "version : sortie 0" "0" "$rc"
is "version : version, dossier, vaults" "helia $VERSION|dossier : $REPO|vaults :|  vok → $TMP/v-ok" "$(printf '%s\n' "$out" | paste -sd'|')"
has "aucun vault declare : le dit" "  aucun ($TMP/aucun-fichier-de-vaults)" "$(hl "$H" version)"
is "jq CRLF : version sans CR" "helia $VERSION" "$(XPATH="$CRLFBIN:" hl "$H" version | sed -n 1p)"

echo "helia doctor"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"; hl "$H" install > /dev/null
find "$H" -type f | sort > "$TMP/avant-doctor"; cksum < "$H/.claude/settings.json" > "$TMP/avant-doctor-ck"
out="$(XPATH="$H/.local/bin:" HELIA_VAULTS="$TMP/vaults-ok" hl "$H" doctor)"; rc=$?
is "poste installe : sortie 0" "0" "$rc"
is "... aucune ligne KO" "" "$(printf '%s\n' "$out" | grep '^KO')"
has "plugin installe, avec sa version" "ok  plugin installé : $VERSION ($REPO)" "$out"
has "cale" "ok  cale $H/.local/bin/helia" "$out"
has "PATH" "ok  $H/.local/bin dans le PATH" "$out"
has "enabledPlugins" "ok  enabledPlugins user = false" "$out"
has "theme" "ok  aucun thème Helia dans settings.json" "$out"
has "status line" "ok  aucune status line Helia dans settings.json" "$out"
has "bash" "ok  bash" "$out"; has "jq" "ok  jq" "$out"; has "claude" "ok  claude" "$out"
has "fichier de vaults" "ok  fichier de vaults $TMP/vaults-ok" "$out"
has "vault joignable" "ok  vault vok ($TMP/v-ok)" "$out"
is "lecture seule : aucun fichier cree ni retire" "$(cat "$TMP/avant-doctor")" "$(find "$H" -type f | sort)"
is "lecture seule : settings.json identique" "$(cat "$TMP/avant-doctor-ck")" "$(cksum < "$H/.claude/settings.json")"
out="$(XPATH="$CRLFBIN:$H/.local/bin:" HELIA_VAULTS="$TMP/vaults-ok" hl "$H" doctor)"; rc=$?
is "jq CRLF : tout ok" "0|" "$rc|$(printf '%s\n' "$out" | grep '^KO')"

jq --arg id "$ID" 'del(.enabledPlugins[$id]) | .theme = "custom:helia:umbra"
  | .statusLine = {type: "command", command: "HELIA_STATUSLINE=1 bash \"/x/bin/helia-statusline\""}' \
  "$H/.claude/settings.json" > "$TMP/s.json" && mv "$TMP/s.json" "$H/.claude/settings.json"
out="$(XPATH="$H/.local/bin:" HELIA_VAULTS="$TMP/vaults-ok" hl "$H" doctor)"; rc=$?
is "fuites : sortie 1" "1" "$rc"
has "cle absente = activee : KO" "KO  enabledPlugins[\"$ID\"] vaut null au niveau user" "$out"
has "theme Helia : fuite nommee, avec le remede" "fuite (/theme en session ?) — helia theme umbra puis helia install" "$out"
has "status line Helia : KO" "KO  status line Helia dans settings.json — helia install" "$out"

H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"
out="$(HELIA_VAULTS="$TMP/n-existe-pas" hl "$H" doctor)"; rc=$?
is "poste non installe : sortie 1" "1" "$rc"
has "cale absente" "KO  cale $H/.local/bin/helia absente — helia install" "$out"
has "PATH" "KO  $H/.local/bin absent du PATH" "$out"
has "settings.json absent" "KO  $H/.claude/settings.json absent" "$out"
has "fichier de vaults absent" "KO  fichier de vaults absent : $TMP/n-existe-pas" "$out"
H="$(newhome)"
has "plugin absent" "KO  plugin non installé — claude plugin install helia@athyrr-marketplace --scope user" "$(hl "$H" doctor)"
H="$(newhome)"; installed "$(IP "$H")" "$WINREPO"; FAKE_UNAME=MINGW64_NT-10.0-26200 hl "$H" install > /dev/null
rm -f "$H/.local/bin/helia.cmd"
has "Windows : helia.cmd exigee" "KO  cale $H/.local/bin/helia.cmd absente" \
    "$(FAKE_UNAME=MINGW64_NT-10.0-26200 XPATH="$H/.local/bin:" hl "$H" doctor)"
printf 'vault vok %s\nvault parti %s\n' "$TMP/v-ok" "$TMP/v-parti" > "$TMP/vaults-mixte"
has "vault injoignable nomme" "KO  vault parti injoignable : $TMP/v-parti" "$(HELIA_VAULTS="$TMP/vaults-mixte" hl "$H" doctor)"

echo "helia update"
UP="$TMP/up"; mkdir -p "$UP"
gq() { git -c user.name=t -c user.email=t@t -c init.defaultBranch=main "$@" > /dev/null 2>&1; }
gq init --bare "$UP/origin.git"
gq clone "$UP/origin.git" "$UP/seed"
echo a > "$UP/seed/note.md"; gq -C "$UP/seed" add note.md; gq -C "$UP/seed" commit -m c1; gq -C "$UP/seed" push origin HEAD:main
for v in propre sale diverge; do gq clone "$UP/origin.git" "$UP/$v"; done
echo b >> "$UP/seed/note.md"; gq -C "$UP/seed" commit -am c2; gq -C "$UP/seed" push origin HEAD:main
echo locale >> "$UP/sale/note.md"
echo x > "$UP/diverge/autre.md"; gq -C "$UP/diverge" add autre.md; gq -C "$UP/diverge" commit -m local
mkdir -p "$UP/pas-git"
printf 'vault propre %s\nvault sale %s\nvault diverge %s\nvault pas-git %s\n' "$UP/propre" "$UP/sale" "$UP/diverge" "$UP/pas-git" > "$TMP/vaults-up"
H="$(newhome)"
out="$(HELIA_VAULTS="$TMP/vaults-up" hl "$H" update)"; rc=$?
is "un vault saute : sortie 1" "1" "$rc"
has "le plugin d'abord, par claude" "plugin update helia@athyrr-marketplace" "$(cat "$FAKE_STATE/calls")"
has "vault propre : a jour" "à jour : propre" "$out"
is "... en avance rapide" "$(git -C "$UP/seed" rev-parse HEAD)" "$(git -C "$UP/propre" rev-parse HEAD)"
has "vault sale : saute" "sauté : sale (modifications locales)" "$out"
is "... jamais force : la modification reste" "locale" "$(tail -1 "$UP/sale/note.md")"
has "vault divergent : saute" "sauté : diverge (pull --ff-only refusé)" "$out"
has "pas un depot : saute" "sauté : pas-git (pas un dépôt git)" "$out"
gq -C "$UP/seed" commit --allow-empty -m c3; gq -C "$UP/seed" push origin HEAD:main
printf 'vault propre %s\n' "$UP/propre" > "$TMP/vaults-propre"
H="$(newhome)"; HELIA_VAULTS="$TMP/vaults-propre" hl "$H" update > /dev/null; rc=$?
is "tout a jour : sortie 0" "0" "$rc"
H="$(newhome)"; echo 1 > "$FAKE_STATE/update-rc"
out="$(HELIA_VAULTS="$TMP/vaults-propre" hlall "$H" update)"; rc=$?
is "claude plugin update en echec : sortie 1" "1" "$rc"
has "... le dit" "« claude plugin update helia@athyrr-marketplace » a échoué" "$out"
has "... les vaults passent quand meme" "à jour : propre" "$out"

# --- fin : le decompte ---
echo
echo "$pass passes, $fail echecs"
# `exit`, jamais un simple `[ "$fail" = 0 ]` en derniere ligne : le statut
# d'un script sans `set -e` est celui de sa DERNIERE commande, donc toute
# ligne ajoutee dessous rendrait la suite verte quoi qu'elle imprime -- et la
# porte 15 de `scripts/doctor` deviendrait decorative sans que rien ne le dise.
exit $(( fail != 0 ))
