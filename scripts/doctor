#!/usr/bin/env bash
# The method's completion criterion, nine gates, no deploy, no network state.
#
# `claude plugin validate .` checks the marketplace manifest ONLY — it reads no
# SKILL.md and no agents/*.md. The two --strict invocations are what gate the
# files you edit most, and they are separate on purpose.
#
# Gates 5-7 are what the four form gates never catch: they validate the TARGET,
# not the shape. Gate 8 is what makes the net exist on a machine other than the
# one where somebody remembered to wire it. Gate 9 runs lib/vaults' own suite:
# resolution runs at every session start, so its tests belong to the completion
# criterion rather than beside it.
#
# Usage: scripts/doctor
set -uo pipefail

cd "$(dirname "$0")/.." || {
  echo "✗ cannot cd to the repository root from '$0' — no gate ran" >&2
  exit 1
}
fail=0
run() { echo "→ $1"; shift; "$@" || { echo "  ✗ FAILED"; fail=1; }; }

# Validate JSON on stdin without requiring python3.
json_ok() {
  if command -v python3 > /dev/null 2>&1; then
    python3 -m json.tool > /dev/null
  elif command -v node > /dev/null 2>&1; then
    node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{JSON.parse(s)})'
  else
    echo "  ✗ neither python3 nor node on PATH" >&2
    return 1
  fi
}

# A grep gate passes when it finds NOTHING.
#
# This file is dropped from its own gates: it spells out the forbidden patterns,
# so it always contains them — a linter does not lint its own rule definitions.
# Anchored to this one path, not to scripts/: every sibling stays in scope.
#
# grep exits 1 when it finds nothing — a green gate — and >1 when it could not
# look at all, e.g. a SCOPE path that no longer exists. Those must never read
# alike: a gate that read nothing would otherwise report success. PIPESTATUS[0]
# is the gate's own grep, upstream of the self-exclusion filter; it is carried
# out of the command substitution, where the outer shell cannot see it.
gate_empty() {
  local label=$1; shift
  echo "→ $label"
  local out rc
  out=$("$@" 2>/dev/null | grep -Ev '^(\./)?scripts/doctor:'; exit "${PIPESTATUS[0]}")
  rc=$?
  if [ "$rc" -gt 1 ]; then
    echo "  ✗ DID NOT RUN — could not read its scope (grep exit $rc)"
    "$@" 2>&1 >/dev/null | sed 's/^/    /'
    fail=1
    return
  fi
  if [ -n "$out" ]; then
    echo "$out" | sed 's/^/    /'
    echo "  ✗ FAILED"
    fail=1
  fi
}

SCOPE=(skills agents hooks bin lib scripts README.md CLAUDE.md SETUP.md)

run "1 manifest"        claude plugin validate .
run "2 skills (strict)" claude plugin validate ./skills --strict
run "3 agents (strict)" claude plugin validate ./agents --strict

echo "→ 4 hook emits valid JSON"
if ! CLAUDE_PLUGIN_ROOT=$PWD bash hooks/session-start | json_ok; then
  echo "  ✗ FAILED"; fail=1
fi

# Gate 5 is a TRIPWIRE, not a debt probe: ancestor-walk resolution is already
# gone from the tree, and this is what refuses its return. `lib` is in SCOPE for
# it — that is the file most likely to grow a workspace root again.
gate_empty "5 no workspace-root resolution" \
    grep -rnE 'find_workspace|workspace_root|\$\{workspace\}' "${SCOPE[@]}"
gate_empty "6 no 'aikit/projects'"    grep -rn 'aikit/projects' "${SCOPE[@]}"
gate_empty "7 no workspace facts"     grep -rniIE '(ezytail|natseyes|periscope|reflex|kube-vigie)' . \
    --exclude-dir=.git --exclude-dir=.omc --exclude-dir=.claude \
    --exclude-dir=.worktrees --exclude-dir=.private-journal

echo "→ 8 core.hooksPath is .githooks"
if [ "$(git config --get core.hooksPath || true)" != ".githooks" ]; then
  echo "    git config core.hooksPath = '$(git config --get core.hooksPath || echo unset)'"
  echo "  ✗ FAILED"; fail=1
fi

# Silent when green, the whole suite when red — and captured from ONE run, so
# what gets printed is the run that actually failed.
echo "→ 9 vault resolution tests"
if ! vaults_out=$(scripts/test-vaults 2>&1); then
  echo "$vaults_out" | sed 's/^/    /'
  echo "  ✗ FAILED"; fail=1
fi

if [ "$fail" = 0 ]; then
  echo "✓ nine gates pass — GATES_PASS. A NEW session is still required to prove the method loads."
else
  echo "✗ one or more gates failed"
fi
exit "$fail"
