#!/usr/bin/env bash
# Tests de lib/vaults. Aucune dependance reseau, aucune fixture versionnee.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
. lib/vaults

pass=0; fail=0
ok()  { echo "  ✓ $1"; pass=$((pass+1)); }
ko()  { echo "  ✗ $1"; echo "      attendu: [$2]"; echo "      obtenu : [$3]"; fail=$((fail+1)); }
is()  { [ "$2" = "$3" ] && ok "$1" || ko "$1" "$2" "$3"; }

TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

# --- fixtures ---------------------------------------------------------------
# Une espace dans le chemin du vault, DELIBEREMENT : c'est le cas reel.
VAULT="$TMP/Mon Espace/levault"
ROOT="$TMP/code"
mkdir -p "$VAULT/projects" "$ROOT"

mkrepo() {  # mkrepo <dir> <remote-url>
  mkdir -p "$ROOT/$1" && git -C "$ROOT/$1" init -q
  [ -n "${2:-}" ] && git -C "$ROOT/$1" remote add origin "$2"
}
mkrepo avec-remote     "git@github.com:acme/avec-remote.git"
mkrepo autre-nom       "https://github.com/acme/renomme.git"
# Un depot dont le repertoire de travail est un SOUS-REPERTOIRE : repo: et dir:
# sont orthogonaux, dir: affine a l'interieur du depot trouve.
mkrepo depot-enveloppe "git@github.com:acme/depot-enveloppe.git"
mkdir -p "$ROOT/depot-enveloppe/dedans"
# Un depot clone en ssh:// : forme que l'ancien depouillement cassait.
mkrepo par-ssh         "ssh://git@github.com/acme/par-ssh.git"
mkdir -p "$ROOT/sans-git" "$ROOT/enveloppe/dedans"
# Une racine de recherche qui est un lien symbolique : find -P ne descend pas
# dans un argument symlink, le scan rendait zero depot en silence.
LINK="$TMP/lien-racine"; ln -s "$ROOT" "$LINK"

fiche() {  # fiche <nom> <lignes de frontmatter...>
  { echo "---"; echo "name: $1"; shift; printf '%s\n' "$@"; echo "---"; } \
    > "$VAULT/projects/${FICHE_NAME:-$1}.md"
}
fiche avec-remote "repo: github.com/acme/avec-remote" "summary: par remote ssh"
fiche par-https   "repo: github.com/acme/renomme"     "summary: par remote https"
fiche sans-git                                        "summary: par nom de repertoire"
fiche enveloppe   "dir: enveloppe/dedans"             "summary: par dir explicite"
fiche fantome                                         "summary: pas clone ici"
fiche idee        "kind: conception"                  "summary: sans depot du tout"
fiche travail     "repo: github.com/acme/depot-enveloppe" "dir: dedans" \
                  "summary: repo localise le depot, dir affine dedans"
fiche url-ssh     "repo: github.com/acme/par-ssh"     "summary: remote en ssh://"
fiche dir-absent  "repo: github.com/acme/par-ssh" "dir: pas-la" \
                  "summary: dir declare mais absent du depot"
fiche dir-piege   "repo: github.com/acme/par-ssh" "dir: sans-git" \
                  "summary: dir: absent du depot mais present sous une racine"
# Sans clef summary : la 5e colonne doit retomber sur "-", pas disparaitre.
fiche sans-summary "repo: github.com/acme/avec-remote"

CONF="$TMP/vaults"
{ echo "# commentaire ignore"
  echo ""
  echo "vault espace $VAULT"
  echo "root  espace $ROOT"
} > "$CONF"
export AIKIT_VAULTS="$CONF"

# --- assertions -------------------------------------------------------------
echo "vaults_list"
is "un seul vault, chemin avec espace intact" \
   "espace	$VAULT" "$(vaults_list)"

# Un nom declare DEUX FOIS : la boucle du hook prend vpath de vaults_list, mais
# resolve_projects re-resout par nom (vault_path -> head -1). Sans deduplication
# le rendu portait deux sections identiques, la seconde etiquetee du chemin B
# alors que ses lignes viennent de A -- une affirmation non verifiee, exactement
# ce que ce chantier existe pour interdire. Premiere ligne declaree gagne, comme
# pour vault_path, et a la difference des racines qui s'accumulent.
CONF_DBL="$TMP/vaults-double"
{ echo "vault essai $TMP/A"; echo "vault essai $TMP/B"; echo "vault autre $TMP/C"
  echo "root  essai $TMP/RA"; echo "root  essai $TMP/RB"; } > "$CONF_DBL"
is "un nom declare deux fois ne sort qu'une fois, premiere ligne gagnante" \
   "essai	$TMP/A
autre	$TMP/C" "$(AIKIT_VAULTS="$CONF_DBL" vaults_list)"
is "vaults_list et vault_path s'accordent sur le doublon" \
   "$TMP/A" "$(AIKIT_VAULTS="$CONF_DBL" vault_path essai)"
is "les racines, elles, s'accumulent toujours" \
   "$TMP/RA
$TMP/RB" "$(AIKIT_VAULTS="$CONF_DBL" vault_roots essai)"

echo "vault_roots"
is "la racine declaree" "$ROOT" "$(vault_roots espace)"

echo "_normalize_remote"
is "ssh:// avec git@"      "github.com/acme/repo" \
   "$(_normalize_remote 'ssh://git@github.com/acme/repo.git')"
is "ssh:// avec port"      "gitlab.example.com/acme/repo" \
   "$(_normalize_remote 'ssh://git@gitlab.example.com:2222/acme/repo.git')"
is "https avec user@"      "bitbucket.org/acme/repo" \
   "$(_normalize_remote 'https://user@bitbucket.org/acme/repo.git')"

echo "vaults_scan"
is "apparie ssh, ssh:// et https sur la meme forme normalisee" \
   "github.com/acme/avec-remote	$ROOT/avec-remote
github.com/acme/depot-enveloppe	$ROOT/depot-enveloppe
github.com/acme/par-ssh	$ROOT/par-ssh
github.com/acme/renomme	$ROOT/autre-nom" \
   "$(vaults_scan "$ROOT" | sort)"
is "une racine symlink est scannee comme une vraie" \
   "github.com/acme/avec-remote	$LINK/avec-remote
github.com/acme/depot-enveloppe	$LINK/depot-enveloppe
github.com/acme/par-ssh	$LINK/par-ssh
github.com/acme/renomme	$LINK/autre-nom" \
   "$(vaults_scan "$LINK" | sort)"

echo "resolve_projects"
r() { resolve_projects espace | awk -F'\t' -v n="$1" '$1==n {print $2"|"$3"|"$4}'; }
is "par remote ssh"            "depot|present|$ROOT/avec-remote"     "$(r avec-remote)"
is "par remote https"          "depot|present|$ROOT/autre-nom"       "$(r par-https)"
is "par remote ssh://"         "depot|present|$ROOT/par-ssh"         "$(r url-ssh)"
is "par nom de repertoire"     "depot|present|$ROOT/sans-git"        "$(r sans-git)"
is "dir: explicite"            "depot|present|$ROOT/enveloppe/dedans" "$(r enveloppe)"
is "repo: puis dir: affine dedans" \
   "depot|present|$ROOT/depot-enveloppe/dedans"                      "$(r travail)"
is "dir: declare mais absent du depot -> absent" \
   "depot|absent|-"                                                  "$(r dir-absent)"
is "et aucun repli sur les racines de recherche" \
   "depot|absent|-"                                                  "$(r dir-piege)"
is "non clone ici -> absent"   "depot|absent|-"                      "$(r fantome)"
is "kind: conception"          "conception|absent|-"                 "$(r idee)"

# La 5e colonne est lue par les consommateurs (tache 4 : read -r n kind state
# path summary). Sans cette assertion, la retirer du printf ne casse rien.
row() { resolve_projects espace | awk -F'\t' -v n="$1" '$1==n {print NF"|"$5}'; }
is "cinq colonnes, summary comprise" "5|par remote ssh" "$(row avec-remote)"
is "summary par defaut si la fiche n'en a pas" "5|-" "$(row sans-summary)"

echo "hook"
# Le hook est un CONSOMMATEUR de lib/vaults : il tourne dans un autre processus,
# en `set -euo pipefail`, et sa sortie est du JSON lu par le harnais. AIKIT_VAULTS
# est ce qui le rend testable ici.
out=$(AIKIT_VAULTS="$CONF" bash hooks/session-start)
printf '%s' "$out" | python3 -m json.tool > /dev/null \
  && ok "le hook emet du JSON valide" \
  || ko "le hook emet du JSON valide" "JSON" "invalide"
ctx=$(printf '%s' "$out" | python3 -c \
  "import json,sys;print(json.load(sys.stdin)['hookSpecificOutput']['additionalContext'])")
# Le preambule est skills/using-aikit/SKILL.md ; on ne garde que le bloc que le
# hook ajoute. Necessaire pour le mot `workspace` (SKILL.md le porte ailleurs),
# et sain pour tout le reste : aucune assertion ne doit pouvoir etre satisfaite
# par du texte de methode.
pre=$(cat skills/using-aikit/SKILL.md)
reg="${ctx#*"$pre"}"
case "$reg" in
  *"## Vault: espace"*) ok "la table est etiquetee par vault" ;;
  *) ko "la table est etiquetee par vault" "## Vault: espace" "absent" ;;
esac
# La LIGNE ENTIERE, pas `| fantome |` suivi d'un `absent` flottant : le bloc se
# termine toujours par « A project marked **absent d'ici** is registered but not
# cloned… », donc le mot est garanti APRES n'importe quelle ligne de table. Un
# motif non ancre etait satisfait par ce boilerplate et restait vert meme avec
# un `here="oui"` inconditionnel -- c'est-a-dire en ne testant rien.
ligne() { printf '%s\n' "$reg" | grep -F "| $1 |" | head -1; }
is "un projet non clone est marque absent d'ici" \
   "| fantome | **absent d'ici** | pas clone ici |" "$(ligne fantome)"
is "un projet clone est marque present" \
   "| avec-remote | oui | par remote ssh |" "$(ligne avec-remote)"
printf '%s' "$reg" | grep -qi workspace \
  && ko "le mot workspace a disparu de la table injectee" "" "workspace present" \
  || ok "le mot workspace a disparu de la table injectee"
grep -qi workspace hooks/session-start \
  && ko "le mot workspace a disparu du hook" "" "workspace present" \
  || ok "le mot workspace a disparu du hook"

echo "hook : vaults declares mais sans fiche"
# Un vault declare qui ne rend aucune fiche ne doit JAMAIS se taire : la methode
# se chargerait sans routeur et sans explication. Trois cas qui ne doivent pas
# se lire pareil -- aucun vault declare / declares mais aucun ne porte de fiche /
# certains resolvent et d'autres non.
hookreg() {  # hookreg <fichier de vaults> -> le bloc que le hook ajoute
  local out ctx
  out=$(AIKIT_VAULTS="$1" bash hooks/session-start) || return 1
  ctx=$(printf '%s' "$out" | python3 -c \
    "import json,sys;print(json.load(sys.stdin)['hookSpecificOutput']['additionalContext'])") \
    || return 1
  printf '%s' "${ctx#*"$pre"}"
}

# projects/ ABSENT : le repertoire du vault existe, mais rien dedans.
ORPHELIN="$TMP/orphelin"; mkdir -p "$ORPHELIN"
printf 'vault orphelin %s\n' "$ORPHELIN" > "$TMP/vaults-orphelin"
# projects/ PRESENT mais VIDE : ce n'est pas la meme panne, ni le meme remede.
VIDE="$TMP/videvault"; mkdir -p "$VIDE/projects"
printf 'vault vide %s\n' "$VIDE" > "$TMP/vaults-vide"
# Un vault qui resout ET un qui ne resout pas : les deux doivent apparaitre.
{ echo "vault espace $VAULT"; echo "root  espace $ROOT"
  echo "vault orphelin $ORPHELIN"; } > "$TMP/vaults-mixte"

# Etat 1 : aucun vault declare. C'est l'etat de la PREMIERE INSTALLATION, et il
# n'avait aucune assertion : une regression qui viderait cette branche serait
# sortie verte partout.
reg_aucun=$(hookreg /nonexistent-vaults-file)
case "$reg_aucun" in
  *"## No vault registered on this machine"*) ok "aucun vault declare : la note existe" ;;
  *) ko "aucun vault declare : la note existe" \
        "## No vault registered on this machine" "${reg_aucun:-vide}" ;;
esac
case "$reg_aucun" in
  *"## No project registry found"*) ko "aucun-vault ne se lit pas comme declare-mais-introuvable" \
        "pas d'en-tete 'No project registry found'" "les deux notes confondues" ;;
  *) ok "aucun-vault ne se lit pas comme declare-mais-introuvable" ;;
esac

reg_orphelin=$(hookreg "$TMP/vaults-orphelin")
case "$reg_orphelin" in
  *"orphelin"*"${ORPHELIN}/projects"*) ok "un vault sans fiche est nomme, avec l'endroit cherche" ;;
  *) ko "un vault sans fiche est nomme, avec l'endroit cherche" \
        "orphelin + ${ORPHELIN}/projects" "${reg_orphelin:-vide}" ;;
esac
case "$reg_orphelin" in
  *"No vault registered"*) ko "declare-mais-introuvable ne se lit pas comme aucun-vault" \
                              "en-tete distinct" "la note 'No vault registered'" ;;
  *"## No project registry found"*) ok "declare-mais-introuvable ne se lit pas comme aucun-vault" ;;
  *) ko "declare-mais-introuvable ne se lit pas comme aucun-vault" \
        "## No project registry found" "absent" ;;
esac

reg_vide=$(hookreg "$TMP/vaults-vide")
case "$reg_vide" in
  *"${VIDE}/projects"*"does not exist"*) \
    ko "projects/ vide : la raison differe de projects/ absent" \
       "ne pas affirmer l'inexistence" "\"does not exist\" sur un repertoire present" ;;
  *"vide"*"${VIDE}/projects"*) ok "projects/ vide : la raison differe de projects/ absent" ;;
  *) ko "projects/ vide : la raison differe de projects/ absent" \
        "vide + ${VIDE}/projects" "${reg_vide:-vide}" ;;
esac

# Minor 5 : `projects` existe, mais c'est un FICHIER. Annoncer « does not exist »
# serait le meme petit mensonge que celui entre absent et vide.
FICHIER="$TMP/fichiervault"; mkdir -p "$FICHIER"; : > "$FICHIER/projects"
printf 'vault fichier %s\n' "$FICHIER" > "$TMP/vaults-fichier"
reg_fichier=$(hookreg "$TMP/vaults-fichier")
case "$reg_fichier" in
  *"does not exist"*) ko "projects/ present mais fichier : ne pas dire qu'il n'existe pas" \
        "une raison qui ne ment pas" "does not exist" ;;
  *"fichier"*"${FICHIER}/projects"*) ok "projects/ present mais fichier : ne pas dire qu'il n'existe pas" ;;
  *) ko "projects/ present mais fichier : ne pas dire qu'il n'existe pas" \
        "fichier + ${FICHIER}/projects" "${reg_fichier:-vide}" ;;
esac

reg_mixte=$(hookreg "$TMP/vaults-mixte")
case "$reg_mixte" in
  *"## Vault: espace"*"| fantome |"*"orphelin"*) \
    ok "un vault qui resout et un qui ne resout pas : les deux sortent" ;;
  *) ko "un vault qui resout et un qui ne resout pas : les deux sortent" \
        "la table de espace + la mention de orphelin" "${reg_mixte:-vide}" ;;
esac

echo
echo "$pass passes, $fail echecs"
[ "$fail" = 0 ]
