#!/usr/bin/env bash
# Tests de lib/vaults. Aucune dependance reseau, aucune fixture versionnee.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
. lib/vaults

pass=0; fail=0
ok()  { echo "  ✓ $1"; pass=$((pass+1)); }
ko()  { echo "  ✗ $1"; echo "      attendu: [$2]"; echo "      obtenu : [$3]"; fail=$((fail+1)); }
is()  { [ "$2" = "$3" ] && ok "$1" || ko "$1" "$2" "$3"; }

# JSON helpers: node first (a hard dependency of the harness, never absent),
# python3 as fallback -- same order and same reason as scripts/doctor's
# json_ok(). `python3` can be on PATH and still not be a real interpreter
# (Windows App Execution Alias stub).
json_valid() {  # lit sur stdin, code de sortie seul
  local input; input="$(cat)"
  if command -v node > /dev/null 2>&1 \
    && printf '%s' "$input" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{JSON.parse(s)})' 2>/dev/null
  then return 0; fi
  if command -v python3 > /dev/null 2>&1 \
    && printf '%s' "$input" | python3 -m json.tool > /dev/null 2>&1
  then return 0; fi
  return 1
}
json_ctx() {  # lit le JSON du hook sur stdin, imprime .hookSpecificOutput.additionalContext
  local input out
  input="$(cat)"
  if command -v node > /dev/null 2>&1; then
    out=$(printf '%s' "$input" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{process.stdout.write(JSON.parse(s).hookSpecificOutput.additionalContext)})' 2>/dev/null) \
      && { printf '%s' "$out"; return 0; }
  fi
  if command -v python3 > /dev/null 2>&1; then
    printf '%s' "$input" | python3 -c \
      "import json,sys;print(json.load(sys.stdin)['hookSpecificOutput']['additionalContext'])"
    return $?
  fi
  return 1
}
trailing_newlines_before() {  # <chaine> <suffixe> -> nb de \n juste avant le suffixe final, ou -1
  local s="$1" tag="$2" n=0
  case "$s" in
    *"$tag") s="${s%"$tag"}" ;;
    *) printf -- '-1'; return ;;
  esac
  while [[ "$s" == *$'\n' ]]; do n=$((n+1)); s="${s%$'\n'}"; done
  printf '%s' "$n"
}

TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

# --- fixtures ---------------------------------------------------------------
# Une espace dans le chemin du vault, DELIBEREMENT : c'est le cas reel.
VAULT="$TMP/Mon Espace/levault"
ROOT="$TMP/code"
mkdir -p "$VAULT/projects" "$ROOT"
# Le vault est lui-meme un depot git, jamais range sous une racine de projets
# (ROOT) -- sa propre fiche doit quand meme resoudre present, voir plus bas.
git -C "$VAULT" init -q
git -C "$VAULT" remote add origin "git@github.com:acme/levault.git"

mkrepo() {  # mkrepo <dir> <remote-url>
  mkdir -p "$ROOT/$1" && git -C "$ROOT/$1" init -q
  [ -n "${2:-}" ] && git -C "$ROOT/$1" remote add origin "$2"
}
mkrepo avec-remote     "git@github.com:acme/avec-remote.git"
mkrepo autre-nom       "https://github.com/acme/renomme.git"
# Un depot dont le repertoire de travail est un SOUS-REPERTOIRE : repo: et dir:
# sont orthogonaux, dir: affine a l'interieur du depot trouve.
mkrepo depot-enveloppe "git@github.com:acme/depot-enveloppe.git"
mkdir -p "$ROOT/depot-enveloppe/dedans"
# Un depot clone en ssh:// : forme que l'ancien depouillement cassait.
mkrepo par-ssh         "ssh://git@github.com/acme/par-ssh.git"
mkdir -p "$ROOT/sans-git" "$ROOT/enveloppe/dedans"
# Une racine de recherche qui est un lien symbolique : find -P ne descend pas
# dans un argument symlink, le scan rendait zero depot en silence.
LINK="$TMP/lien-racine"; ln -s "$ROOT" "$LINK"

fiche() {  # fiche <nom> <lignes de frontmatter...>
  { echo "---"; echo "name: $1"; shift; printf '%s\n' "$@"; echo "---"; } \
    > "$VAULT/projects/${FICHE_NAME:-$1}.md"
}
fiche avec-remote "repo: github.com/acme/avec-remote" "summary: par remote ssh"
fiche par-https   "repo: github.com/acme/renomme"     "summary: par remote https"
fiche sans-git                                        "summary: par nom de repertoire"
fiche enveloppe   "dir: enveloppe/dedans"             "summary: par dir explicite"
fiche fantome                                         "summary: pas clone ici"
fiche idee        "kind: conception"                  "summary: sans depot du tout"
fiche vault-lui-meme "repo: github.com/acme/levault"  "summary: le vault n'est sous aucune racine"
fiche travail     "repo: github.com/acme/depot-enveloppe" "dir: dedans" \
                  "summary: repo localise le depot, dir affine dedans"
fiche url-ssh     "repo: github.com/acme/par-ssh"     "summary: remote en ssh://"
fiche dir-absent  "repo: github.com/acme/par-ssh" "dir: pas-la" \
                  "summary: dir declare mais absent du depot"
fiche dir-piege   "repo: github.com/acme/par-ssh" "dir: sans-git" \
                  "summary: dir: absent du depot mais present sous une racine"
# Sans clef summary : la 5e colonne doit retomber sur "-", pas disparaitre.
fiche sans-summary "repo: github.com/acme/avec-remote"

CONF="$TMP/vaults"
{ echo "# commentaire ignore"
  echo ""
  echo "vault espace $VAULT"
  echo "root  espace $ROOT"
} > "$CONF"
export AIKIT_VAULTS="$CONF"

# --- assertions -------------------------------------------------------------
echo "vaults_list"
is "un seul vault, chemin avec espace intact" \
   "espace	$VAULT" "$(vaults_list)"

# Un nom declare DEUX FOIS : la boucle du hook prend vpath de vaults_list, mais
# resolve_projects re-resout par nom (vault_path -> head -1). Sans deduplication
# le rendu portait deux sections identiques, la seconde etiquetee du chemin B
# alors que ses lignes viennent de A -- une affirmation non verifiee, exactement
# ce que ce chantier existe pour interdire. Premiere ligne declaree gagne, comme
# pour vault_path, et a la difference des racines qui s'accumulent.
CONF_DBL="$TMP/vaults-double"
{ echo "vault essai $TMP/A"; echo "vault essai $TMP/B"; echo "vault autre $TMP/C"
  echo "root  essai $TMP/RA"; echo "root  essai $TMP/RB"; } > "$CONF_DBL"
is "un nom declare deux fois ne sort qu'une fois, premiere ligne gagnante" \
   "essai	$TMP/A
autre	$TMP/C" "$(AIKIT_VAULTS="$CONF_DBL" vaults_list)"
is "vaults_list et vault_path s'accordent sur le doublon" \
   "$TMP/A" "$(AIKIT_VAULTS="$CONF_DBL" vault_path essai)"
is "les racines, elles, s'accumulent toujours" \
   "$TMP/RA
$TMP/RB" "$(AIKIT_VAULTS="$CONF_DBL" vault_roots essai)"

echo "vault_roots"
is "la racine declaree" "$ROOT" "$(vault_roots espace)"

echo "_normalize_remote"
is "ssh:// avec git@"      "github.com/acme/repo" \
   "$(_normalize_remote 'ssh://git@github.com/acme/repo.git')"
is "ssh:// avec port"      "gitlab.example.com/acme/repo" \
   "$(_normalize_remote 'ssh://git@gitlab.example.com:2222/acme/repo.git')"
is "https avec user@"      "bitbucket.org/acme/repo" \
   "$(_normalize_remote 'https://user@bitbucket.org/acme/repo.git')"

echo "vaults_scan"
is "apparie ssh, ssh:// et https sur la meme forme normalisee" \
   "github.com/acme/avec-remote	$ROOT/avec-remote
github.com/acme/depot-enveloppe	$ROOT/depot-enveloppe
github.com/acme/par-ssh	$ROOT/par-ssh
github.com/acme/renomme	$ROOT/autre-nom" \
   "$(vaults_scan "$ROOT" | sort)"
is "une racine symlink est scannee comme une vraie" \
   "github.com/acme/avec-remote	$LINK/avec-remote
github.com/acme/depot-enveloppe	$LINK/depot-enveloppe
github.com/acme/par-ssh	$LINK/par-ssh
github.com/acme/renomme	$LINK/autre-nom" \
   "$(vaults_scan "$LINK" | sort)"

echo "resolve_projects"
r() { resolve_projects espace | awk -F'\t' -v n="$1" '$1==n {print $2"|"$3"|"$4}'; }
is "par remote ssh"            "depot|present|$ROOT/avec-remote"     "$(r avec-remote)"
is "par remote https"          "depot|present|$ROOT/autre-nom"       "$(r par-https)"
is "par remote ssh://"         "depot|present|$ROOT/par-ssh"         "$(r url-ssh)"
is "par nom de repertoire"     "depot|present|$ROOT/sans-git"        "$(r sans-git)"
is "dir: explicite"            "depot|present|$ROOT/enveloppe/dedans" "$(r enveloppe)"
is "repo: puis dir: affine dedans" \
   "depot|present|$ROOT/depot-enveloppe/dedans"                      "$(r travail)"
is "dir: declare mais absent du depot -> absent" \
   "depot|absent|-"                                                  "$(r dir-absent)"
is "et aucun repli sur les racines de recherche" \
   "depot|absent|-"                                                  "$(r dir-piege)"
is "non clone ici -> absent"   "depot|absent|-"                      "$(r fantome)"
is "kind: conception"          "conception|absent|-"                 "$(r idee)"
is "la fiche du vault lui-meme resout present a vpath, hors scan/probe" \
   "depot|present|$VAULT"                                             "$(r vault-lui-meme)"

# Les colonnes 5 et 6 sont lues par les consommateurs (read -r n kind state path
# summary part_of). Sans ces assertions, les retirer du printf ne casse rien.
# part_of est la DERNIERE colonne : `-` quand il est absent, sinon un champ vide
# serait absorbe par `IFS=$'\t' read` et decalerait tout ce qui suit.
row() { resolve_projects espace | awk -F'\t' -v n="$1" '$1==n {print NF"|"$5"|"$6}'; }
is "six colonnes, summary et part_of comprises" "6|par remote ssh|-" "$(row avec-remote)"
is "une fiche sans summary NI part_of : deux fois -" "6|-|-" "$(row sans-summary)"

# --- ecosystemes : part_of, project_warnings, render_project_rows ---------------
# Un vault A LUI (EVAULT) : ajouter des fiches a $VAULT changerait ce que voient
# les tests du hook plus bas. Les noms de fichier different parfois du name: de la
# fiche, expres : l'ordre de resolution (fichiers) n'est pas l'ordre alphabetique
# des membres (noms), et le rendu doit trier les seconds.
EVAULT="$TMP/eco/vault"; EROOT="$TMP/eco/code"
mkdir -p "$EVAULT/projects" "$EROOT/solo" "$EROOT/membre-b"
efiche() {  # efiche <fichier sans .md> <name> <lignes de frontmatter...>
  local f="$1" n="$2"; shift 2
  { echo "---"; echo "name: $n"; printf '%s\n' "$@"; echo "---"; } > "$EVAULT/projects/$f.md"
}
efiche a-membre-b  membre-b   "part_of: b-suite" "summary: membre b"
efiche a-solo      solo       "summary: solo"
efiche b-suite     b-suite    "kind: ecosysteme" "summary: suite avec membres"
efiche c-vide      c-vide     "kind: ecosysteme" "summary: suite sans membre"
efiche d-idee      d-idee     "kind: conception" "summary: idee sans dossier"
efiche e-orphelin  e-orphelin "part_of: inexistant" "summary: membre orphelin"
efiche f-pas-eco   f-pas-eco  "part_of: solo" "summary: cible qui n'est pas un ecosysteme"
efiche g-faute     g-faute    "kind: ecosystem" "summary: kind mal ecrit"
efiche h-pipe      h-pipe     "summary: a | b"
efiche z-membre-a  membre-a   "part_of: b-suite" "summary: membre a"
ECONF="$TMP/vaults-eco"
{ echo "vault eco $EVAULT"; echo "root  eco $EROOT"; } > "$ECONF"

# Un vault dont la fiche porte des espaces et un CR de fin (disque Windows).
SALE="$TMP/sale"; mkdir -p "$SALE/projects"
printf '%s\n' "---" "name: sale" $'kind: depot \r' $'part_of: b-suite  \r' $'summary: resume \r' "---" \
  > "$SALE/projects/sale.md"
printf 'vault sale %s\n' "$SALE" > "$TMP/vaults-sale"

echo "resolve_projects : part_of"
er() { AIKIT_VAULTS="$ECONF" resolve_projects eco | awk -F'\t' -v n="$1" '$1==n {print $2"|"$3"|"$6}'; }
is "part_of present : derniere colonne"          "depot|present|b-suite"   "$(er membre-b)"
is "part_of absent : -"                          "depot|present|-"         "$(er solo)"
is "un ecosysteme : kind lu, part_of -"          "ecosysteme|absent|-"     "$(er b-suite)"
is "une valeur de kind fausse est rendue telle quelle" "ecosystem|absent|-" "$(er g-faute)"
is "colonnes 1 a 5 inchangees pour un membre" \
   "membre-b	depot	present	$EROOT/membre-b	membre b" \
   "$(AIKIT_VAULTS="$ECONF" resolve_projects eco | awk -F'\t' '$1=="membre-b" {print $1"\t"$2"\t"$3"\t"$4"\t"$5}')"
is "espaces et CR de fin retires de kind, part_of, summary" \
   "depot|resume|b-suite" \
   "$(AIKIT_VAULTS="$TMP/vaults-sale" resolve_projects sale | awk -F'\t' '{print $2"|"$5"|"$6}')"

echo "project_warnings"
T=$'\t'
is "un depot implicite, un part_of valide, un ecosysteme sans membre : aucune anomalie" "" \
   "$(printf '%s\n' "d${T}depot${T}present${T}/p${T}s${T}-" \
                    "e${T}ecosysteme${T}absent${T}-${T}s${T}-" \
                    "m${T}depot${T}present${T}/p${T}s${T}e" \
                    "v${T}ecosysteme${T}absent${T}-${T}s${T}-" | project_warnings)"
is "kind inconnu" "x	⚠ kind « ecosystem » inconnu" \
   "$(printf '%s\n' "x${T}ecosystem${T}absent${T}-${T}s${T}-" | project_warnings)"
is "part_of sans fiche" "x	⚠ part_of « inexistant » : aucune fiche" \
   "$(printf '%s\n' "x${T}depot${T}absent${T}-${T}s${T}inexistant" | project_warnings)"
is "part_of vers une fiche qui n'est pas un ecosysteme" "x	⚠ part_of « d » : n'est pas un écosystème" \
   "$(printf '%s\n' "d${T}depot${T}present${T}/p${T}s${T}-" "x${T}depot${T}absent${T}-${T}s${T}d" | project_warnings)"
is "deux anomalies sur une fiche : deux lignes, dans l'ordre" \
   "x	⚠ kind « k » inconnu
x	⚠ part_of « z » : aucune fiche" \
   "$(printf '%s\n' "x${T}k${T}absent${T}-${T}s${T}z" | project_warnings)"
is "valeur assainie : | / et * _ \` ne cassent ni le tableau ni l'emphase" \
   "x	⚠ part_of « a/b'c'd'e » : aucune fiche" \
   "$(printf '%s\n' "x${T}depot${T}absent${T}-${T}s${T}"'a|b*c_d`e' | project_warnings)"
is "vault de fixtures : exactement les trois anomalies attendues, dans l'ordre de resolution" \
   "e-orphelin	⚠ part_of « inexistant » : aucune fiche
f-pas-eco	⚠ part_of « solo » : n'est pas un écosystème
g-faute	⚠ kind « ecosystem » inconnu" \
   "$(AIKIT_VAULTS="$ECONF" resolve_projects eco | project_warnings)"
is "stdin vide : rien" "" "$(printf '' | project_warnings)"

echo "render_project_rows"
eco_rows="$(AIKIT_VAULTS="$ECONF" resolve_projects eco)"
eco_warns="$(printf '%s\n' "$eco_rows" | project_warnings)"
eco_out="$(printf '%s\n' "$eco_rows" | render_project_rows "$eco_warns")"
is "regroupement, ordre de resolution, membres tries par nom, avertissements, suffixes" \
"| solo | oui | solo |
| b-suite *(écosystème)* | — | suite avec membres |
| ↳ membre-a | **absent d'ici** | membre a |
| ↳ membre-b | oui | membre b |
| c-vide *(écosystème)* | — | suite sans membre |
| d-idee *(conception)* | — | idee sans dossier |
| e-orphelin ⚠ part_of « inexistant » : aucune fiche | **absent d'ici** | membre orphelin |
| f-pas-eco ⚠ part_of « solo » : n'est pas un écosystème | **absent d'ici** | cible qui n'est pas un ecosysteme |
| g-faute ⚠ kind « ecosystem » inconnu | **absent d'ici** | kind mal ecrit |
| h-pipe | **absent d'ici** | a / b |" "$eco_out"
is "absent d'ici ne s'applique ni a une conception ni a un ecosysteme" "" \
   "$(printf '%s\n' "$eco_out" | grep -F "absent d'ici" | grep -F -e '(conception)' -e '(écosystème)' || true)"
is "stdin vide : aucune ligne" "" "$(printf '' | render_project_rows "")"
is "un | dans le summary devient / (la table reste a trois cellules)" \
   "| x | oui | a / b |" \
   "$(printf '%s\n' "x${T}depot${T}present${T}/p${T}a | b${T}-" | render_project_rows "")"
is "un \\ dans un avertissement traverse ENVIRON intact" \
   '| x ⚠ part_of « a\nb » : aucune fiche | oui | s |' \
   "$(w=$(printf '%s\n' "x${T}depot${T}present${T}/p${T}s${T}"'a\nb' | project_warnings)
      printf '%s\n' "x${T}depot${T}present${T}/p${T}s${T}"'a\nb' | render_project_rows "$w")"
is "un ecosysteme qui est membre d'un autre ne fait perdre aucune ligne" \
   "| top *(écosystème)* | — | s |
| ↳ mid *(écosystème)* | — | s |
| leaf | oui | s |" \
   "$(printf '%s\n' "top${T}ecosysteme${T}absent${T}-${T}s${T}-" \
                    "mid${T}ecosysteme${T}absent${T}-${T}s${T}top" \
                    "leaf${T}depot${T}present${T}/p${T}s${T}mid" | render_project_rows "")"

echo "vault_behind_commits"
# Un vrai depot "remote" local (pas de reseau : un chemin de fichier suffit
# comme remote git) et trois clones qui en divergent chacun a sa maniere.
SYNC_REMOTE="$TMP/sync-remote"
mkdir -p "$SYNC_REMOTE"; git -C "$SYNC_REMOTE" init -q -b main
git -C "$SYNC_REMOTE" commit -q --allow-empty -m "un"

# Clone AVANT les deux commits suivants : restera en retard de 2.
SYNC_RETARD="$TMP/sync-en-retard"
git clone -q "$SYNC_REMOTE" "$SYNC_RETARD"

git -C "$SYNC_REMOTE" commit -q --allow-empty -m "deux"
git -C "$SYNC_REMOTE" commit -q --allow-empty -m "trois"

# Clone APRES : a jour des la naissance.
SYNC_AJOUR="$TMP/sync-a-jour"
git clone -q "$SYNC_REMOTE" "$SYNC_AJOUR"

# Un depot solo, jamais clone : pas de branche amont configuree.
SYNC_SANSAMONT="$TMP/sync-sans-amont"
mkdir -p "$SYNC_SANSAMONT"; git -C "$SYNC_SANSAMONT" init -q -b main
git -C "$SYNC_SANSAMONT" commit -q --allow-empty -m "solo"

# Un clone dont le remote a ete casse apres coup : l'amont existe (le clone
# a reussi), mais toute tentative de fetch echoue.
SYNC_ECHEC="$TMP/sync-echec"
git clone -q "$SYNC_REMOTE" "$SYNC_ECHEC"
git -C "$SYNC_ECHEC" remote set-url origin "$TMP/n-existe-pas"

is "clone a jour -> rien a signaler" "" "$(vault_behind_commits "$SYNC_AJOUR")"
is "clone en retard de deux commits -> 2" "2" "$(vault_behind_commits "$SYNC_RETARD")"
is "pas de branche amont configuree -> silence" "" "$(vault_behind_commits "$SYNC_SANSAMONT")"
is "remote injoignable -> silence, pas d'erreur" "" "$(vault_behind_commits "$SYNC_ECHEC")"
is "chemin qui n'est pas un depot git -> silence" "" "$(vault_behind_commits "$TMP/n-importe-quoi")"
is "aucun argument -> silence" "" "$(vault_behind_commits)"

echo "hook"
# Le hook est un CONSOMMATEUR de lib/vaults : il tourne dans un autre processus,
# en `set -euo pipefail`, et sa sortie est du JSON lu par le harnais. AIKIT_VAULTS
# est ce qui le rend testable ici.
out=$(AIKIT_VAULTS="$CONF" bash hooks/session-start)
printf '%s' "$out" | json_valid \
  && ok "le hook emet du JSON valide" \
  || ko "le hook emet du JSON valide" "JSON" "invalide"
ctx=$(printf '%s' "$out" | json_ctx)
# Le hook n'emet plus le texte de skills/using-aikit/SKILL.md : son stub est en
# dur dans hooks/session-start. `pre` ne figure donc plus dans `ctx` et
# `${ctx#*"$pre"}` rend `ctx` entier ; on garde l'idiome (il redeviendrait utile
# si le hook reinjectait le skill). Les assertions ci-dessous portent sur des
# lignes de table entieres, jamais sur un mot que le stub pourrait aussi porter.
pre=$(cat skills/using-aikit/SKILL.md)
reg="${ctx#*"$pre"}"
case "$reg" in
  *"## Vault: espace"*) ok "la table est etiquetee par vault" ;;
  *) ko "la table est etiquetee par vault" "## Vault: espace" "absent" ;;
esac
# La LIGNE ENTIERE, pas `| fantome |` suivi d'un `absent` flottant : le bloc se
# termine toujours par « A project marked **absent d'ici** is registered but not
# cloned… », donc le mot est garanti APRES n'importe quelle ligne de table. Un
# motif non ancre etait satisfait par ce boilerplate et restait vert meme avec
# un `here="oui"` inconditionnel -- c'est-a-dire en ne testant rien.
ligne() { printf '%s\n' "$reg" | grep -F "| $1 |" | head -1; }
is "un projet non clone est marque absent d'ici" \
   "| fantome | **absent d'ici** | pas clone ici |" "$(ligne fantome)"
is "un projet clone est marque present" \
   "| avec-remote | oui | par remote ssh |" "$(ligne avec-remote)"
printf '%s' "$reg" | grep -qi workspace \
  && ko "le mot workspace a disparu de la table injectee" "" "workspace present" \
  || ok "le mot workspace a disparu de la table injectee"
grep -qi workspace hooks/session-start \
  && ko "le mot workspace a disparu du hook" "" "workspace present" \
  || ok "le mot workspace a disparu du hook"

echo "hook : vault en retard sur son remote"
CONF_RETARD="$TMP/vaults-retard"
printf 'vault retard %s\n' "$SYNC_RETARD" > "$CONF_RETARD"
reg_retard=$(AIKIT_VAULTS="$CONF_RETARD" bash hooks/session-start | json_ctx)
case "$reg_retard" in
  *"retard"*"2 commit"*"git pull"*) ok "le hook signale un vault en retard" ;;
  *) ko "le hook signale un vault en retard" \
        "retard ... 2 commit(s) ... git pull" "${reg_retard:-vide}" ;;
esac

CONF_AJOUR="$TMP/vaults-ajour"
printf 'vault ajour %s\n' "$SYNC_AJOUR" > "$CONF_AJOUR"
reg_ajour=$(AIKIT_VAULTS="$CONF_AJOUR" bash hooks/session-start | json_ctx)
case "$reg_ajour" in
  *"en retard sur leur remote"*) \
    ko "un vault a jour ne declenche aucun message" \
       "pas de section retard" "section presente" ;;
  *) ok "un vault a jour ne declenche aucun message" ;;
esac

# Le fixture historique $VAULT n'a jamais de commit ni de branche amont
# configuree (voir sa creation plus haut) : verrouille qu'il ne declenche
# jamais de vrai `git fetch` reseau, conformement a "aucune dependance
# reseau" en tete de ce fichier.
is "le fixture \$VAULT existant reste sans amont (aucun fetch reseau)" \
   "" "$(vault_behind_commits "$VAULT")"

echo "hook : vaults declares mais sans fiche"
# Un vault declare qui ne rend aucune fiche ne doit JAMAIS se taire : la methode
# se chargerait sans routeur et sans explication. Trois cas qui ne doivent pas
# se lire pareil -- aucun vault declare / declares mais aucun ne porte de fiche /
# certains resolvent et d'autres non.
hookreg() {  # hookreg <fichier de vaults> -> le bloc que le hook ajoute
  local out ctx
  out=$(AIKIT_VAULTS="$1" bash hooks/session-start) || return 1
  ctx=$(printf '%s' "$out" | json_ctx) || return 1
  printf '%s' "${ctx#*"$pre"}"
}

# projects/ ABSENT : le repertoire du vault existe, mais rien dedans.
ORPHELIN="$TMP/orphelin"; mkdir -p "$ORPHELIN"
printf 'vault orphelin %s\n' "$ORPHELIN" > "$TMP/vaults-orphelin"
# projects/ PRESENT mais VIDE : ce n'est pas la meme panne, ni le meme remede.
VIDE="$TMP/videvault"; mkdir -p "$VIDE/projects"
printf 'vault vide %s\n' "$VIDE" > "$TMP/vaults-vide"
# Un vault qui resout ET un qui ne resout pas : les deux doivent apparaitre.
{ echo "vault espace $VAULT"; echo "root  espace $ROOT"
  echo "vault orphelin $ORPHELIN"; } > "$TMP/vaults-mixte"

# Etat 1 : aucun vault declare. C'est l'etat de la PREMIERE INSTALLATION, et il
# n'avait aucune assertion : une regression qui viderait cette branche serait
# sortie verte partout.
reg_aucun=$(hookreg /nonexistent-vaults-file)
case "$reg_aucun" in
  *"## No vault registered on this machine"*) ok "aucun vault declare : la note existe" ;;
  *) ko "aucun vault declare : la note existe" \
        "## No vault registered on this machine" "${reg_aucun:-vide}" ;;
esac
case "$reg_aucun" in
  *"## No project registry found"*) ko "aucun-vault ne se lit pas comme declare-mais-introuvable" \
        "pas d'en-tete 'No project registry found'" "les deux notes confondues" ;;
  *) ok "aucun-vault ne se lit pas comme declare-mais-introuvable" ;;
esac

reg_orphelin=$(hookreg "$TMP/vaults-orphelin")
case "$reg_orphelin" in
  *"orphelin"*"${ORPHELIN}/projects"*) ok "un vault sans fiche est nomme, avec l'endroit cherche" ;;
  *) ko "un vault sans fiche est nomme, avec l'endroit cherche" \
        "orphelin + ${ORPHELIN}/projects" "${reg_orphelin:-vide}" ;;
esac
case "$reg_orphelin" in
  *"No vault registered"*) ko "declare-mais-introuvable ne se lit pas comme aucun-vault" \
                              "en-tete distinct" "la note 'No vault registered'" ;;
  *"## No project registry found"*) ok "declare-mais-introuvable ne se lit pas comme aucun-vault" ;;
  *) ko "declare-mais-introuvable ne se lit pas comme aucun-vault" \
        "## No project registry found" "absent" ;;
esac

reg_vide=$(hookreg "$TMP/vaults-vide")
case "$reg_vide" in
  *"${VIDE}/projects"*"does not exist"*) \
    ko "projects/ vide : la raison differe de projects/ absent" \
       "ne pas affirmer l'inexistence" "\"does not exist\" sur un repertoire present" ;;
  *"vide"*"${VIDE}/projects"*) ok "projects/ vide : la raison differe de projects/ absent" ;;
  *) ko "projects/ vide : la raison differe de projects/ absent" \
        "vide + ${VIDE}/projects" "${reg_vide:-vide}" ;;
esac

# Minor 5 : `projects` existe, mais c'est un FICHIER. Annoncer « does not exist »
# serait le meme petit mensonge que celui entre absent et vide.
FICHIER="$TMP/fichiervault"; mkdir -p "$FICHIER"; : > "$FICHIER/projects"
printf 'vault fichier %s\n' "$FICHIER" > "$TMP/vaults-fichier"
reg_fichier=$(hookreg "$TMP/vaults-fichier")
case "$reg_fichier" in
  *"does not exist"*) ko "projects/ present mais fichier : ne pas dire qu'il n'existe pas" \
        "une raison qui ne ment pas" "does not exist" ;;
  *"fichier"*"${FICHIER}/projects"*) ok "projects/ present mais fichier : ne pas dire qu'il n'existe pas" ;;
  *) ko "projects/ present mais fichier : ne pas dire qu'il n'existe pas" \
        "fichier + ${FICHIER}/projects" "${reg_fichier:-vide}" ;;
esac

reg_mixte=$(hookreg "$TMP/vaults-mixte")
case "$reg_mixte" in
  # La phrase de remede fait partie de la note : apprendre qu'un vault est casse
  # sans apprendre quoi en faire est une moitie d'information, et rien ne la
  # regardait -- une regression qui la reamputerait serait sortie verte.
  *"## Vault: espace"*"| fantome |"*"orphelin"*"These route nowhere"*) \
    ok "un vault qui resout et un qui ne resout pas : les deux sortent, avec le remede" ;;
  *) ko "un vault qui resout et un qui ne resout pas : les deux sortent, avec le remede" \
        "la table de espace + orphelin + la phrase de remede" "${reg_mixte:-vide}" ;;
esac

echo "hook : ecosystemes"
# Le tableau injecte est groupe, la consigne dit quoi faire d'un membre et ce que
# vaut `absent d'ici`, et le contexte reste sous le plafond de additionalContext
# (10 000 caracteres) : au-dela le tableau est perdu, il ne reste qu'un apercu.
reg_eco=$(hookreg "$ECONF")
is "le hook groupe l'ecosysteme et ses membres, dans l'ordre" \
"| b-suite *(écosystème)* | — | suite avec membres |
| ↳ membre-a | **absent d'ici** | membre a |
| ↳ membre-b | oui | membre b |" \
   "$(printf '%s\n' "$reg_eco" | grep -F -A2 '| b-suite *(écosystème)* |')"
is "un part_of sans cible porte son avertissement dans le tableau injecte" \
   "| e-orphelin ⚠ part_of « inexistant » : aucune fiche | **absent d'ici** | membre orphelin |" \
   "$(printf '%s\n' "$reg_eco" | grep -F '| e-orphelin ')"
is "une conception sans dossier affiche — et non absent d'ici" \
   "| d-idee *(conception)* | — | idee sans dossier |" \
   "$(printf '%s\n' "$reg_eco" | grep -F '| d-idee ')"
case "$reg_eco" in
  *'is a `depot` registered but not cloned'*) ok "la consigne : absent d'ici ne vaut que pour un depot" ;;
  *) ko "la consigne : absent d'ici ne vaut que pour un depot" \
        'is a `depot` registered but not cloned' "${reg_eco:-vide}" ;;
esac
case "$reg_eco" in
  *"read the registry file of its ecosystem too"*) ok "la consigne : un membre mene a la fiche de son ecosysteme" ;;
  *) ko "la consigne : un membre mene a la fiche de son ecosysteme" \
        "read the registry file of its ecosystem too" "${reg_eco:-vide}" ;;
esac
out_eco=$(AIKIT_VAULTS="$ECONF" bash hooks/session-start)
printf '%s' "$out_eco" | json_valid \
  && ok "le hook emet du JSON valide avec ⚠ ↳ — é dans le tableau" \
  || ko "le hook emet du JSON valide avec ⚠ ↳ — é dans le tableau" "JSON" "invalide"
ctx_eco=$(printf '%s' "$out_eco" | json_ctx)
[ "${#ctx_eco}" -lt 10000 ] \
  && ok "le contexte injecte (${#ctx_eco} car.) reste sous le plafond de 10 000" \
  || ko "le contexte injecte reste sous le plafond de 10 000" "< 10000" "${#ctx_eco}"
[ "${#ctx}" -lt 10000 ] \
  && ok "idem sur le vault historique (${#ctx} car.)" \
  || ko "idem sur le vault historique" "< 10000" "${#ctx}"

echo "hook : donnee de registre hostile"
# Un `summary:` est ecrit a la MAIN dans une fiche. Qu'il porte un caractere de
# controle nu (0x01 ici) n'a rien d'exotique -- un copier-coller suffit. Non
# filtre, il sortait tel quel dans la chaine JSON du hook : JSON invalide, donc
# porte 4 rouge et preambule PERDU a chaque demarrage de session. Le vault est a
# lui seul : une fiche de plus sous $VAULT changerait ce que les autres voient.
HOSTILE="$TMP/hostile"; mkdir -p "$HOSTILE/projects"
printf '%s\n' "---" "name: controle" "kind: conception" \
  "summary: un resume "$'\001'"hostile" "---" > "$HOSTILE/projects/controle.md"
# Le CR est l'inverse du precedent : il doit SURVIVRE au filtre, echappe en \r
# juste apres. Tabulation, LF et CR sont exclus du filtre expres ; les y ajouter
# casserait la mise en forme du preambule injecte a chaque session, et cette
# fiche est ce qui rendrait ce durcissement-la rouge.
printf '%s\n' "---" "name: retour" "kind: conception" \
  "summary: avant"$'\r'"apres" "---" > "$HOSTILE/projects/retour.md"
printf 'vault hostile %s\n' "$HOSTILE" > "$TMP/vaults-hostile"
out_hostile=$(AIKIT_VAULTS="$TMP/vaults-hostile" bash hooks/session-start)
printf '%s' "$out_hostile" | json_valid \
  && ok "un caractere de controle dans un summary : le JSON reste valide" \
  || ko "un caractere de controle dans un summary : le JSON reste valide" \
        "JSON valide" "invalide"
reg_hostile=$(hookreg "$TMP/vaults-hostile")
# Filtrer n'est pas avaler : le reste de la ligne doit arriver intact.
case "$reg_hostile" in
  *"| controle "*"un resume hostile"*) ok "le reste du summary survit au filtre" ;;
  *) ko "le reste du summary survit au filtre" \
        "| controle ... | un resume hostile |" "${reg_hostile:-vide}" ;;
esac
case "$reg_hostile" in
  *"avant"$'\r'"apres"*) ok "un CR dans un summary est echappe, pas supprime" ;;
  *) ko "un CR dans un summary est echappe, pas supprime" \
        "avant<CR>apres" "${reg_hostile:-vide}" ;;
esac

# La sentinelle de `escape_for_json` n'etait gardee que par son commentaire :
# aucune donnee de fiche n'atteint jamais la QUEUE de la chaine echappee (les
# trois branches de `registry` finissent sur un litteral du hook), donc aucune
# fiche ne peut l'exercer. On mute une COPIE du hook, dans une ferme de liens,
# pour forcer un preambule finissant par une ligne vide -- et on regarde si elle
# survit. Boite noire : l'ancre d'injection est `body=$(escape_for_json`, stable,
# et le libelle de la sentinelle n'est pas epingle. Qui la retire voit ceci rouge.
FERME="$TMP/ferme"; mkdir -p "$FERME/hooks"
ln -s "$PWD/lib" "$FERME/lib"; ln -s "$PWD/skills" "$FERME/skills"
# ENVIRON, pas -v : awk interprete les echappements d'une affectation -v, et
# `\n` y deviendrait un vrai saut de ligne -- l'injection se couperait en deux.
q=$'registry+=$\'\\n\\n\'' \
  awk '/^body=\$\(escape_for_json/ && !injecte { print ENVIRON["q"]; injecte = 1 } { print }' \
  hooks/session-start > "$FERME/hooks/session-start"
# Combien de sauts de ligne survivent juste avant la balise fermante : 3 avec la
# sentinelle (les deux injectes + celui du gabarit), 1 sans elle.
ctx_ferme=$(AIKIT_VAULTS="$CONF" bash "$FERME/hooks/session-start" | json_ctx)
queue=$(trailing_newlines_before "$ctx_ferme" '</EXTREMELY_IMPORTANT>')
is "la sentinelle preserve les sauts de ligne terminaux" "3" "$queue"

echo "bin/ezy"
# Fixtures PROPRES aux lanceurs : un vault et une racine a eux. Ajouter un
# depot sous $ROOT casserait les listes exactes de vaults_scan, et une fiche de
# plus sous $VAULT changerait ce que les lanceurs voient sans qu'on le veuille.
LVAULT="$TMP/lanceurs/vault"; LROOT="$TMP/lanceurs/code"
mkdir -p "$LVAULT/projects" "$LROOT"
lrepo() {  # lrepo <dir> <remote-url>
  mkdir -p "$LROOT/$1" && git -C "$LROOT/$1" init -q
  git -C "$LROOT/$1" remote add origin "$2"
}
lrepo porte-agents "git@github.com:acme/porte-agents.git"
lrepo porte-skills "git@github.com:acme/porte-skills.git"
lrepo muet         "git@github.com:acme/muet.git"
mkdir -p "$LROOT/porte-agents/.claude/agents" "$LROOT/porte-skills/.claude/skills"
lfiche() {  # lfiche <nom> <lignes de frontmatter...>
  local n="$1"; shift
  { echo "---"; echo "name: $n"; printf '%s\n' "$@"; echo "---"; } \
    > "$LVAULT/projects/${n}.md"
}
lfiche fantome      "summary: au registre, pas clone ici"
lfiche muet         "repo: github.com/acme/muet"         "summary: ni agents ni skills"
lfiche porte-agents "repo: github.com/acme/porte-agents" "summary: porte des agents"
lfiche porte-skills "repo: github.com/acme/porte-skills" "summary: porte des skills"
LCONF="$TMP/vaults-lanceurs"
{ echo "vault lanceurs $LVAULT"; echo "root  lanceurs $LROOT"; } > "$LCONF"

# Un vault declare dont le chemin ne resout pas : lib/vaults rend le vide EN
# SILENCE, c'est au lanceur de le dire.
LCONF_BIDON="$TMP/vaults-bidon"
printf 'vault bidon %s\n' "$TMP/pas-de-vault-ici" > "$LCONF_BIDON"

has()   { case "$3" in *"$2"*) ok "$1" ;; *) ko "$1" "contient [$2]" "${3:-vide}" ;; esac; }
hasnt() { case "$3" in *"$2"*) ko "$1" "ne contient PAS [$2]" "$3" ;; *) ok "$1" ;; esac; }
lance()    { local c="$1"; shift; AIKIT_VAULTS="$c" bash "$@" 2>/dev/null; }
lanceerr() { local c="$1"; shift; AIKIT_VAULTS="$c" bash "$@" 2>&1 >/dev/null; }

is "seuls les projets presents ET porteurs sortent, dans l'ordre des fiches" \
   "claude --add-dir $LROOT/porte-agents --add-dir $LROOT/porte-skills" \
   "$(lance "$LCONF" bin/ezy --dry-run)"
# Le cd a disparu : il n'y a plus de racine ou se placer. Sans cette assertion,
# le reintroduire ne casserait rien.
hasnt "la commande imprimee ne porte plus aucun cd" \
   "cd " "$(lance "$LCONF" bin/ezy --dry-run)"
has "le repertoire d'execution est dit, sur stderr" \
   "runs from" "$(lanceerr "$LCONF" bin/ezy --dry-run)"

# Quatre echecs qui tombaient tous dans « no project exposes agents or skills »,
# dont la faute de frappe -- le cas le plus frequent. Chacun doit nommer SA
# cause, sinon le lecteur part fouiller des repertoires .claude/ pour un 'l'
# en trop.
has "--only sur une faute de frappe parle de frappe" \
   "no project named 'porte-agentss'" \
   "$(lanceerr "$LCONF" bin/ezy --only porte-agentss --dry-run)"
has "--only sur un projet non clone le dit" \
   "not cloned on this machine" \
   "$(lanceerr "$LCONF" bin/ezy --only fantome --dry-run)"
has "--only sur un projet sans agents ni skills le dit" \
   "neither .claude/agents nor .claude/skills" \
   "$(lanceerr "$LCONF" bin/ezy --only muet --dry-run)"
has "--only sur un projet non clone ne parle PAS de .claude" \
   "registered in vault 'lanceurs'" \
   "$(lanceerr "$LCONF" bin/ezy --only fantome --dry-run)"
hasnt "... et ne mentionne pas .claude/agents" \
   ".claude/agents" "$(lanceerr "$LCONF" bin/ezy --only fantome --dry-run)"
has "--vault inconnu nomme le fichier de vaults" \
   "no vault named 'nope'" "$(lanceerr "$LCONF" bin/ezy --vault nope --dry-run)"
has "aucun vault declare : la cause est le fichier, pas le projet" \
   "no vault declared in" "$(lanceerr /nonexistent-vaults-file bin/ezy --dry-run)"
has "un vault declare qui ne resout pas est nomme, avec l'endroit cherche" \
   "bidon ($TMP/pas-de-vault-ici/projects)" \
   "$(lanceerr "$LCONF_BIDON" bin/ezy --dry-run)"
has "... et la cause n'est pas imputee aux projets" \
   "no declared vault carries a project registry" \
   "$(lanceerr "$LCONF_BIDON" bin/ezy --dry-run)"

echo "bin/scoped"
# Ces fiches-la ne perturbent pas les assertions de bin/ezy ci-dessus : elles
# pointent toutes sur `muet`, qui ne porte ni agents ni skills, ou sont absentes.
lfiche perim-defaut "repo: github.com/acme/muet" "allow: Bash(git*) Read" \
                    "deny: WebFetch" "summary: perimetre par defaut"
lfiche perim-parent "repo: github.com/acme/muet" "perimeter: .." \
                    "summary: les outils vivent au parent du clone"
lfiche perim-casse  "repo: github.com/acme/muet" "perimeter: pas-la" \
                    "summary: perimetre qui ne resout pas"

is "perimetre par defaut : le clone lui-meme, avec allow/deny de la fiche" \
   "cd $LROOT/muet && claude --allowed-tools Bash\\(git\\*\\) Read --disallowed-tools WebFetch --session-id SID -p bonjour" \
   "$(lance "$LCONF" bin/scoped --dry-run perim-defaut chantier bonjour \
      | sed -E 's/--session-id [0-9a-fA-F-]+/--session-id SID/')"
# T16 fera passer un projet reel a `perimeter: ..` : son .mcp.json est au parent
# de son clone. Sans cette assertion, rien ne tient ce changement de referentiel.
has "perimeter: .. ouvre le parent du clone" \
   "cd $LROOT && claude" \
   "$(lance "$LCONF" bin/scoped --dry-run perim-parent chantier bonjour)"
has "un perimetre qui ne resout pas est nomme" \
   "no such perimeter: $LROOT/muet/pas-la" \
   "$(lanceerr "$LCONF" bin/scoped --dry-run perim-casse chantier bonjour)"
# Un essai a blanc qui ecrirait le marqueur ferait `--resume` sur une session
# jamais creee au prochain appel reel.
lance "$LCONF" bin/scoped --dry-run perim-defaut chantier bonjour > /dev/null
[ -e "$LVAULT/perim-defaut/chantier/.session" ] \
  && ko "un essai a blanc ne laisse aucune trace" "pas de marqueur" "marqueur ecrit" \
  || ok "un essai a blanc ne laisse aucune trace"

# --- un need archive se reprend depuis _archive/ -----------------------------
# Un need fini part sous <projet>/_archive/<need>/. Verifier seulement qu'aucun
# dossier neuf n'apparait passerait meme si scoped ignorait l'archive : on
# verifie la PRESENCE -- la session archivee est reprise, et c'est dit.
mkdir -p "$LVAULT/perim-defaut/_archive/fini"
printf '%s' "sid-archive-0001" > "$LVAULT/perim-defaut/_archive/fini/.session"
has "un need archive reprend la session trouvee sous _archive/" \
   "--resume sid-archive-0001" \
   "$(lance "$LCONF" bin/scoped --dry-run perim-defaut fini bonjour)"
has "... et le signale comme archive, avec son chemin" \
   "'fini' is archived — resuming from $LVAULT/perim-defaut/_archive/fini" \
   "$(lanceerr "$LCONF" bin/scoped --dry-run perim-defaut fini bonjour)"
# Un vrai lancement, claude remplace par un faux : c'est le chemin qui fait
# mkdir -p et ecrit le marqueur, celui que --dry-run ne traverse pas.
FAKEBIN="$TMP/faux-claude"; mkdir -p "$FAKEBIN"
printf '#!/usr/bin/env bash\necho "claude $*"\n' > "$FAKEBIN/claude"; chmod +x "$FAKEBIN/claude"
reel="$(PATH="$FAKEBIN:$PATH" AIKIT_VAULTS="$LCONF" bash bin/scoped perim-defaut fini bonjour 2>/dev/null)"
has "un vrai lancement reprend la session archivee" "--resume sid-archive-0001" "$reel"
[ -e "$LVAULT/perim-defaut/fini" ] \
  && ko "... sans creer de dossier neuf a cote" "pas de perim-defaut/fini" "dossier cree" \
  || ok "... sans creer de dossier neuf a cote"
is "... et sans toucher au marqueur archive" "sid-archive-0001" \
   "$(cat "$LVAULT/perim-defaut/_archive/fini/.session")"
# Le dossier vivant passe avant l'archive : meme ordre que understanding-need.
mkdir -p "$LVAULT/perim-defaut/double" "$LVAULT/perim-defaut/_archive/double"
printf '%s' "sid-vivant-0002"  > "$LVAULT/perim-defaut/double/.session"
printf '%s' "sid-archive-0003" > "$LVAULT/perim-defaut/_archive/double/.session"
has "un need vivant passe avant son homonyme archive" \
   "--resume sid-vivant-0002" \
   "$(lance "$LCONF" bin/scoped --dry-run perim-defaut double bonjour)"
# Le prefixe _ nomme les dossiers du vault lui-meme : un slug qui le porte
# ecrirait un .session dans _archive/ ou _notes/.
has "un slug qui commence par _ est refuse" \
   "starts with '_'" \
   "$(lanceerr "$LCONF" bin/scoped --dry-run perim-defaut _archive bonjour)"

# --- Important 3 : la recherche va jusqu'au bout avant de refuser -------------
# Le meme projet declare dans DEUX vaults, absent du premier et clone dans le
# second. Refuser des le premier `absent` refusait du travail qui existe -- et
# faisait diverger les deux lanceurs sur la meme entree.
LVAULT2="$TMP/lanceurs/vault2"; LROOT2="$TMP/lanceurs/code2"
mkdir -p "$LVAULT2/projects" "$LROOT2/deux-vaults/.claude/agents"
lfiche deux-vaults "summary: absent de ce vault-ci"
{ echo "---"; echo "name: deux-vaults"; echo "summary: clone ici"; echo "---"; } \
  > "$LVAULT2/projects/deux-vaults.md"
LCONF2="$TMP/vaults-deux"
{ echo "vault lanceurs $LVAULT";  echo "root  lanceurs $LROOT"
  echo "vault second   $LVAULT2"; echo "root  second   $LROOT2"; } > "$LCONF2"

has "absent du premier vault, present dans le second : on ouvre le second" \
   "cd $LROOT2/deux-vaults && claude" \
   "$(lance "$LCONF2" bin/scoped --dry-run deux-vaults chantier bonjour)"
is "et les deux lanceurs s'accordent sur cette entree" \
   "claude --add-dir $LROOT2/deux-vaults" \
   "$(lance "$LCONF2" bin/ezy --only deux-vaults --dry-run)"

# --- les quatre causes d'un echec, distinctes --------------------------------
has "au registre mais pas clone : le vault fautif est nomme" \
   "'fantome' is registered in vault 'lanceurs', but not cloned" \
   "$(lanceerr "$LCONF" bin/scoped --dry-run fantome chantier bonjour)"
has "projet inconnu : on ne parle pas de clone" \
   "no project named 'inconnu' in any declared vault" \
   "$(lanceerr "$LCONF" bin/scoped --dry-run inconnu chantier bonjour)"
# Le defaut signale : sans fichier de vaults, scoped envoyait chercher une fiche
# que l'utilisateur a peut-etre sous les yeux.
err_sansconf="$(lanceerr /nonexistent-vaults-file bin/scoped --dry-run porte-agents chantier bonjour)"
has "aucun vault declare : la cause est le fichier de configuration" \
   "no vault declared in" "$err_sansconf"
hasnt "... et surtout pas une fiche manquante" \
   "no project named" "$err_sansconf"
err_bidon="$(lanceerr "$LCONF_BIDON" bin/scoped --dry-run porte-agents chantier bonjour)"
has "un vault declare qui ne resout pas est nomme, avec l'endroit cherche" \
   "bidon ($TMP/pas-de-vault-ici/projects)" "$err_bidon"
hasnt "... et la cause n'est pas imputee au projet" "no project named" "$err_bidon"

echo "squelette d'un projet"
# Le bloc est lu DANS le skill, jamais recopie ici : une copie derive.
SK="$TMP/squelette.sh"
awk '/^# skeleton:/{f=1} f&&/^```/{exit} f' skills/registering-a-project/SKILL.md > "$SK"
has "le skill porte un bloc # skeleton:" "mkdir -p" "$(cat "$SK")"
SV="$TMP/squelette-vault"; mkdir -p "$SV"
p=neuf v="$SV" bash "$SK"
for x in heuristics.md _notes/.gitkeep _archive/.gitkeep; do
  [ -f "$SV/neuf/$x" ] && ok "le squelette cree neuf/$x" || ko "le squelette cree neuf/$x" "present" "absent"
done
is "heuristics.md part avec son en-tete seul" "# neuf — heuristics" "$(cat "$SV/neuf/heuristics.md")"
printf -- '- garde -> moi\n' >> "$SV/neuf/heuristics.md"
p=neuf v="$SV" bash "$SK"
has "rejouer le squelette ne reecrit pas heuristics.md" "- garde -> moi" "$(cat "$SV/neuf/heuristics.md")"

echo "project_of_path"
# Fixtures a part : un vault et une racine a eux, pour ne pas changer le nombre
# de lignes des tables de session testees plus haut.
PPV="$TMP/pp vault"; PPR="$TMP/pp-root"; PPCONF="$TMP/vaults-pp"
mkdir -p "$PPV/projects" "$PPR/a/zzz" "$PPR/a/b/c" "$PPR/ab" "$PPR/a-voisin" "$TMP/hors-registre"
ppfiche() {  # ppfiche <nom> [ligne de frontmatter...]
  local n="$1"; shift
  { echo "---"; echo "name: $n"; [ "$#" -eq 0 ] || printf '%s\n' "$@"; echo "---"; } > "$PPV/projects/$n.md"
}
ppfiche a
ppfiche b    "dir: a/b"
ppfiche ab
ppfiche plan-c "kind: conception" "dir: a/b/c"
ppfiche fantome-pp
{ echo "vault pp $PPV"; echo "root  pp $PPR"; } > "$PPCONF"
ln -s "$PPR/a" "$TMP/lien-a"
pp() { AIKIT_VAULTS="$PPCONF" project_of_path "$1"; }
is "la racine du projet"                   "a"  "$(pp "$PPR/a")"
is "un sous-dossier sans projet propre"    "a"  "$(pp "$PPR/a/zzz")"
is "projets imbriques : le plus long gagne" "b" "$(pp "$PPR/a/b")"
is "... et ses sous-dossiers aussi"        "b"  "$(pp "$PPR/a/b/c")"
is "frontiere de dossier : a-voisin n'est pas dans a" "" "$(pp "$PPR/a-voisin")"
is "frontiere de dossier : ab est son propre projet"  "ab" "$(pp "$PPR/ab")"
is "les liens symboliques sont resolus"    "b"  "$(pp "$TMP/lien-a/b")"
is "le vault lui-meme n'est pas sous une racine : hors registre ici" "" "$(pp "$PPV")"
is "hors registre"                         ""   "$(pp "$TMP/hors-registre")"
is "chemin inexistant"                     ""   "$(pp "$TMP/nexiste-pas")"
is "argument vide"                         ""   "$(pp "")"
is "aucun vault declare"                   ""   "$(AIKIT_VAULTS=/nonexistent-vaults-file project_of_path "$PPR/a")"
is "chemin avec espace (vault de la suite principale)" "vault-lui-meme" "$(project_of_path "$VAULT")"

echo "bin/aikit-statusline"
REPO="$PWD"
SLCACHE="$TMP/sl-cache"; SLHOME="$TMP/sl-home"; mkdir -p "$SLHOME"
git -C "$ROOT/avec-remote" symbolic-ref HEAD refs/heads/trunk
mkdir -p "$ROOT/sans-git/dedans" "$TMP/hors-registre"
ESC="$(printf '\033')"
plain() { sed "s/${ESC}\[[0-9;]*m//g"; }
# sl <json> [vaults-file] : le rendu brut, sur un HOME et un cache jetables.
sl() { printf '%s' "$1" | HOME="$SLHOME" XDG_CACHE_HOME="$SLCACHE" AIKIT_VAULTS="${2:-$CONF}" bash "$REPO/bin/aikit-statusline"; }
slin() {  # slin <dir> <session> <pct-json|null>
  jq -nc --arg d "$1" --arg s "$2" --argjson p "$3" \
    '{model:{display_name:"Opus"},workspace:{current_dir:$d},session_id:$s,context_window:{used_percentage:$p}}'
}
if command -v jq > /dev/null 2>&1; then
  out="$(sl "$(slin "$ROOT/avec-remote" s30 30)")"; rc=$?
  is "30 % : la ligne complete" "aikit · Opus · avec-remote (trunk) · ctx 30 %" "$(printf '%s' "$out" | plain)"
  is "30 % : code de sortie 0"  "0" "$rc"
  is "30 % : une seule ligne"   "1" "$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
  has "30 % : vert"   "${ESC}[32mctx 30 %" "$out"
  has "70 % : jaune"  "${ESC}[33mctx 70 %" "$(sl "$(slin "$ROOT/avec-remote" s70 70)")"
  has "85 % : jaune (borne haute)" "${ESC}[33mctx 85 %" "$(sl "$(slin "$ROOT/avec-remote" s85 85)")"
  has "86 % : rouge"  "${ESC}[31mctx 86 %" "$(sl "$(slin "$ROOT/avec-remote" s86 86)")"
  has "90 % : rouge"  "${ESC}[31mctx 90 %" "$(sl "$(slin "$ROOT/avec-remote" s90 90)")"
  has "59,6 % : arrondi a 60, jaune" "${ESC}[33mctx 60 %" "$(sl "$(slin "$ROOT/avec-remote" s596 59.6)")"
  out="$(sl "$(slin "$ROOT/avec-remote" snull null)")"; rc=$?
  is "contexte null : tiret" "aikit · Opus · avec-remote (trunk) · ctx –" "$(printf '%s' "$out" | plain)"
  is "contexte null : code de sortie 0" "0" "$rc"
  is "dossier hors git : pas de parentheses" \
     "aikit · Opus · sans-git · ctx 30 %" "$(sl "$(slin "$ROOT/sans-git" shg 30)" | plain)"
  is "sous-dossier d'un projet : le projet" \
     "aikit · Opus · sans-git · ctx 30 %" "$(sl "$(slin "$ROOT/sans-git/dedans" ssd 30)" | plain)"
  is "projet hors registre : le nom du dossier" \
     "aikit · Opus · hors-registre · ctx 30 %" "$(sl "$(slin "$TMP/hors-registre" shr 30)" | plain)"
  is "aucun vault declare : le nom du dossier" \
     "aikit · Opus · avec-remote (trunk) · ctx 30 %" \
     "$(sl "$(slin "$ROOT/avec-remote" snov 30)" /nonexistent-vaults-file | plain)"
  out="$(sl 'ceci n'"'"'est pas du json')"; rc=$?
  is "entree invalide : code de sortie 0" "0" "$rc"
  is "entree invalide : une seule ligne"  "1" "$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
  out="$(sl '')"; rc=$?
  is "entree vide : code de sortie 0" "0" "$rc"
  # Le cache par session : une entree posee a la main est relue telle quelle.
  mkdir -p "$SLCACHE/aikit"
  printf '%s\t%s\n' "$ROOT/avec-remote" "nom-en-cache" > "$SLCACHE/aikit/project-scache"
  is "le projet vient du cache de la session" \
     "aikit · Opus · nom-en-cache (trunk) · ctx 30 %" "$(sl "$(slin "$ROOT/avec-remote" scache 30)" | plain)"
  printf '%s\t%s\n' "$TMP/ailleurs" "nom-perime" > "$SLCACHE/aikit/project-sperime"
  is "un cache d'un autre dossier est ignore" \
     "aikit · Opus · avec-remote (trunk) · ctx 30 %" "$(sl "$(slin "$ROOT/avec-remote" sperime 30)" | plain)"
  [ -f "$SLCACHE/aikit/project-s30" ] && ok "le cache est ecrit sous XDG_CACHE_HOME/aikit" \
    || ko "le cache est ecrit sous XDG_CACHE_HOME/aikit" "project-s30 present" "absent"
else
  echo "  (jq absent : cas de rendu avec jq ignores)"
fi
# Sans jq : un PATH qui ne contient que git.
NOJQ="$TMP/path-sans-jq"; mkdir -p "$NOJQ"; ln -sf "$(command -v git)" "$NOJQ/git"
out="$(cd "$ROOT/avec-remote" && PATH="$NOJQ" HOME="$SLHOME" "$BASH" "$REPO/bin/aikit-statusline" <<< '{}')"; rc=$?
is "sans jq : ligne de repli" "aikit · avec-remote (trunk)" "$out"
is "sans jq : code de sortie 0" "0" "$rc"
out="$(cd "$TMP/hors-registre" && PATH="$NOJQ" HOME="$SLHOME" "$BASH" "$REPO/bin/aikit-statusline" <<< '{}')"
is "sans jq, hors git : pas de parentheses" "aikit · hors-registre" "$out"

echo "hooks/statusline-install"
if command -v jq > /dev/null 2>&1; then
  PLUG="$TMP/Plugin Root/aikit/1.2.3"      # une espace, deliberement
  WANT="AIKIT_STATUSLINE=1 bash \"$PLUG/bin/aikit-statusline\""
  # inst <home> : stdout du hook sur stdout, code de sortie en derniere ligne.
  inst() { HOME="$1" CLAUDE_PLUGIN_ROOT="$PLUG" bash "$REPO/hooks/statusline-install" 2> /dev/null; }
  newhome() { local h; h="$(mktemp -d "$TMP/home.XXXXXX")"; mkdir -p "$h/.claude"; printf '%s' "$h"; }
  getcmd() { jq -r '.statusLine.command' "$1/.claude/settings.json"; }

  H="$(newhome)"; rmdir "$H/.claude"
  out="$(inst "$H")"; rc=$?
  is "settings.json absent : cree avec statusLine" "$WANT" "$(getcmd "$H")"
  is "... type command" "command" "$(jq -r '.statusLine.type' "$H/.claude/settings.json")"
  is "... seule cle ecrite" "statusLine" "$(jq -r 'keys | join(",")' "$H/.claude/settings.json")"
  is "... rien sur stdout" "" "$out"
  is "... code de sortie 0" "0" "$rc"

  H="$(newhome)"; echo '{"theme":"dark","env":{"A":"1"}}' > "$H/.claude/settings.json"
  out="$(inst "$H")"
  is "autres cles : statusLine ajoutee" "$WANT" "$(getcmd "$H")"
  is "autres cles : conservees" '{"theme":"dark","env":{"A":"1"}}' \
     "$(jq -c 'del(.statusLine)' "$H/.claude/settings.json")"
  is "autres cles : rien sur stdout" "" "$out"

  H="$(newhome)"
  echo '{"statusLine":{"type":"command","command":"AIKIT_STATUSLINE=1 bash \"/ancien/1.0.0/bin/aikit-statusline\""},"theme":"dark"}' > "$H/.claude/settings.json"
  inst "$H" > /dev/null
  is "marqueur present : chemin reecrit" "$WANT" "$(getcmd "$H")"
  is "marqueur present : theme conserve" "dark" "$(jq -r '.theme' "$H/.claude/settings.json")"

  H="$(newhome)"
  echo '{"statusLine":{"type":"command","command":"~/mon-script.sh","padding":2}}' > "$H/.claude/settings.json"
  cp "$H/.claude/settings.json" "$TMP/avant-perso.json"
  inst "$H" > /dev/null
  is "statusLine personnalisee : octets identiques" "$(cat "$TMP/avant-perso.json")" "$(cat "$H/.claude/settings.json")"

  H="$(newhome)"; echo '{"statusLine":"une chaine"}' > "$H/.claude/settings.json"
  inst "$H" > /dev/null
  is "statusLine qui n'est pas un objet : intacte" '{"statusLine":"une chaine"}' "$(cat "$H/.claude/settings.json")"

  H="$(newhome)"; mkdir -p "$H/.config/aikit"; : > "$H/.config/aikit/no-statusline"
  out="$(inst "$H")"; rc=$?
  [ ! -e "$H/.claude/settings.json" ] && ok "opt-out : settings.json absent n'est pas cree" \
    || ko "opt-out : settings.json absent n'est pas cree" "absent" "present"
  is "opt-out : rien sur stdout, sortie 0" "|0" "$out|$rc"
  echo '{"theme":"dark"}' > "$H/.claude/settings.json"
  inst "$H" > /dev/null
  is "opt-out : settings.json existant intact" '{"theme":"dark"}' "$(cat "$H/.claude/settings.json")"

  H="$(newhome)"; printf '{"theme": "dark",\n' > "$H/.claude/settings.json"
  cp "$H/.claude/settings.json" "$TMP/avant-invalide.json"
  out="$(inst "$H")"; rc=$?
  is "JSON invalide : intact" "$(cat "$TMP/avant-invalide.json")" "$(cat "$H/.claude/settings.json")"
  is "JSON invalide : rien sur stdout, sortie 0" "|0" "$out|$rc"
  H="$(newhome)"; : > "$H/.claude/settings.json"
  inst "$H" > /dev/null
  is "fichier vide : intact" "0" "$(wc -c < "$H/.claude/settings.json" | tr -d ' ')"
  H="$(newhome)"; echo '[1,2]' > "$H/.claude/settings.json"
  inst "$H" > /dev/null
  is "JSON qui n'est pas un objet : intact" '[1,2]' "$(cat "$H/.claude/settings.json")"

  H="$(newhome)"; inst "$H" > /dev/null
  touch -d @0 "$H/.claude/settings.json"
  inst "$H" > /dev/null
  is "valeur deja identique : fichier non reecrit (mtime)" "0" "$(stat -c %Y "$H/.claude/settings.json")"

  H="$(newhome)"; mkdir -p "$TMP/reel"
  echo '{"theme":"dark"}' > "$TMP/reel/settings.json"; chmod 640 "$TMP/reel/settings.json"
  ln -s "$TMP/reel/settings.json" "$H/.claude/settings.json"
  inst "$H" > /dev/null
  [ -L "$H/.claude/settings.json" ] && ok "lien symbolique : le lien reste un lien" \
    || ko "lien symbolique : le lien reste un lien" "lien" "fichier"
  is "lien symbolique : la cible resolue est ecrite" "$WANT" "$(jq -r '.statusLine.command' "$TMP/reel/settings.json")"
  is "lien symbolique : permissions conservees" "640" "$(stat -c %a "$TMP/reel/settings.json")"
  is "lien symbolique : aucun temporaire laisse" "settings.json" "$(ls "$TMP/reel")"

  H="$(newhome)"; echo '{"theme":"dark"}' > "$H/.claude/settings.json"
  mkdir -p "$TMP/path-vide"
  out="$(HOME="$H" CLAUDE_PLUGIN_ROOT="$PLUG" PATH="$TMP/path-vide" "$BASH" "$REPO/hooks/statusline-install" 2> /dev/null)"; rc=$?
  is "sans jq : settings.json intact" '{"theme":"dark"}' "$(cat "$H/.claude/settings.json")"
  is "sans jq : rien sur stdout, sortie 0" "|0" "$out|$rc"

  H="$(newhome)"
  out="$(HOME="$H" CLAUDE_PLUGIN_ROOT="$PLUG" bash "$REPO/hooks/run-hook.cmd" statusline-install 2> /dev/null)"; rc=$?
  is "via run-hook.cmd : statusLine posee" "$WANT" "$(getcmd "$H")"
  is "via run-hook.cmd : rien sur stdout, sortie 0" "|0" "$out|$rc"

  # Test non vide : un faux jq ecrit sur stdout puis delegue au vrai ; le hook
  # doit quand meme ne rien emettre (garantie de `exec > /dev/null`).
  REALJQ="$(command -v jq)"
  FAKEBIN="$TMP/faux-jq"; mkdir -p "$FAKEBIN"
  printf '#!/usr/bin/env bash\necho FUITE-STDOUT\nexec "%s" "$@"\n' "$REALJQ" > "$FAKEBIN/jq"; chmod +x "$FAKEBIN/jq"
  fuite="$(PATH="$FAKEBIN:$PATH" bash -c 'jq -n 1' 2> /dev/null)"
  is "faux jq : ecrit bien sur stdout (temoin)" "FUITE-STDOUT" "$(printf '%s' "$fuite" | head -1)"
  H="$(newhome)"
  out="$(PATH="$FAKEBIN:$PATH" HOME="$H" CLAUDE_PLUGIN_ROOT="$PLUG" bash "$REPO/hooks/statusline-install" 2> /dev/null)"; rc=$?
  is "faux jq bavard : rien sur stdout, sortie 0" "|0" "$out|$rc"
else
  echo "  (jq absent : cas de l'installateur ignores)"
fi

echo
echo "$pass passes, $fail echecs"
# `exit`, jamais un simple `[ "$fail" = 0 ]` en derniere ligne : le statut
# d'un script sans `set -e` est celui de sa DERNIERE commande, donc toute
# ligne ajoutee dessous rendrait la suite verte quoi qu'elle imprime -- et la
# porte 9 de `scripts/doctor` deviendrait decorative sans que rien ne le dise.
exit $(( fail != 0 ))
