#!/usr/bin/env bash
# Launch a Claude session at the workspace root, wired from the registry.
#
# A launcher's one job is to surface the **agents and skills of the other
# projects**: those do NOT travel up or down the tree on their own.
# `--add-dir <project>` surfaces them (it carries neither that project's
# .mcp.json nor its CLAUDE.md). MCP servers, by contrast, need no flag —
# .mcp.json lookup already walks up the tree, so a server declared at the
# workspace root reaches any session opened below it.
#
# Paths come from the registry frontmatter (`path:`), so adding a project file
# is enough — nothing here to maintain in parallel. A project that exposes
# neither agents nor skills is skipped: --add-dir would carry nothing.
#
# The workspace is found by walking UP from the current directory looking for
# `aikit/projects/*.md`, exactly as the SessionStart hook does.
#
# Usage:
#   ezy                       agents + skills of every registered project
#   ezy --only <project>      one project
#   ezy --dry-run             print the command instead of running it
set -euo pipefail

find_workspace() {
  local probe="${CLAUDE_PROJECT_DIR:-$PWD}"
  while [ -n "$probe" ] && [ "$probe" != "/" ]; do
    if compgen -G "${probe}/aikit/projects/*.md" > /dev/null 2>&1; then
      printf '%s' "$probe"; return 0
    fi
    probe="$(dirname "$probe")"
  done
  return 1
}

workspace="$(find_workspace)" || {
  echo "ezy: no workspace registry found by walking up from ${PWD} (expected <workspace>/aikit/projects/*.md)" >&2
  exit 1
}
registry="${workspace}/aikit/projects"

only=""; dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --only)     only="${2:?--only needs a project name}"; shift 2 ;;
    --dry-run)  dry=1; shift ;;
    *)          break ;;
  esac
done

compgen -G "${registry}/*.md" > /dev/null 2>&1 \
  || { echo "ezy: empty registry at ${registry}" >&2; exit 1; }

field() {  # field <file> <key>
  awk -v key="$2" '
    /^---[[:space:]]*$/ { fm++; next }
    fm == 1 && $0 ~ "^" key ":" { sub("^" key ":[[:space:]]*", ""); print; exit }
    fm >= 2 { exit }
  ' "$1"
}

args=()
for f in "${registry}"/*.md; do
  name=$(basename "$f" .md)
  [ -z "$only" ] || [ "$name" = "$only" ] || continue
  path=$(field "$f" path)
  [ -n "$path" ] && [ -d "${workspace}/${path}" ] || continue

  # Skip what --add-dir could not carry anyway.
  agents_or_skills=0
  for sub in .claude/agents .claude/skills; do
    [ -d "${workspace}/${path}/${sub}" ] && agents_or_skills=1
  done
  [ "$agents_or_skills" = 1 ] || continue

  args+=(--add-dir "${workspace}/${path}")
done

[ ${#args[@]} -gt 0 ] || { echo "ezy: no project exposes agents or skills under ${workspace}" >&2; exit 1; }

cd "$workspace"
if [ "$dry" = 1 ]; then
  printf 'cd %s && claude' "$workspace"; printf ' %q' "${args[@]}" "$@"; echo
  exit 0
fi
exec claude "${args[@]}" "$@"
