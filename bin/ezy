#!/usr/bin/env bash
# Launch a Claude session at the workspace root, wired from the registry.
#
# The toolbelt is NOT wired here. It is installed in the workspace itself
# (`apm install Ezytail/ezyflow-tool-belt --target claude`), so its six MCP
# servers and its seven routing skills are already there — and the MCP servers
# even reach a session opened in a sub-repository, because .mcp.json lookup
# walks up the tree. Measured, 2026-08-21. Nothing to pass.
#
# What a launcher still has to carry is the other projects' **agents and
# skills**: those do NOT travel up or down. `--add-dir <project>` surfaces
# them (it carries neither that project's .mcp.json nor its CLAUDE.md — both
# measured). Cost is the descriptions only, ~1.4k tokens for the workspace.
#
# Paths come from the registry frontmatter (`path:`), so adding a project file
# is enough — nothing here to maintain in parallel. A project that exposes
# neither agents nor skills is skipped: --add-dir would carry nothing.
#
# Usage:
#   ezy                     agents + skills of every registered project
#   ezy --only ezylive      one project
#   ezy --dry-run           print the command instead of running it
set -euo pipefail

workspace="$(cd "$(dirname "$0")/../.." && pwd)"
registry="${workspace}/aikit/projects"

only=""; dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --only)     only="${2:?--only needs a project name}"; shift 2 ;;
    --dry-run)  dry=1; shift ;;
    *)          break ;;
  esac
done

compgen -G "${registry}/*.md" > /dev/null 2>&1 \
  || { echo "ezy: empty registry at ${registry}" >&2; exit 1; }

field() {  # field <file> <key>
  awk -v key="$2" '
    /^---[[:space:]]*$/ { fm++; next }
    fm == 1 && $0 ~ "^" key ":" { sub("^" key ":[[:space:]]*", ""); print; exit }
    fm >= 2 { exit }
  ' "$1"
}

args=()
for f in "${registry}"/*.md; do
  name=$(basename "$f" .md)
  [ -z "$only" ] || [ "$name" = "$only" ] || continue
  path=$(field "$f" path)
  [ -n "$path" ] && [ -d "${workspace}/${path}" ] || continue

  # Skip what --add-dir could not carry anyway.
  agents_or_skills=0
  for sub in .claude/agents .claude/skills; do
    [ -d "${workspace}/${path}/${sub}" ] && agents_or_skills=1
  done
  [ "$agents_or_skills" = 1 ] || continue

  args+=(--add-dir "${workspace}/${path}")
done

[ ${#args[@]} -gt 0 ] || { echo "ezy: no project exposes agents or skills under ${workspace}" >&2; exit 1; }

cd "$workspace"
if [ "$dry" = 1 ]; then
  printf 'cd %s && claude' "$workspace"; printf ' %q' "${args[@]}" "$@"; echo
  exit 0
fi
exec claude "${args[@]}" "$@"
