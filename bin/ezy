#!/usr/bin/env bash
# Launch a Claude session in the current directory, wired from the declared
# vaults.
#
# A launcher's one job is to surface the **agents and skills of the other
# projects**: those do NOT travel up or down the tree on their own.
# `--add-dir <project>` surfaces them (it carries neither that project's
# .mcp.json nor its CLAUDE.md). MCP servers, by contrast, need no flag —
# .mcp.json lookup already walks up the tree, so a server declared in an
# ancestor of the session's directory reaches it.
#
# Projects come from `lib/vaults`: registering a fiche is enough — nothing here
# to maintain in parallel. Two kinds of project are skipped, for two different
# reasons: one the scan did not locate on this machine (`absent` — --add-dir
# would name a directory that is not there), and one that exposes neither
# agents nor skills (--add-dir would carry nothing).
#
# There is no root to stand in any more: the session opens where you are.
#
# Usage:
#   ezy                       agents + skills of every located project
#   ezy --only <project>      one project
#   ezy --vault <name>        one declared vault
#   ezy --dry-run             print the command instead of running it
set -euo pipefail

LIB="$(cd "$(dirname "$0")/.." && pwd)/lib/vaults"
. "$LIB"

only=""; vault_only=""; dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --only)     only="${2:?--only needs a project name}"; shift 2 ;;
    --vault)    vault_only="${2:?--vault needs a vault name}"; shift 2 ;;
    --dry-run)  dry=1; shift ;;
    *)          break ;;
  esac
done

declared=0; matched=0
args=()
while IFS=$'\t' read -r vname _; do
  declared=$((declared + 1))
  [ -z "$vault_only" ] || [ "$vname" = "$vault_only" ] || continue
  matched=$((matched + 1))
  while IFS=$'\t' read -r name _ state path _; do
    [ "$state" = "present" ] || continue
    [ -z "$only" ] || [ "$name" = "$only" ] || continue
    for sub in .claude/agents .claude/skills; do
      [ -d "${path}/${sub}" ] && { args+=(--add-dir "$path"); break; }
    done
  done < <(resolve_projects "$vname")
done < <(vaults_list)

# Three ways to end up with nothing, three remedies: declare a vault, name one
# that exists, or clone a project that carries agents or skills. One message
# for the three would send every reader to the wrong file.
if [ ${#args[@]} -eq 0 ]; then
  if [ "$declared" = 0 ]; then
    echo "ezy: no vault declared in $(vaults_config_path)" >&2
  elif [ "$matched" = 0 ]; then
    echo "ezy: no vault named '${vault_only}' among the ${declared} declared in $(vaults_config_path)" >&2
  else
    echo "ezy: no located project exposes agents or skills" >&2
  fi
  exit 1
fi

if [ "$dry" = 1 ]; then
  # The command on stdout stays pasteable; where it would run goes to stderr,
  # since that is now the current directory and nothing in the line says so.
  echo "ezy: runs from ${PWD}" >&2
  printf 'claude'; printf ' %q' "${args[@]}" "$@"; echo
  exit 0
fi
exec claude "${args[@]}" "$@"
