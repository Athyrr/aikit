#!/usr/bin/env bash
# Bump the version, validate, commit, resync the install copy.
#
# NOTE (2026-09-06): this script does NOT decide what runs. aikit-local is a
# `directory` marketplace, so the harness loads the plugin from this working
# tree; the copy under ~/.claude/plugins/cache/ sat frozen at 0.8.6 while the
# tree was live. The bump and commit are bookkeeping and the two `claude
# plugin` calls are a leftover from the copy-install model. What ships an edit
# is the next session start.
#
# It also under-gates: `claude plugin validate .` reads no SKILL.md and no
# agents/*.md. The two --strict gates are in projects/aikit.md, section 5.
#
# Usage: bin/deploy [patch|minor|major]   (default: patch)
set -euo pipefail

cd "$(dirname "$0")/.."
part=${1:-patch}

current=$(python3 -c "import json;print(json.load(open('.claude-plugin/plugin.json'))['version'])")
IFS=. read -r maj min pat <<< "$current"
case "$part" in
  major) maj=$((maj+1)); min=0; pat=0 ;;
  minor) min=$((min+1)); pat=0 ;;
  patch) pat=$((pat+1)) ;;
  *) echo "usage: bin/deploy [patch|minor|major]" >&2; exit 2 ;;
esac
next="${maj}.${min}.${pat}"

python3 - "$next" <<'PY'
import json, sys
v = sys.argv[1]
for path, mutate in (
    ('.claude-plugin/plugin.json',      lambda d: d.update(version=v)),
    ('.claude-plugin/marketplace.json', lambda d: d['plugins'][0].update(version=v)),
):
    d = json.load(open(path))
    mutate(d)
    json.dump(d, open(path, 'w'), indent=2)
    open(path, 'a').write('\n')
PY

echo "→ ${current} → ${next}"

CLAUDE_PLUGIN_ROOT=$PWD bash hooks/session-start | python3 -m json.tool > /dev/null
echo "→ hook: JSON valide"
claude plugin validate . > /dev/null && echo "→ manifestes: valides"

git add -A
git commit -q -m "${next}${2:+ - $2}" || echo "→ rien a committer"

claude plugin marketplace update aikit-local  > /dev/null
claude plugin update aikit@aikit-local --scope user > /dev/null
echo "→ deploye. Prend effet dans une NOUVELLE session."
