#!/usr/bin/env bash
# Deploy the working tree into the installed plugin.
#
# Installing a plugin COPIES it into ~/.claude/plugins/cache/<marketplace>/
# <plugin>/<version>/, and `claude plugin update` compares VERSIONS, not
# content: without a bump it reports "already at the latest version" and the
# stale copy keeps running. So a deploy is: bump, commit, resync, update.
#
# The registry (projects/*.md) is exempt — the hook reads it from the source
# tree, so a registry edit is live in the next session with no deploy.
#
# Usage: bin/deploy [patch|minor|major]   (default: patch)
set -euo pipefail

cd "$(dirname "$0")/.."
part=${1:-patch}

current=$(python3 -c "import json;print(json.load(open('.claude-plugin/plugin.json'))['version'])")
IFS=. read -r maj min pat <<< "$current"
case "$part" in
  major) maj=$((maj+1)); min=0; pat=0 ;;
  minor) min=$((min+1)); pat=0 ;;
  patch) pat=$((pat+1)) ;;
  *) echo "usage: bin/deploy [patch|minor|major]" >&2; exit 2 ;;
esac
next="${maj}.${min}.${pat}"

python3 - "$next" <<'PY'
import json, sys
v = sys.argv[1]
for path, mutate in (
    ('.claude-plugin/plugin.json',      lambda d: d.update(version=v)),
    ('.claude-plugin/marketplace.json', lambda d: d['plugins'][0].update(version=v)),
):
    d = json.load(open(path))
    mutate(d)
    json.dump(d, open(path, 'w'), indent=2)
    open(path, 'a').write('\n')
PY

echo "→ ${current} → ${next}"

CLAUDE_PLUGIN_ROOT=$PWD bash hooks/session-start | python3 -m json.tool > /dev/null
echo "→ hook: JSON valide"
claude plugin validate . > /dev/null && echo "→ manifestes: valides"

git add -A
git commit -q -m "${next}${2:+ - $2}" || echo "→ rien a committer"

claude plugin marketplace update aikit-local  > /dev/null
claude plugin update aikit@aikit-local --scope project > /dev/null
echo "→ deploye. Prend effet dans une NOUVELLE session."
