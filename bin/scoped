#!/usr/bin/env bash
# Run an instruction inside a project's own perimeter, in a separate Claude
# process, and print what it reports back.
#
# Why a process and not a subagent: an Agent-tool subagent runs inside the
# caller's session and inherits the MCP servers that session connected at
# startup. It cannot connect its own, and it cannot re-scope to a directory.
# A process launched with cwd = <perimeter> loads that directory's .mcp.json,
# its skills and its agents natively — and the subagents IT dispatches inherit
# them in turn. What that buys is not the tools, which .mcp.json lookup already
# carries up the tree; it is that the forty tool calls of an investigation land
# in a context you throw away.
#
# The session persists: the first call creates it, later calls resume it, so a
# plan's task 1 can open the perimeter and tasks 2..n can work inside it
# without paying the discovery again.
#
# Permissions come from the project's registry frontmatter (`allow:`, `deny:`),
# not from a blanket bypass. The process can call what the registry blesses and
# nothing else — a tool that is neither allowed nor denied simply blocks, since
# nobody is there to approve it.
#
# The project is located by `lib/vaults`: the declared vaults are searched, and
# their fiches matched to the clones actually on this machine. No ancestor walk,
# so no risk of opening a perimeter on whichever parallel clone happened to sit
# above the current directory.
#
# Usage:
#   scoped <project> <feature> <instruction...>
#   scoped <project> <feature> @path/to/prompt.md
#   scoped --dry-run <project> <feature> <instruction...>
set -euo pipefail

LIB="$(cd "$(dirname "$0")/.." && pwd)/lib/vaults"
. "$LIB"

# --dry-run prints the command and the directory it would run in, instead of
# running it. It is what makes this file testable: without it, a test has to
# clone the script and patch out the `exec` — and a clone drifts.
dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    *)         break ;;
  esac
done

[ $# -ge 3 ] || { echo "usage: scoped [--dry-run] <project> <feature> <instruction...>" >&2; exit 2; }
project=$1; feature=$2; shift 2

found=""; fiche=""; vault_dir=""; registered=""
declared=0; resolved=0; stranded=""
while IFS=$'\t' read -r vname vpath; do
  declared=$((declared + 1))
  vrows=0
  while IFS=$'\t' read -r name _ state path _; do
    vrows=$((vrows + 1))
    [ "$name" = "$project" ] || continue
    if [ "$state" != "present" ]; then
      # Registered, but not cloned here. Remember which vault said so, and keep
      # searching: the same project may be declared in a second vault that does
      # hold the clone. Refusing on the first `absent` would refuse work that
      # exists — and would disagree with bin/ezy, which finds it.
      registered="${registered:-$vname}"
      continue
    fi
    found="$path"; fiche="${vpath}/projects/${project}.md"; vault_dir="${vpath}/${project}/${feature}"
    break
  done < <(resolve_projects "$vname")
  # A vault whose `projects/` does not resolve — wrong path, drive not mounted —
  # yields nothing, and lib/vaults says nothing about it.
  if [ "$vrows" = 0 ]; then
    stranded="${stranded}${stranded:+, }${vname} (${vpath}/projects)"
  else
    resolved=$((resolved + 1))
  fi
  [ -n "$found" ] && break
done < <(vaults_list)

# Four causes, four remedies: write the config file, fix a vault path, clone the
# project, or register it. "No such fiche" for a missing config file sends the
# reader hunting for a file that is very likely right in front of them.
if [ -z "$found" ]; then
  if [ "$declared" = 0 ]; then
    echo "scoped: no vault declared in $(vaults_config_path)" >&2
  elif [ "$resolved" = 0 ]; then
    echo "scoped: no declared vault carries a project registry" >&2
  elif [ -n "$registered" ]; then
    # Deliberately different from bin/ezy, which skips an absent project and
    # carries on: here the request names THIS project, so there is nothing else
    # to do. But the refusal leaves only once every vault has been searched.
    echo "scoped: '${project}' is registered in vault '${registered}', but not cloned on this machine" >&2
  else
    echo "scoped: no project named '${project}' in any declared vault" >&2
  fi
  [ -z "$stranded" ] || echo "scoped:   (declared but carrying no project registry: ${stranded})" >&2
  exit 2
fi

# resolve_projects returns the frontmatter `name:`, which may differ from the
# file name; the fiche is then not where we just looked. Without this guard,
# fiche_field would open a missing file and awk would kill the script under
# `set -e`, with its message instead of ours.
[ -f "$fiche" ] || { echo "scoped: no such registry file: ${fiche}" >&2; exit 2; }

# `perimeter:` is relative TO THE LOCATED PROJECT, and defaults to `.`. A
# project whose tools live in the parent of its clone writes `perimeter: ..` —
# true on every machine, since the anchor is the clone, not a root.
perimeter="$(fiche_field "$fiche" perimeter)"
dir="$(cd "${found}/${perimeter:-.}" 2>/dev/null && pwd)" \
  || { echo "scoped: no such perimeter: ${found}/${perimeter:-.}" >&2; exit 2; }

instruction="$*"
if [ "${instruction:0:1}" = "@" ]; then
  f="${instruction:1}"
  [ -f "$f" ] || { echo "scoped: no such prompt file: ${f}" >&2; exit 2; }
  instruction=$(cat "$f")
fi

marker="${vault_dir}/.session"
[ "$dry" = 1 ] || mkdir -p "$vault_dir"

args=()
read -r -a allow <<< "$(fiche_field "$fiche" allow)"
read -r -a deny  <<< "$(fiche_field "$fiche" deny)"
[ ${#allow[@]} -gt 0 ] && args+=(--allowed-tools "${allow[@]}")
[ ${#deny[@]}  -gt 0 ] && args+=(--disallowed-tools "${deny[@]}")

if [ -s "$marker" ]; then
  sid=$(cat "$marker")
  args+=(--resume "$sid")
  echo "scoped: resuming ${project} session ${sid}" >&2
else
  if command -v uuidgen > /dev/null 2>&1; then          sid=$(uuidgen)
  elif [ -r /proc/sys/kernel/random/uuid ]; then        sid=$(cat /proc/sys/kernel/random/uuid)
  elif command -v node > /dev/null 2>&1; then           sid=$(node -e 'console.log(crypto.randomUUID())')
  else                                                  sid=$(python3 -c "import uuid; print(uuid.uuid4())")
  fi
  # A dry run leaves no trace: writing the marker here would make the next real
  # call --resume a session that was never created.
  [ "$dry" = 1 ] || printf '%s' "$sid" > "$marker"
  args+=(--session-id "$sid")
  echo "scoped: opening ${project} perimeter, session ${sid}" >&2
fi

if [ "$dry" = 1 ]; then
  # The cd is part of the printed command: unlike bin/ezy, this launcher really
  # does move, and the perimeter is the whole point of reading the line.
  printf 'cd %q && claude' "$dir"; printf ' %q' "${args[@]}"; printf ' -p %q\n' "$instruction"
  exit 0
fi
cd "$dir"
exec claude "${args[@]}" -p "$instruction"
